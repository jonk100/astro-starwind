---
interface Props {
  documentId: string | null;
}

const { documentId } = Astro.props;
---

<div class="toolbar-left">
  <span class="app-name">Write</span>

  {documentId && (
    <div class="word-count">
      <slot name="wordcount" />
    </div>
  )}
</div>

<style>
  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .app-name {
    font-weight: 600;
    font-size: 14px;
  }

  .word-count {
    opacity: 0.7;
    font-size: 12px;
  }
</style>
