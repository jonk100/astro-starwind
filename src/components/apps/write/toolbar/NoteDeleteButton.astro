---
import Button from '@/components/starwind/button/Button.astro';

import AlertDialog from '@/components/starwind/alert-dialog/AlertDialog.astro';
import AlertDialogTrigger from '@/components/starwind/alert-dialog/AlertDialogTrigger.astro';
import AlertDialogContent from '@/components/starwind/alert-dialog/AlertDialogContent.astro';
import AlertDialogHeader from '@/components/starwind/alert-dialog/AlertDialogHeader.astro';
import AlertDialogTitle from '@/components/starwind/alert-dialog/AlertDialogTitle.astro';
import AlertDialogDescription from '@/components/starwind/alert-dialog/AlertDialogDescription.astro';
import AlertDialogFooter from '@/components/starwind/alert-dialog/AlertDialogFooter.astro';
import AlertDialogCancel from '@/components/starwind/alert-dialog/AlertDialogCancel.astro';
import AlertDialogAction from '@/components/starwind/alert-dialog/AlertDialogAction.astro';

interface Props {
  activeDocumentId: string | null;
  user: any;
}

const { activeDocumentId } = Astro.props;
---

{activeDocumentId && (
  <AlertDialog>
    <AlertDialogTrigger asChild>
      <Button
        id="toolbar--delete-trigger"
        class="toolbar--button toolbar--button--danger"
        type="button"
        aria-label="Delete document"
        title="Delete document"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6" />
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
          <path d="M10 11v6M14 11v6" />
          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
        </svg>
      </Button>
    </AlertDialogTrigger>

    <AlertDialogContent>
      <AlertDialogHeader>
        <AlertDialogTitle>Delete this document?</AlertDialogTitle>
        <AlertDialogDescription>
          This action cannot be undone. The document will be permanently deleted.
        </AlertDialogDescription>
      </AlertDialogHeader>

      <AlertDialogFooter>
        <AlertDialogCancel>Cancel</AlertDialogCancel>

        <AlertDialogAction
          id="toolbar--delete-confirm"
          data-document-id={activeDocumentId}
          class="bg-red-600 text-white hover:bg-red-700"
        >
          Delete
        </AlertDialogAction>
      </AlertDialogFooter>
    </AlertDialogContent>
  </AlertDialog>
)}

<style>
  .toolbar--button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .toolbar--button:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  .toolbar--button--danger:hover {
    background-color: color-mix(in srgb, var(--color-danger, #ef4444) 10%, transparent);
    color: var(--color-danger, #ef4444);
  }
</style>

<script>
  import { actions } from "astro:actions";

  function initDeleteConfirm() {
    const btn = document.getElementById("toolbar--delete-confirm");
    if (!btn) return;

    const documentId = btn.getAttribute("data-document-id");
    if (!documentId) return;

    btn.addEventListener("click", async () => {
      btn.setAttribute("disabled", "true");

      const { error } = await actions.write.deleteDocument({ id: documentId });

      if (error) {
        btn.removeAttribute("disabled");
        console.error("Failed to delete document:", error.message);
        return;
      }

      window.location.href = "/app/write";
    });
  }

  document.addEventListener("DOMContentLoaded", initDeleteConfirm);
</script>
