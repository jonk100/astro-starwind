---
import ActionPopover from "@/components/apps/write/ActionPopover.astro";
import PinToggleButton from "./PinToggleButton.astro";

interface Props {
  documentId: string | null;
  title?: string | null;
  isArchived?: boolean;
  isPinned?: boolean;
  user?: any;
}

const { documentId, title = "", isArchived = false, isPinned = false, user } = Astro.props;
---

<div class="toolbar-right">
  {documentId && (
    <>
      <PinToggleButton activeDocumentId={documentId} isPinned={isPinned} user={user} />
      <ActionPopover
        type="document"
        id={documentId}
        name={title ?? ""}
        actions={[
          "rename",
          "delete",
          isArchived ? "unarchive" : "archive",
          "duplicate",
          "move"
        ]}
      />
    </>
  )}
</div>

<style>
  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
</style>
