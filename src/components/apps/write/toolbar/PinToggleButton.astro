---
/**
 * @file src/components/apps/write/toolbar/PinToggleButton.astro
 *
 * FIX f: Uses stores/pin.ts as the single source of truth for pinned state.
 * The store is initialised from the server-rendered data-pinned attribute,
 * so the first paint is always correct. Every subsequent toggle goes through
 * the store — no aria-pressed drift, no rollback bugs.
 */
import Button from '@/components/starwind/button/Button.astro';

interface Props {
  activeDocumentId: string | null;
  isPinned: boolean;
  user: any;
}

const { activeDocumentId, isPinned = false } = Astro.props;
---

<button
  id="toolbar--pin-button"
  class="toolbar--button"
  type="button"
  aria-label={isPinned ? "Unpin document" : "Pin document"}
  aria-pressed={isPinned ? "true" : "false"}
  data-document-id={activeDocumentId}
  data-pinned={isPinned ? "true" : "false"}
  title={isPinned ? "Unpin document" : "Pin document"}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="12" y1="17" x2="12" y2="22" />
    <path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24Z" />
  </svg>
</button>

<style>
  .toolbar--button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, transform 0.2s ease;
  }

  .toolbar--button:hover {
    background-color: var(--color-surface-hover);
    color: var(--color-text);
  }

  .toolbar--button[aria-pressed="true"] {
    color: var(--color-accent);
    transform: rotate(20deg) translateY(2px);
  }

  .toolbar--button[aria-pressed="true"]:hover {
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .toolbar--button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
  import { initPinStore, togglePin, pinStore } from "@/stores/journal/pin";

  /**
   * Syncs all UI attributes with store state.
   */
  function applyState(btn: HTMLButtonElement, pinned: boolean): void {
    btn.setAttribute("aria-pressed", pinned ? "true" : "false");
    btn.dataset.pinned = pinned ? "true" : "false";
    btn.setAttribute("aria-label", pinned ? "Unpin document" : "Pin document");
    btn.setAttribute("title", pinned ? "Unpin document" : "Pin document");
  }

  function initPinButton(): void {
    const btn = document.getElementById("toolbar--pin-button") as HTMLButtonElement | null;
    if (!btn) return;

    const documentId = btn.dataset.documentId;
    if (!documentId) return;

    const initialPinned = btn.dataset.pinned === "true";

    initPinStore(documentId, initialPinned);

    const unsubscribe = pinStore.subscribe((store) => {
      const state = store[documentId];
      if (!state) return;

      applyState(btn, state.pinned);
      btn.disabled = state.requesting;
    });

    btn.addEventListener("click", async () => {
      await togglePin(documentId);
    });

    window.addEventListener("beforeunload", unsubscribe);
  }

  document.addEventListener("DOMContentLoaded", initPinButton);
</script>