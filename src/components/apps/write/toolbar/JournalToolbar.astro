---
/**
 * @file src/components/apps/journal/toolbar/JournalToolbar.astro
 * @description Minimal top toolbar for the Write app.
 *
 * Displays contextual actions for the currently open document:
 * - Document title (read-only display — editing happens in the canvas)
 * - Save status indicator (Saved / Saving… / Unsaved changes)
 * - Pin toggle
 * - Delete document
 *
 * When no document is open, only the app title is shown.
 *
 * This component is intentionally thin. Heavy document actions (block
 * transforms, slash commands) belong in the editor canvas, not here.
 */
import ToolbarLeft from "./ToolbarLeft.astro";
import ToolbarMiddle from "./ToolbarMiddle.astro";
import ToolbarRight from "./ToolbarRight.astro";
// import BlockToolbar from "./blocks/BlockToolbar.astro";
import TipTopToolbar from "@/components/apps/tiptop/TipTopToolbar.astro";

interface Props {
  /** The ID of the currently open document, or null if none is open. */
  activeDocumentId: string | null;
  activeDocumentTitle?: string | null;
  isArchived?: boolean;
  /** The authenticated user object from Astro.locals. */
  user: any;
  isPinned: boolean;
}

const { activeDocumentId, activeDocumentTitle = "", isArchived = false, user, isPinned } = Astro.props;
---

<header class="toolbar" role="banner">
  <ToolbarLeft documentId={activeDocumentId} />
  <ToolbarMiddle activeDocumentId={activeDocumentId} user={user} />
  <!-- <BlockToolbar activeDocumentId={activeDocumentId} /> -->
  <ToolbarRight documentId={activeDocumentId} title={activeDocumentTitle} isArchived={isArchived} isPinned={isPinned} user={user} />
</header>

<style>
  .toolbar {
    position: relative;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 1.5rem;
    border-bottom: 1px solid var(--journal-sidebar-border, rgba(15, 18, 25, 0.07));
    background: var(--journal-sidebar-bg, rgba(255, 255, 255, 0.45));
    backdrop-filter: blur(var(--journal-sidebar-blur, 16px));
    -webkit-backdrop-filter: blur(var(--journal-sidebar-blur, 16px));
    flex-shrink: 0;
    gap: 1rem;
    transition: all 0.3s ease;
  }
</style>


