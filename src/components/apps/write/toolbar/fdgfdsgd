</style>

<script>
  import { actions } from "astro:actions";

  // ── Folder toggle ──────────────────────────────────────────────────────────

  /**
   * Wires up each folder header button to toggle the visibility of its
   * document list and update aria-expanded accordingly.
   */
  function initFolderToggles(): void {
    document.querySelectorAll<HTMLButtonElement>("[data-folder-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const expanded = btn.getAttribute("aria-expanded") === "true";
        const targetId = btn.getAttribute("aria-controls");
        const target   = targetId ? document.getElementById(targetId) : null;
        btn.setAttribute("aria-expanded", String(!expanded));
        if (target) target.style.display = expanded ? "none" : "";
      });
    });
  }

  // ── Move-to-folder picker ──────────────────────────────────────────────────

  /**
   * A shared folder-picker popup rendered once and repositioned on each open.
   *
   * Flow:
   * 1. User hovers a doc-item — the move button appears.
   * 2. User clicks the move button — the picker opens near the button,
   *    populated with all available folders plus a "Remove from folder" option.
   * 3. User picks a folder — moveDocument action is called, page reloads.
   */
  function initMovePicker(): void {
    const body        = document.getElementById("sidebar-document-list");
    const picker      = document.getElementById("folder-picker")      as HTMLElement | null;
    const pickerList  = document.getElementById("folder-picker-list") as HTMLUListElement | null;

    if (!body || !picker || !pickerList) return;

    // Parse folder data embedded by the server
    interface FolderMeta { id: string; name: string; icon: string; }
    let folders: FolderMeta[] = [];
    try {
      folders = JSON.parse(body.dataset.folders ?? "[]") as FolderMeta[];
    } catch {
      folders = [];
    }

    /** Currently active doc-id being moved — used when an option is clicked. */
    let activeDocId: string | null = null;

    /** Closes the picker and clears state. */
    function closePicker(): void {
      picker.hidden = true;
      activeDocId   = null;
    }

    /**
     * Opens the picker near the clicked move button and populates it with
     * the available folders for the given document.
     *
     * @param triggerBtn   - The move button that was clicked.
     * @param documentId   - The document to move.
     * @param currentFolder - The folder the document currently belongs to, or "".
     */
    function openPicker(
      triggerBtn: HTMLElement,
      documentId: string,
      currentFolder: string
    ): void {
      activeDocId = documentId;

      // Build option list
      pickerList.innerHTML = "";

      folders.forEach((f) => {
        const li = document.createElement("li");
        li.className  = `folder-picker-option${f.id === currentFolder ? " is-current" : ""}`;
        li.dataset.folderId = f.id;
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", String(f.id === currentFolder));
        li.innerHTML = `<span>${f.icon}</span><span>${f.name}</span>`;
        pickerList.appendChild(li);
      });

      // "Remove from folder" option — only useful when doc is in a folder
      if (currentFolder) {
        const li = document.createElement("li");
        li.className = "folder-picker-option folder-picker-option--remove";
        li.dataset.folderId = "__none__";
        li.setAttribute("role", "option");
        li.innerHTML = `<span>Remove from folder</span>`;
        pickerList.appendChild(li);
      }

      // Position near the trigger button
      const rect = triggerBtn.getBoundingClientRect();
      picker.style.top  = `${rect.bottom + 4}px`;
      picker.style.left = `${rect.left}px`;
      picker.hidden     = false;
    }

    // Open on move-button click
    body.addEventListener("click", (e: MouseEvent) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-move-trigger]");
      if (!trigger) return;

      e.preventDefault();
      e.stopPropagation();

      const docItem      = trigger.closest<HTMLElement>("[data-doc-id]");
      const documentId   = trigger.getAttribute("data-doc-id") ?? docItem?.dataset.docId ?? "";
      const currentFolder = docItem?.dataset.folderId ?? "";

      if (!documentId) return;

      // Toggle: if already open for this doc, close it
      if (!picker.hidden && activeDocId === documentId) {
        closePicker();
        return;
      }

      openPicker(trigger, documentId, currentFolder);
    });

    // Select a folder
    pickerList.addEventListener("click", async (e: MouseEvent) => {
      const option = (e.target as HTMLElement).closest<HTMLElement>("[data-folder-id]");
      if (!option || !activeDocId) return;

      const folderId = option.dataset.folderId ?? "";
      const docId    = activeDocId;

      closePicker();

      const { error } = await actions.write.moveDocument({
        document_id: docId,
        folder_id:   folderId === "__none__" ? null : folderId,
      });

      if (error) {
        console.error("Failed to move document:", error.message);
        return;
      }

      // Reload to show updated tree
      window.location.reload();
    });

    // Close when clicking anywhere else
    document.addEventListener("click", (e: MouseEvent) => {
      if (!picker.hidden && !picker.contains(e.target as Node)) {
        closePicker();
      }
    });

    // Close on Escape
    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape") closePicker();
    });
  }

  // ── Real-time sidebar updates ──────────────────────────────────────────────

  /**
   * Listens for events broadcast by the editor and sidebar components to
   * keep the sidebar in sync without a full page reload.
   */
  function initRealtimeUpdates(): void {
    // Sync title text as the user types
    window.addEventListener("journal:title-updated", ((e: CustomEvent) => {
      const { documentId, title } = e.detail as { documentId: string; title: string };
      document.querySelectorAll<HTMLElement>(`[data-doc-id="${documentId}"] .doc-title`).forEach((el) => {
        el.textContent = title;
      });
    }) as EventListener);

    // Sync "Today" meta label after autosave
    window.addEventListener("journal:doc-updated", ((e: CustomEvent) => {
      const { documentId } = e.detail as { documentId: string };
      document.querySelectorAll<HTMLElement>(`[data-doc-id="${documentId}"] .doc-meta`).forEach((el) => {
        el.textContent = "Today";
      });
    }) as EventListener);

    // Move pinned documents to top of their list
    window.addEventListener("journal:doc-pinned", ((e: CustomEvent) => {
      const { documentId, pinned } = e.detail as { documentId: string; pinned: boolean };
      const items = document.querySelectorAll<HTMLElement>(`[data-doc-id="${documentId}"]`);
      items.forEach((item) => {
        const list = item.parentElement;
        if (!list) return;
        if (pinned) {
          item.classList.add("is-pinned");
          list.prepend(item);
        } else {
          item.classList.remove("is-pinned");
        }
      });
    }) as EventListener);
  }

  // ── Init ───────────────────────────────────────────────────────────────────
  document.addEventListener("DOMContentLoaded", () => {
    initFolderToggles();
    initMovePicker();
    initRealtimeUpdates();
  });
</script>
