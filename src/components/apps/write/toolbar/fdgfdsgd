<script>
  /**
   * Initialises the block type selector dropdown.
   *
   * All DOM references are asserted non-null after the early-return guard.
   * TypeScript is satisfied because we return early if any element is missing.
   */
  function initBlockTypeSelector(): void {
    const selector = document.getElementById("block-type-selector");
    const trigger  = document.getElementById("block-type-trigger") as HTMLButtonElement | null;
    const menu     = document.getElementById("block-type-menu")    as HTMLUListElement  | null;
    const label    = document.getElementById("block-type-label")   as HTMLElement       | null;
 
    // Guard: all four elements must exist before we wire anything up.
    if (!selector || !trigger || !menu || !label) return;
 
    // From this point TS knows the variables are non-null because we returned above.
    const _selector = selector;
    const _trigger  = trigger;
    const _menu     = menu;
    const _label    = label;
 
    // ── Readable labels keyed by block-type value ──────────────────────────
    const LABELS: Record<string, string> = {
      paragraph: "Paragraph",
      heading:   "Heading",
      quote:     "Quote",
      checklist: "Checklist",
      code:      "Code",
      callout:   "Callout",
      separator: "Divider",
    };
 
    // ── Open / close ───────────────────────────────────────────────────────
 
    /** Opens the dropdown. */
    function openMenu(): void {
      _menu.hidden = false;
      _trigger.setAttribute("aria-expanded", "true");
    }
 
    /** Closes the dropdown. */
    function closeMenu(): void {
      _menu.hidden = true;
      _trigger.setAttribute("aria-expanded", "false");
    }
 
    // Toggle on trigger click
    _trigger.addEventListener("click", () => {
      _menu.hidden ? openMenu() : closeMenu();
    });
 
    // Close when clicking outside
    document.addEventListener("click", (e: MouseEvent) => {
      if (!_selector.contains(e.target as Node)) closeMenu();
    });
 
    // Close on Escape
    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape") closeMenu();
    });
 
    // ── Option selection ───────────────────────────────────────────────────
 
    _menu.addEventListener("click", (e: MouseEvent) => {
      const option = (e.target as HTMLElement).closest<HTMLElement>("[data-block-type]");
      if (!option) return;
 
      const blockType = option.getAttribute("data-block-type");
      if (!blockType) return;
 
      // Update label
      _label.textContent = LABELS[blockType] ?? blockType;
 
      // Mark selected
      _menu.querySelectorAll<HTMLElement>("[aria-selected]").forEach((el) => {
        el.setAttribute("aria-selected", "false");
      });
      option.setAttribute("aria-selected", "true");
 
      // Dispatch to the editor canvas
      window.dispatchEvent(
        new CustomEvent("editor:set-block-type", { detail: { blockType } })
      );
 
      closeMenu();
    });
 
    // ── Sync label when editor focus changes ───────────────────────────────
 
    /**
     * Updates the selector label to reflect the focused block's type.
     *
     * @param blockType - The data-block-type of the newly focused block.
     */
    function syncLabel(blockType: string): void {
      _label.textContent = LABELS[blockType] ?? "Paragraph";
      _menu.querySelectorAll<HTMLElement>("[data-block-type]").forEach((el) => {
        el.setAttribute(
          "aria-selected",
          String(el.getAttribute("data-block-type") === blockType)
        );
      });
    }
 
    window.addEventListener("editor:block-focused", ((e: CustomEvent) => {
      syncLabel((e.detail as { blockType?: string }).blockType ?? "paragraph");
    }) as EventListener);
 
    window.addEventListener("editor:title-focused", () => {
      _label.textContent = "\u2014"; // em dash: "—"
    });
  }
 
  document.addEventListener("DOMContentLoaded", () => {
    initBlockTypeSelector();
  });
</script>
 

