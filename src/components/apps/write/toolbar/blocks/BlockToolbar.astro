---
/**
 * @file src/components/apps/write/toolbar/BlockToolbar.astro
 *
 * Compact writing toolbar with:
 * - Primary toolbar buttons
 * - Heading dropdown group
 * - Persistent heading memory
 * - Ctrl+N shortcuts
 * - Pin/unpin support
 */

interface Props {
  activeDocumentId: string | null;
}

const { activeDocumentId } = Astro.props;

const ALL_BLOCKS = [
  {
    type: "paragraph",
    icon: "P",
    title: "Paragraph",
    defaultPrimary: true,
  },

  {
    type: "heading-group",
    icon: "H",
    title: "Headings",
    defaultPrimary: true,

    children: [
      { type: "heading", icon: "H1", title: "Heading 1" },
      { type: "heading-2", icon: "H2", title: "Heading 2" },
      { type: "heading-3", icon: "H3", title: "Heading 3" },
      { type: "heading-4", icon: "H4", title: "Heading 4" },
      { type: "heading-5", icon: "H5", title: "Heading 5" },
    ],
  },

  {
    type: "quote",
    icon: `"`,
    title: "Quote",
    defaultPrimary: true,
  },

  {
    type: "checklist",
    icon: "CL",
    title: "Checklist item",
    defaultPrimary: true,
  },

  {
    type: "code",
    icon: "{}",
    title: "Code block",
    defaultPrimary: false,
  },

  {
    type: "callout",
    icon: "!!",
    title: "Callout",
    defaultPrimary: false,
  },

  {
    type: "separator",
    icon: "--",
    title: "Horizontal rule",
    defaultPrimary: false,
  },

  {
    type: "prompt",
    icon: "**",
    title: "Writing prompt",
    defaultPrimary: false,
  },
];
---

{activeDocumentId && (
  <div
    class="block-toolbar"
    id="block-toolbar"
    role="toolbar"
    aria-label="Block type"
  >
    <div class="bt-primary" id="bt-primary"></div>

    <div class="bt-divider" aria-hidden="true"></div>

    <div class="bt-more-wrapper" id="bt-more-wrapper">
      <button
        class="bt-btn bt-more-trigger"
        id="bt-more-trigger"
        type="button"
        aria-haspopup="listbox"
        aria-expanded="false"
      >
        <span class="bt-icon">...</span>
      </button>

      <ul
        class="bt-dropdown"
        id="bt-dropdown"
        role="listbox"
        hidden
      ></ul>
    </div>
  </div>
)}

<script
  id="bt-block-defs"
  type="application/json"
  set:html={JSON.stringify(ALL_BLOCKS)}
></script>

<style is:global>
  .block-toolbar {
    display: flex;
    align-items: center;
  }

  .bt-primary {
    display: flex;
    align-items: center;
  }

  .bt-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    height: 48px;
    border: none;
    border-radius: 5px;
    background: transparent;
    color: var(--text-3);
    font-size: 1rem;
    font-weight: 700;
    font-family: var(--font-mono, monospace);
    cursor: pointer;
    user-select: none;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .bt-btn:hover {
    background-color: var(--accent-light);
    color: var(--txt);
  }

  .bt-btn[aria-pressed="true"] {
    background-color:
      color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
  }

  .bt-icon {
    display: flex;
    align-items: center;
    padding: .5rem;
    width: 48px;
    height: 48px;
    text-align: center;
    align-items: center;
    justify-content: center;
    transition: 0.4s ease all;
  }

  .bt-icon:hover {
    /* background-color: hsl(var(--back-3-hsl) / 0.8); */
    background-color: var(--accent-light);
    color: var(--txt);
    
  }

  .bt-heading-chevron {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  .bt-shortcut-badge {
    position: absolute;
    bottom: -12px;
    right: 50%;
    transform: translateX(50%);
    padding: 0.1rem 0.4rem;
    background: hsl(var(--back-3-hsl) / 0.35);
    color: var(--txt-2);
    font-size: 0.9em;
    font-weight: 700;
    line-height: 1;
    opacity: 0;
    pointer-events: none;
    box-shadow: 1px 2px 3px rgba(0, 0, 0, 0.4);
    transition: opacity 0.2s ease-in-out;
  }

  .block-toolbar.ctrl-mode .bt-shortcut-badge {
    opacity: 1;
  }

  .bt-divider {
    width: 1px;
    height: 16px;

    margin: 0 0.25rem;

    background-color: hsl(var(--txt-3-hsl) / 0.5);
  }

  .bt-more-wrapper,
  .bt-heading-wrapper {
    position: relative;
  }

  .bt-dropdown {
    position: absolute;
    top: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    min-width: 210px;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background-color: var(--back);
    border: 1px solid var(--back-2);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }

  .bt-heading-dropdown {
    position: absolute;
    top: calc(100% + 2px);
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    margin: 0;
    padding: 0.1rem .05rem;
    list-style: none;
    background-color: var(--back-2);
    border: 1px solid var(--back-3);
    border-radius: 6px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }

  .bt-dropdown[hidden],
  .bt-heading-dropdown[hidden] {
    display: none;
  }

  .bt-dropdown-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s;
    background-color: var(--back-2);
  }

  .bt-dropdown-option:hover {
    background-color: hsl(var(--back-3-hsl) / 0.5);
  }

  .bt-dropdown-option[aria-selected="true"] {
    color: var(--accent);
    font-weight: 600;
  }

  .bt-dropdown-icon {
    width: 2rem;
    flex-shrink: 0;
    text-align: center;
    color: hsl(var(--text-3-hsl)/.8);
    font-size: var(--fs-xl);
    font-family: var(--font-mono, monospace);
    font-weight: 600;
    border-radius: none;
  }
background-color: hsl(var(--back-hsl) / 0.7);
    color: var(--color-text);
  .bt-dropdown-title {
    flex: 1;
    color: var(--text-3);
    font-size: var(--fs-xl);
  }

  .bt-pin-btn {
    margin-left: auto;
    padding: 0.1rem 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.65rem;
    cursor: pointer;
  }

  .bt-pin-btn:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>

<script>
  /**
   * @description LocalStorage key for persisted primary toolbar buttons.
   */
  const STORAGE_KEY = "write:toolbar-primary";

  /**
   * @description Last-used heading level.
   */
  let lastUsedHeadingType = "heading";

  interface HeadingChild {
    type: string;
    icon: string;
    title: string;
  }

  interface BlockDef {
    type: string;
    icon: string;
    title: string;
    defaultPrimary: boolean;
    children?: HeadingChild[];
  }

  function isHeadingType(type: string): boolean {
    return type.startsWith("heading");
  }

  /**
   * @description Parse block definitions from JSON script tag.
   */
  function loadDefs(): BlockDef[] {
    const el = document.getElementById("bt-block-defs");

    try {
      return JSON.parse(el?.textContent ?? "[]") as BlockDef[];
    } catch {
      return [];
    }
  }

  /**
   * @description Load primary toolbar button types.
   */
  function loadPrimaryTypes(defs: BlockDef[]): string[] {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);

      if (saved) {
        return JSON.parse(saved) as string[];
      }
    } catch {
      //
    }

    return defs
      .filter((d) => d.defaultPrimary)
      .map((d) => d.type);
  }

  /**
   * @description Persist primary toolbar layout.
   */
  function savePrimaryTypes(types: string[]): void {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(types));
  }

  /**
   * @description Initialize block toolbar.
   */
  function initBlockToolbar(): void {
    const toolbar = document.getElementById("block-toolbar");

    const primary = document.getElementById("bt-primary");

    const moreBtn = document.getElementById(
      "bt-more-trigger",
    ) as HTMLButtonElement | null;

    const dropdown = document.getElementById(
      "bt-dropdown",
    ) as HTMLUListElement | null;

    const wrapper = document.getElementById("bt-more-wrapper");

    if (
      !toolbar ||
      !primary ||
      !moreBtn ||
      !dropdown ||
      !wrapper
    ) {
      return;
    }

    const defs = loadDefs();

    let primaryTypes = loadPrimaryTypes(defs);

    /**
     * @description Dispatch block type event.
     */
    function dispatchBlockType(blockType: string): void {
      if (blockType.startsWith("heading")) {
        lastUsedHeadingType = blockType;
      }

      window.dispatchEvent(
        new CustomEvent("editor:set-block-type", {
          detail: { blockType },
        }),
      );
    }

    /**
     * @description Render toolbar buttons.
     */
    function renderPrimary(): void {
      primary!.innerHTML = "";

      primaryTypes.forEach((type, idx) => {
        const def = defs.find((d) => d.type === type);

        if (!def) {
          return;
        }

        /**
         * HEADING GROUP
         */
        if (type === "heading-group" && def.children) {
          const wrapper = document.createElement("div");

          wrapper.className = "bt-heading-wrapper";

          const btn = document.createElement("button");

          btn.className = "bt-btn";
          btn.type = "button";

          btn.innerHTML = `
            <span class="bt-icon">
              <span id="bt-heading-current">H1</span>
            </span>
          `;

          const menu = document.createElement("ul");

          menu.className = "bt-heading-dropdown";
          menu.hidden = true;

          def.children.forEach((child) => {
            const li = document.createElement("li");

            li.className = "bt-dropdown-option";
            li.dataset.blockType = child.type;

            li.innerHTML = `
              <span class="bt-dropdown-icon">${child.icon}</span>
            `;

            li.addEventListener("click", () => {
              dispatchBlockType(child.type);

              const current =
                wrapper.querySelector("#bt-heading-current");

              if (current) {
                current.textContent = child.icon;
              }

              menu.hidden = true;
            });

            menu.appendChild(li);
          });

          btn.addEventListener("click", () => {
            menu.hidden = !menu.hidden;
          });

          document.addEventListener("click", (event) => {
            if (!wrapper.contains(event.target as Node)) {
              menu.hidden = true;
            }
          });

          if (idx < 9) {
            const badge = document.createElement("span");

            badge.className = "bt-shortcut-badge";
            badge.textContent = String(idx + 1);

            btn.appendChild(badge);
          }

          wrapper.appendChild(btn);
          wrapper.appendChild(menu);

          primary!.appendChild(wrapper);

          return;
        }

        

        /**
         * STANDARD BUTTON
         */
        const btn = document.createElement("button");

        btn.className = "bt-btn";

        btn.type = "button";

        btn.dataset.blockType = type;

        btn.innerHTML = `
          <span class="bt-icon">${def.icon}</span>
        `;

        if (idx < 9) {
          const badge = document.createElement("span");

          badge.className = "bt-shortcut-badge";
          badge.textContent = String(idx + 1);

          btn.appendChild(badge);
        }

        btn.addEventListener("click", () => {
          dispatchBlockType(type);
        });

        primary!.appendChild(btn);
      });
    }

    /**
     * @description Render secondary dropdown.
     */
    function renderDropdown(): void {
      dropdown!.innerHTML = "";

      const secondaryDefs = defs.filter((d) => {
        if (isHeadingType(d.type)) {
          return false;
        }

        return !primaryTypes.includes(d.type);
      });

      secondaryDefs.forEach((def) => {
        const li = document.createElement("li");

        li.className = "bt-dropdown-option";

        li.innerHTML = `
          <span class="bt-dropdown-icon">${def.icon}</span>
          <span class="bt-dropdown-title">${def.title}</span>
        `;

        li.addEventListener("click", () => {
          dispatchBlockType(def.type);

          dropdown!.hidden = true;

          moreBtn!.setAttribute("aria-expanded", "false");
        });

        dropdown!.appendChild(li);
      });
    }

    /**
     * @description Toggle secondary dropdown.
     */
    moreBtn.addEventListener("click", () => {
      const isOpen = !dropdown.hidden;

      dropdown.hidden = isOpen;

      moreBtn.setAttribute(
        "aria-expanded",
        String(!isOpen),
      );
    });

    /**
     * @description Close dropdown on outside click.
     */
    document.addEventListener("click", (event) => {
      if (!wrapper.contains(event.target as Node)) {
        dropdown.hidden = true;

        moreBtn.setAttribute("aria-expanded", "false");
      }
    });

    /**
     * @description Keyboard shortcuts.
     */
    document.addEventListener("keydown", (event) => {
      if (!(event.ctrlKey || event.metaKey)) {
        return;
      }

      toolbar.classList.add("ctrl-mode");

      const num = parseInt(event.key, 10);

      if (isNaN(num)) {
        return;
      }

      const mapped = primaryTypes[num - 1];

      if (!mapped) {
        return;
      }

      event.preventDefault();

      /**
       * Heading group uses last-used heading level.
       */
      if (mapped === "heading-group") {
        dispatchBlockType(lastUsedHeadingType);

        return;
      }

      dispatchBlockType(mapped);
    });

    /**
     * @description Remove ctrl-mode visuals.
     */
    document.addEventListener("keyup", (event) => {
      if (
        event.key === "Control" ||
        event.key === "Meta"
      ) {
        toolbar.classList.remove("ctrl-mode");
      }
    });

    renderPrimary();

    renderDropdown();
  }

  document.addEventListener("DOMContentLoaded", () => {
    initBlockToolbar();
  });
</script>