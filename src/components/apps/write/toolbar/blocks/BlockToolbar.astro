---
/**
 * @file src/components/apps/write/toolbar/BlockToolbar.astro
 *
 * Features:
 * - Primary buttons: shown directly in toolbar, one-click to apply.
 * - Secondary ("More") dropdown: less-used types.
 * - Ctrl+N shortcuts: hold Ctrl to see number overlays, press to apply.
 * - Right-click a primary button to demote it to secondary.
 * - "Pin" button in dropdown to promote to primary.
 * - Preferences saved to localStorage.
 */

interface Props {
  activeDocumentId: string | null;
}

const { activeDocumentId } = Astro.props;

/**
 * Blocks shown as direct icon buttons in the toolbar.
 * Keep this to 5–6 max so the toolbar doesn't overflow on small screens.
 */
const ALL_BLOCKS = [
  { type: "paragraph",  icon: "P",    label: "Paragraph", title: "Paragraph",          defaultPrimary: true  },
  { type: "heading",    icon: "H1",   label: "H1",        title: "Heading 1",          defaultPrimary: true  },
  { type: "heading-2",  icon: "H2",   label: "H2",        title: "Heading 2",          defaultPrimary: true  },
  { type: "heading-3",  icon: "H3",   label: "H3",        title: "Heading 3",          defaultPrimary: true  },
  { type: "quote",      icon: "SS",   label: "Quote",     title: "Quote",              defaultPrimary: true  },
  { type: "checklist",  icon: "CL",   label: "Check",     title: "Checklist item",     defaultPrimary: true  },
  { type: "heading-4",  icon: "H4",   label: "H4",        title: "Heading 4",          defaultPrimary: false },
  { type: "heading-5",  icon: "H5",   label: "H5",        title: "Heading 5",          defaultPrimary: false },
  { type: "code",       icon: "{}",   label: "Code",      title: "Code block",         defaultPrimary: false },
  { type: "callout",    icon: "!!",   label: "Callout",   title: "Callout (Ctrl+</>)", defaultPrimary: false },
  { type: "separator",  icon: "--",   label: "Divider",   title: "Horizontal rule",    defaultPrimary: false },
  { type: "prompt",     icon: "**",   label: "Prompt",    title: "Writing prompt",     defaultPrimary: false },
];

---

{activeDocumentId && (
  <div class="block-toolbar" id="block-toolbar" role="toolbar" aria-label="Block type">
    <div class="bt-primary" id="bt-primary"></div>
    <div class="bt-divider" aria-hidden="true"></div>
    <div class="bt-more-wrapper" id="bt-more-wrapper">
      <button class="bt-btn bt-more-trigger" id="bt-more-trigger" type="button"
        aria-haspopup="listbox" aria-expanded="false" title="More block types">
        <span class="bt-icon" aria-hidden="true">...</span>
      </button>
      <ul class="bt-dropdown" id="bt-dropdown" role="listbox" hidden></ul>
    </div>
  </div>
)}

<script id="bt-block-defs" type="application/json" set:html={JSON.stringify(ALL_BLOCKS)}></script>
 


<style is:global>
    .block-toolbar { display: flex; align-items: center; gap: 0.125rem; }
  .bt-primary    { display: flex; align-items: center; gap: 0.125rem; }
 
  .bt-btn {
    position: relative;
    display: flex; 
    align-items: center; 
    justify-content: center;
    min-width: 48px; 
    height: 48px; 
    padding: 0 0.3rem;
    border: none; border-radius: 5px; background: transparent;
    color: var(--color-text-muted);
    font-size: 1rem; font-weight: 700;
    font-family: var(--font-mono, monospace);
    cursor: pointer;
    transition: background-color 0.1s, color 0.1s;
    white-space: nowrap; user-select: none;
  }
  .bt-btn:hover { background-color: var(--color-surface-hover); color: var(--color-text); }
  .bt-btn[aria-pressed="true"] {
    background-color: color-mix(in srgb, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
  }
  .bt-icon { 
    display: block; 
    line-height: 1; 
  }
 
  /* Ctrl+N number badge */
  .bt-shortcut-badge {
    position: absolute; 
    bottom: -10px; 
    right: 50%;
    font-size: .9em; 
    font-weight: 700; 
    line-height: 1;
    color: var(--green3);
    background: #adadad76;
    opacity: 0; 
    transition: opacity 0.4s; 
    pointer-events: none;
    transform: translateX(50%);
    padding: 0.2rem 0.4rem;
    /* border-radius: 50%; */
  }
  .block-toolbar.ctrl-mode .bt-shortcut-badge { opacity: 1; }
 
  .bt-divider { width: 1px; height: 16px; background-color: var(--color-border); margin: 0 0.25rem; flex-shrink: 0; }
  .bt-more-wrapper { position: relative; }
 
  .bt-dropdown {
    position: absolute; top: calc(100% + 6px); right: 0; z-index: 200;
    list-style: none; margin: 0; padding: 0.25rem;
    background-color: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 8px; box-shadow: 0 8px 24px rgba(0,0,0,0.2); min-width: 210px;
  }
  .bt-dropdown[hidden] { display: none; }
 
  .bt-dropdown-option {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 0.6rem; border-radius: 5px;
    cursor: pointer; font-size: 0.8125rem; color: var(--color-text);
    transition: background-color 0.1s;
  }
  .bt-dropdown-option:hover { background-color: var(--color-surface-hover); }
  .bt-dropdown-option[aria-selected="true"] { color: var(--color-accent); font-weight: 600; }
 
  .bt-dropdown-icon {
    width: 2rem; text-align: center;
    font-size: 0.7rem; font-family: var(--font-mono, monospace); font-weight: 700;
    color: var(--color-text-muted); flex-shrink: 0;
  }
  .bt-dropdown-title { color: var(--color-text); font-size: 0.8125rem; flex: 1; }
 
  .bt-pin-btn {
    margin-left: auto; padding: 0.1rem 0.35rem;
    border: 1px solid var(--color-border); border-radius: 4px;
    background: transparent; color: var(--color-text-muted);
    font-size: 0.65rem; cursor: pointer; white-space: nowrap;
    transition: color 0.1s, border-color 0.1s;
  }
  .bt-pin-btn:hover { color: var(--color-accent); border-color: var(--color-accent); }
  .bt-demote-hint {
    font-size: 1rem; 
    color: var(--blue);
    background: var(--color-bg-secondary);
    margin-top: 0.5rem; 
    border-radius: 50%;
    border: 1px solid var(--green);
    display: block; 
    text-align: center;
  }

</style>

<script>
  const STORAGE_KEY = "write:toolbar-primary";
 
  interface BlockDef {
    type: string; icon: string; label: string; title: string; defaultPrimary: boolean;
  }
 
  function loadDefs(): BlockDef[] {
    const el = document.getElementById("bt-block-defs");
    try { return JSON.parse(el?.textContent ?? "[]") as BlockDef[]; } catch { return []; }
  }
 
  function loadPrimaryTypes(defs: BlockDef[]): string[] {
    try {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) return JSON.parse(saved) as string[];
    } catch { /* ignore */ }
    return defs.filter((d) => d.defaultPrimary).map((d) => d.type);
  }
 
  function savePrimaryTypes(types: string[]): void {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(types));
  }
 
  function initBlockToolbar(): void {
    const toolbar  = document.getElementById("block-toolbar");
    const primary  = document.getElementById("bt-primary");
    const moreBtnEl = document.getElementById("bt-more-trigger") as HTMLButtonElement | null;
    const dropdownEl = document.getElementById("bt-dropdown")    as HTMLUListElement  | null;
    const wrapper  = document.getElementById("bt-more-wrapper");
 
    if (!toolbar || !primary || !moreBtnEl || !dropdownEl || !wrapper) return;
 
    // Re-type as non-null for use inside closures
    const moreBtn:  HTMLButtonElement = moreBtnEl;
    const dropdown: HTMLUListElement  = dropdownEl;
 
    const defs = loadDefs();
    let primaryTypes = loadPrimaryTypes(defs);
    let lastActiveType: string | null = null;
 
    function dispatchBlockType(blockType: string): void {
      window.dispatchEvent(new CustomEvent("editor:set-block-type", { detail: { blockType } }));
    }
 
    function syncActiveType(activeType: string | null): void {
      lastActiveType = activeType;
      primary!.querySelectorAll<HTMLButtonElement>("[data-block-type]").forEach((btn) => {
        btn.setAttribute("aria-pressed", String(btn.dataset.blockType === activeType));
      });
      dropdown.querySelectorAll<HTMLElement>("[data-block-type]").forEach((opt) => {
        opt.setAttribute("aria-selected", String(opt.dataset.blockType === activeType));
      });
    }
 
    function renderPrimary(): void {
      primary!.innerHTML = "";
      primaryTypes.forEach((type, idx) => {
        const def = defs.find((d) => d.type === type);
        if (!def) return;
 
        const btn = document.createElement("button");
        btn.className           = "bt-btn";
        btn.type                = "button";
        btn.dataset.blockType   = type;
        btn.setAttribute("aria-label",   def.title);
        btn.setAttribute("aria-pressed", "false");
        btn.title               = `${def.title}${idx < 9 ? ` (Ctrl+${idx + 1})` : ""}`;
 
        const icon = document.createElement("span");
        icon.className   = "bt-icon";
        icon.textContent = def.icon;
        btn.appendChild(icon);
 
        if (idx < 9) {
          const badge = document.createElement("span");
          badge.className   = "bt-shortcut-badge";
          badge.textContent = String(idx + 1);
          btn.appendChild(badge);
        }
 
        btn.addEventListener("mousedown", (e) => e.preventDefault());
        btn.addEventListener("click", () => dispatchBlockType(type));
 
        // Right-click to demote
        btn.addEventListener("contextmenu", (e) => {
          e.preventDefault();
          primaryTypes = primaryTypes.filter((t) => t !== type);
          savePrimaryTypes(primaryTypes);
          renderPrimary();
          renderDropdown();
        });
 
        primary!.appendChild(btn);
      });
 
      // Hint shown at the bottom of primary area
      const hint = document.createElement("span");
      hint.className   = "bt-demote-hint";
      hint.style.display = "none"; // revealed inside dropdown instead
      syncActiveType(lastActiveType);
    }
 
    function renderDropdown(): void {
      dropdown.innerHTML = "";
      const secondaryDefs = defs.filter((d) => !primaryTypes.includes(d.type));
 
      if (secondaryDefs.length === 0) {
        const li = document.createElement("li");
        li.style.padding = "0.5rem 0.6rem";
        li.style.fontSize = "0.75rem";
        li.style.color = "var(--color-text-muted)";
        li.textContent = "All blocks are in the toolbar";
        li.className = "bt-dropdown-option";
        dropdown.appendChild(li);
      } else {
        secondaryDefs.forEach((def) => {
          const li = document.createElement("li");
          li.className         = "bt-dropdown-option";
          li.dataset.blockType = def.type;
          li.setAttribute("role",          "option");
          li.setAttribute("aria-selected", "false");
 
          const iconEl = document.createElement("span");
          iconEl.className   = "bt-dropdown-icon";
          iconEl.textContent = def.icon;
 
          const titleEl = document.createElement("span");
          titleEl.className   = "bt-dropdown-title";
          titleEl.textContent = def.title;
 
          const pinBtn = document.createElement("button");
          pinBtn.className   = "bt-pin-btn";
          pinBtn.type        = "button";
          pinBtn.textContent = "Pin";
          pinBtn.title       = "Add to toolbar";
          pinBtn.addEventListener("mousedown", (e) => e.preventDefault());
          pinBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            primaryTypes = primaryTypes.length < 9
              ? [...primaryTypes, def.type]
              : [...primaryTypes.slice(1), def.type];
            savePrimaryTypes(primaryTypes);
            renderPrimary();
            renderDropdown();
            dropdown.hidden = true;
            moreBtn.setAttribute("aria-expanded", "false");
          });
 
          li.appendChild(iconEl);
          li.appendChild(titleEl);
          li.appendChild(pinBtn);
          dropdown.appendChild(li);
        });
      }
 
      // Footer hint
      const hint = document.createElement("li");
      hint.style.cssText = "padding: 0.4rem 0.6rem; font-size: 0.65rem; color: var(--color-text-muted); border-top: 1px solid var(--color-border); margin-top: 0.25rem; list-style: none;";
      hint.textContent = "Right-click toolbar buttons to move here";
      dropdown.appendChild(hint);
    }
 
    // ── Dropdown open/close ────────────────────────────────────────────────
 
    moreBtn.addEventListener("mousedown", (e) => e.preventDefault());
    moreBtn.addEventListener("click", () => {
      const isOpen = !dropdown.hidden;
      dropdown.hidden = isOpen;
      moreBtn.setAttribute("aria-expanded", String(!isOpen));
    });
 
    dropdown.addEventListener("mousedown", (e) => e.preventDefault());
    dropdown.addEventListener("click", (e) => {
      const option = (e.target as HTMLElement).closest<HTMLElement>("[data-block-type]");
      if (!option || (e.target as HTMLElement).classList.contains("bt-pin-btn")) return;
      const blockType = option.dataset.blockType;
      if (blockType) dispatchBlockType(blockType);
      dropdown.hidden = true;
      moreBtn.setAttribute("aria-expanded", "false");
    });
 
    document.addEventListener("click", (e) => {
      if (!wrapper.contains(e.target as Node)) {
        dropdown.hidden = true;
        moreBtn.setAttribute("aria-expanded", "false");
      }
    });
 
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        dropdown.hidden = true;
        moreBtn.setAttribute("aria-expanded", "false");
      }
    });
 
    // ── Ctrl+N shortcuts ───────────────────────────────────────────────────
 
    document.addEventListener("keydown", (e) => {
      if (e.ctrlKey || e.metaKey) {
        toolbar.classList.add("ctrl-mode");
        const num = parseInt(e.key, 10);
        if (!isNaN(num) && num >= 1 && num <= primaryTypes.length) {
          e.preventDefault();
          dispatchBlockType(primaryTypes[num - 1]);
        }
      }
    });
 
    document.addEventListener("keyup", (e) => {
      if (e.key === "Control" || e.key === "Meta") {
        toolbar.classList.remove("ctrl-mode");
      }
    });
 
    // ── Focus sync ─────────────────────────────────────────────────────────
 
    window.addEventListener("editor:block-focused", ((e: CustomEvent) => {
      syncActiveType((e.detail as { blockType?: string }).blockType ?? null);
    }) as EventListener);
 
    window.addEventListener("editor:title-focused", () => syncActiveType(null));
 
    // ── Initial render ─────────────────────────────────────────────────────
    renderPrimary();
    renderDropdown();
  }
 
  document.addEventListener("DOMContentLoaded", () => {
    initBlockToolbar();
  });
</script>
