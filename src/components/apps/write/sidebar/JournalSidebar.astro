---
/**
 * @file src/components/apps/journal/sidebar/JournalSidebar.astro
 * @description Left sidebar for the Write app.
 *
 * Displays:
 * - A search input for filtering documents
 * - A "New Document" button
 * - A "New Folder" button (inline prompt, no modal)
 * - A folder tree with documents nested inside each folder
 * - An "All Documents" section for unfiled documents
 *
 * Receives the lightweight DocumentIndexRow array — never full content_blocks.
 * All document navigation is done by setting the `?doc=` query parameter.
 */

import type { DocumentIndexRow, Folder } from "@/lib/journal/types";
import SidebarSearch from './SidebarSearch.astro';
import NewDocumentButton from './NewDocumentButton.astro';
import NewFolderButton from './NewFolderButton.astro';
import FolderTree from "./FolderTree.astro";
import './sidebar.css';

interface Props {
  documents: DocumentIndexRow[];
  folders: Folder[];
  activeDocumentId: string | null;
  user: any;
}

const { documents, folders, activeDocumentId, user } = Astro.props;
---

<nav class="sidebar" aria-label="Document navigation">
  <!-- Search -->
  <SidebarSearch activeDocumentId={activeDocumentId} user={user} />

  <!-- Action buttons: New Document + New Folder -->
  <div class="sidebar-actions">
    <NewDocumentButton activeDocumentId={activeDocumentId} user={user} />
    <NewFolderButton />
  </div>

  <!-- Folder tree and document list -->
  <FolderTree
    documents={documents}
    folders={folders}
    activeDocumentId={activeDocumentId}
    user={user}
  />
</nav>

<style>
  /* Override sidebar-actions so the two buttons stack cleanly */
  .sidebar-actions {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.375rem 0.5rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
</style>
