---
import FolderTree from "@/components/apps/write/sidebar/FolderTree.astro";
import DocumentItem from "@/components/apps/write/sidebar/FolderTree/DocumentItem.astro";
import NewDocumentButton from "@/components/apps/write/sidebar/NewDocumentButton.astro";
import SidebarSearch from "@/components/apps/write/sidebar/SidebarSearch.astro";
import type { DocumentIndexRow as Document, Folder } from "@/lib/journal/types";
import './sidebar.css';

// interface Folder {
//   id: string;
//   name: string;
//   icon: string | null;
//   parent_id: string | null;
//   is_archived: boolean;
//   children?: Folder[];
// }

// interface Document {
//   id: string;
//   title: string;
//   folder_id: string | null;
//   is_archived: boolean;
//   pinned: boolean;
// }

interface Props {
  folders: Folder[];
  documents: Document[];
  activeDocumentId: string | null;
  activeFolderId: string | null;
  user: any;
}

const { folders, documents, activeDocumentId, activeFolderId, user } = Astro.props;

const rootDocs = documents.filter((d) => d.folder_id === null && !d.is_archived);
---

<aside 
  class="sidebar" 
  id="sidebar-document-list" 
  data-folders={JSON.stringify(folders.map(f => ({ id: f.id, name: f.name, icon: f.icon || "📁" })))}
>
  <SidebarSearch activeDocumentId={activeDocumentId} user={user} />

  <div class="sidebar-header">
    <NewDocumentButton activeDocumentId={activeDocumentId} user={user} />
  </div>

  <div class="sidebar-section">
    <h4 class="sidebar-label">Folders</h4>
    <FolderTree
      folders={folders}
      documents={documents}
      activeFolderId={activeFolderId}
      activeDocumentId={activeDocumentId}
    />
  </div>

  <div class="sidebar-section">
    <h4 class="sidebar-label">All Documents</h4>
    <div class="doc-list">
      {rootDocs.map((doc) => (
        <DocumentItem
          id={doc.id}
          title={doc.title}
          folderId={doc.folder_id}
          isArchived={doc.is_archived}
          pinned={doc.pinned}
          active={activeDocumentId === doc.id}
          updatedAt={doc.updated_at}
        />
      ))}
    </div>
  </div>
</aside>

<script>
  import { initFolderToggles, initRealtimeUpdates } from "./FolderTree/sidebar.client";
  document.addEventListener("DOMContentLoaded", () => {
    initFolderToggles();
    initRealtimeUpdates();
  });
</script>

