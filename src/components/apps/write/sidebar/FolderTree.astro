---
import ActionPopover from "@/components/apps/write/ActionPopover.astro";
import DocumentItem from "@/components/apps/write/sidebar/FolderTree/DocumentItem.astro";

interface Folder {
  id: string;
  name: string;
  icon: string | null;
  parent_id: string | null;
  is_archived: boolean;
  children?: Folder[];
}

interface Document {
  id: string;
  title: string;
  folder_id: string | null;
  is_archived: boolean;
  pinned: boolean;
  updated_at?: string;
}

interface Props {
  folders: Folder[];
  documents: Document[];
  activeFolderId: string | null;
  activeDocumentId: string | null;
}

const { folders, documents, activeFolderId, activeDocumentId } = Astro.props;
---

<div class="folder-tree">
  {folders.map((folder) => {
    const folderDocs = documents.filter((d) => d.folder_id === folder.id && !d.is_archived);
    return (
      <div class="folder-block">
        <div class="folder-row">
          <div class="folder-meta-wrap">
            <button
              type="button"
              class="folder-toggle"
              data-folder-toggle
              data-folder-id={folder.id}
              aria-controls={`folder-children-${folder.id}`}
              aria-expanded="false"
            >
              <svg class="folder-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <polyline points="2,3 5,7 8,3"/>
              </svg>
            </button>
            
            <a
              href={`/app/write/${folder.id}`}
              class={`folder-link ${activeFolderId === folder.id ? "active" : ""}`}
            >
              <span class="folder-icon">{folder.icon ?? "📁"}</span>
              <span class="folder-name">{folder.name}</span>
            </a>
          </div>

          <ActionPopover
            type="folder"
            id={folder.id}
            name={folder.name}
            actions={[
              "rename",
              "delete",
              folder.is_archived ? "unarchive" : "archive",
              "new-subfolder"
            ]}
          />
        </div>

        <div id={`folder-children-${folder.id}`} class="folder-children" style="display: none;">
          <!-- Render nested child folders -->
          {folder.children && folder.children.length > 0 && (
            <div class="folder-tree">
              {folder.children.map((child) => {
                const childDocs = documents.filter((d) => d.folder_id === child.id && !d.is_archived);
                return (
                  <div class="folder-block">
                    <div class="folder-row">
                      <div class="folder-meta-wrap">
                        <button
                          type="button"
                          class="folder-toggle"
                          data-folder-toggle
                          data-folder-id={child.id}
                          aria-controls={`folder-children-${child.id}`}
                          aria-expanded="false"
                        >
                          <svg class="folder-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                            <polyline points="2,3 5,7 8,3"/>
                          </svg>
                        </button>

                        <a
                          href={`/app/write/${child.id}`}
                          class={`folder-link ${activeFolderId === child.id ? "active" : ""}`}
                        >
                          <span class="folder-icon">{child.icon ?? "📁"}</span>
                          <span class="folder-name">{child.name}</span>
                        </a>
                      </div>

                      <ActionPopover
                        type="folder"
                        id={child.id}
                        name={child.name}
                        actions={[
                          "rename",
                          "delete",
                          child.is_archived ? "unarchive" : "archive",
                          "new-subfolder"
                        ]}
                      />
                    </div>

                    <div id={`folder-children-${child.id}`} class="folder-children" style="display: none;">
                      <!-- Render grand child folders -->
                      {child.children && child.children.length > 0 && (
                        <div class="folder-tree">
                          {child.children.map((grand) => {
                            const grandDocs = documents.filter((d) => d.folder_id === grand.id && !d.is_archived);
                            return (
                              <div class="folder-block">
                                <div class="folder-row">
                                  <div class="folder-meta-wrap">
                                    <button
                                      type="button"
                                      class="folder-toggle"
                                      data-folder-toggle
                                      data-folder-id={grand.id}
                                      aria-controls={`folder-children-${grand.id}`}
                                      aria-expanded="false"
                                    >
                                      <svg class="folder-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                                        <polyline points="2,3 5,7 8,3"/>
                                      </svg>
                                    </button>

                                    <a
                                      href={`/app/write/${grand.id}`}
                                      class={`folder-link ${activeFolderId === grand.id ? "active" : ""}`}
                                    >
                                      <span class="folder-icon">{grand.icon ?? "📁"}</span>
                                      <span class="folder-name">{grand.name}</span>
                                    </a>
                                  </div>

                                  <ActionPopover
                                    type="folder"
                                    id={grand.id}
                                    name={grand.name}
                                    actions={[
                                      "rename",
                                      "delete",
                                      grand.is_archived ? "unarchive" : "archive",
                                      "new-subfolder"
                                    ]}
                                  />
                                </div>
                                
                                <div id={`folder-children-${grand.id}`} class="folder-children" style="display: none;">
                                  <!-- Render grand documents -->
                                  {grandDocs.map((doc) => (
                                    <DocumentItem
                                      id={doc.id}
                                      title={doc.title}
                                      folderId={doc.folder_id}
                                      isArchived={doc.is_archived}
                                      pinned={doc.pinned}
                                      active={activeDocumentId === doc.id}
                                      updatedAt={doc.updated_at}
                                    />
                                  ))}
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      )}

                      <!-- Render child documents -->
                      {childDocs.map((doc) => (
                        <DocumentItem
                          id={doc.id}
                          title={doc.title}
                          folderId={doc.folder_id}
                          isArchived={doc.is_archived}
                          pinned={doc.pinned}
                          active={activeDocumentId === doc.id}
                          updatedAt={doc.updated_at}
                        />
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          <!-- Render root folder documents -->
          {folderDocs.map((doc) => (
            <DocumentItem
              id={doc.id}
              title={doc.title}
              folderId={doc.folder_id}
              isArchived={doc.is_archived}
              pinned={doc.pinned}
              active={activeDocumentId === doc.id}
              updatedAt={doc.updated_at}
            />
          ))}
        </div>
      </div>
    );
  })}
</div>

<style>
  .folder-tree {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .folder-block {
    display: flex;
    flex-direction: column;
  }

  .folder-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 10px;
    margin: 1px 0;
    border-radius: 0px;
    transition: all var(--journal-transition-speed, 0.25s) ease;
  }

  .folder-meta-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    min-width: 0;
  }

  .folder-row:hover {
    background: var(--journal-item-hover, rgba(0, 210, 190, 0.06));
  }

  .folder-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 4px;
    margin-right: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--journal-sidebar-text, var(--txt-3, #475569));
    opacity: 0.6;
    transition: all var(--journal-transition-speed, 0.25s) ease;
  }

  .folder-toggle:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .folder-chevron {
    transition: transform var(--journal-transition-speed, 0.25s) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .folder-toggle[aria-expanded="false"] .folder-chevron {
    transform: rotate(-90deg);
  }

  .folder-link {
    display: flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--journal-sidebar-text, var(--txt-3, #475569));
    flex: 1;
    font-size: 14px;
    font-weight: 500;
  }

  .folder-link.active {
    font-weight: 700;
    color: var(--journal-accent, var(--accent, #dc3a68));
  }

  .folder-icon {
    font-size: 15px;
  }

  .folder-children {
    margin-left: 20px;
    border-left: 1px dashed rgba(15, 18, 25, 0.08);
    padding-left: 8px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
</style>
