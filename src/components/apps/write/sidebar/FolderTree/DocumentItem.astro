---
import ActionPopover from "@/components/apps/write/ActionPopover.astro";
import { formatUpdatedAt } from "../sidebar.utils";

interface Props {
  id: string;
  title: string;
  folderId: string | null;
  isArchived: boolean;
  pinned: boolean;
  active: boolean;
  updatedAt?: string;
}

const { id, title, folderId, isArchived, pinned, active, updatedAt } = Astro.props;
---

<div class={`doc-row ${active ? "active" : ""}`}>
  <a href={`/app/write?doc=${id}`} class="doc-link">
    <span class="doc-title">{title}</span>
    {updatedAt && <span class="doc-meta">{formatUpdatedAt(updatedAt)}</span>}
  </a>

  <ActionPopover
    type="document"
    id={id}
    name={title}
    actions={[
      "rename",
      "delete",
      isArchived ? "unarchive" : "archive",
      "duplicate",
      "move"
    ]}
  />
</div>

<style>
  .doc-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    margin: 1px 0;
    border-left: 3px solid transparent;
    transition: all var(--journal-transition-speed, 0.25s) cubic-bezier(0.4, 0, 0.2, 1);
  }

  .doc-row:hover {
    background: var(--journal-item-hover, rgba(0, 210, 190, 0.06));
    border-left-color: var(--journal-primary, var(--pri, #00d2be));
  }

  .doc-row.active {
    background: var(--journal-accent, var(--accent, #dc3a68)) !important;
    border-left-color: white;
  }

  .doc-link {
    flex: 1;
    text-decoration: none;
    color: var(--journal-sidebar-text, var(--txt-3, #475569));
    transition: color 0.2s ease;
  }

  .doc-row.active .doc-link {
    color: #ffffff !important;
  }

  .doc-title {
    font-size: 14px;
    font-weight: 500;
  }

  .doc-meta {
    font-size: 11px;
    opacity: 0.6;
    margin-top: 2px;
    display: block;
    color: var(--journal-sidebar-text, var(--txt-3, #475569));
  }

  .doc-row.active .doc-meta {
    color: rgba(255, 255, 255, 0.8);
  }

  .doc-row.active .doc-title {
    font-weight: 600;
  }

  .doc-row.active :global(.action-trigger) {
    color: #ffffff !important;
    opacity: 0.85;
  }

  .doc-row.active :global(.action-trigger:hover) {
    background-color: rgba(255, 255, 255, 0.15) !important;
    opacity: 1;
  }
</style>
