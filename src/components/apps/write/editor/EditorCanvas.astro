---
/**
 * src/components/apps/write/editor/EditorCanvas.astro
 */
import type { Block } from '@/lib/journal/types';
import { blockTag, blockClass } from "@/lib/journal/types";
import "./editorCanvas.css";
import EmptyCanvas from './editorParts/EmptyCanvas.astro';
import NavHint from './editorCanvas/NavHint.astro';

interface Props {
  documentId: string | null;
  title: string;
  blocks: Block[];
  user: any;
}

const { documentId, title, blocks } = Astro.props;
---

<div
  class="editor-canvas"
  id="editor-canvas"
  data-document-id={documentId}
>
  {!documentId ? (
    <EmptyCanvas />
  ) : (
    <div class="editor-inner" id="editor-inner">
      <div
        id="editor-title"
        class="editor-title"
        contenteditable="true"
        role="textbox"
        aria-label="Document title"
        spellcheck="true"
        data-placeholder="Untitled"
      >
        {title}
      </div>

      <div id="editor-blocks" class="editor-block-list">
        {blocks.length === 0 ? (
          <div
            class="editor-block editor-block--paragraph"
            contenteditable="true"
            data-block-id=""
            data-block-type="paragraph"
            data-placeholder="Start writing…"
          />
        ) : (
          blocks.map((block) => {
            const Tag = blockTag(block);
            const isSeparator = block.type === "separator";
            return (
              <Tag
                class={blockClass(block.type)}
                contenteditable={!isSeparator}
                role={!isSeparator ? "textbox" : undefined}
                spellcheck={!isSeparator}
                data-block-id={block.id}
                data-block-type={block.type}
                data-placeholder={block.type === "paragraph" ? "Start writing…" : undefined}
              >
                {!isSeparator && block.content}
              </Tag>
            );
          })
        )}
      </div>
    </div>
  )}
</div>
<NavHint />


<script>
  import { initEditor, disposeEditor } from "./editorCanvas/editorCanvas";
  import { setActiveDocument } from "@/stores/editor";

  function setupCanvasLifecycle() {
    const canvas = document.getElementById("editor-canvas") as HTMLElement | null;
    if (!canvas) return;

    const documentId = canvas.dataset.documentId;
    if (!documentId) return;

    //! 1. Cleanly tear down any active actors running on the previous document framework
    disposeEditor();

    // 2. Parse initial HTML payloads sent by the server template
    const titleEl = document.getElementById("editor-title") as HTMLElement | null;
    const initialTitle = titleEl?.textContent?.trim() || "Untitled";

    const initialBlocks = Array.from(
      document.querySelectorAll<HTMLElement>(".editor-block")
    ).map((el) => ({
      id: el.dataset.blockId || `b_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
      type: (el.dataset.blockType as any) || "paragraph",
      content: el.textContent || "",
    }));

    // 3. Hydrate client state managers
    setActiveDocument(documentId, initialTitle, initialBlocks);

    // 4. Spin up the fresh, debounced XState tracking engine
    initEditor(documentId);
  }

  // Support classic standard initial document loading cascades
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCanvasLifecycle);
  } else {
    setupCanvasLifecycle();
  }

  // Support Astro's client-side SPA view transition routing loop layers
  document.addEventListener("astro:page-load", setupCanvasLifecycle);

  // Clean layout context variables right before navigating away to prevent listener memory drag
  document.addEventListener("astro:before-swap", () => {
    disposeEditor();
  });
</script>