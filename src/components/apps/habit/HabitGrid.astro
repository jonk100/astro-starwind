---
/**
 * @file src/components/apps/habit/HabitGrid.astro
 * @description Monthly habit tracking grid.
 *
 * Renders a table of habits with one column per day in the date range.
 * Each cell is clickable — toggling completion optimistically and syncing
 * to the server via Astro Actions in the background.
 *
 * Delete uses an AlertDialog confirmation before calling actions.habit.delete.
 * Empty state is shown when no habits exist yet.
 */

import type { HabitWithLogs } from '@/lib/habit/types';
import { buildLogMap, generateDateRange } from '@/lib/habit/utils';
import {
  Table, TableBody, TableCell,
  TableHead, TableHeader, TableRow
} from '@/components/starwind/table';
import {
  Dialog,
  DialogTrigger,
  DialogContent,
  DialogHeader,
  DialogFooter,
  DialogTitle,
  DialogDescription,
  DialogClose,
} from '@/components/starwind/dialog';
import { Button } from '@/components/starwind/button';
import HabitCreateForm from './HabitCreateForm.astro';

interface Props {
  habits: HabitWithLogs[];
  from: string;
  to: string;
  currentMonth: Date;
}

const { habits, from, to, currentMonth } = Astro.props;



// Generate the date axis once
const dates = generateDateRange(from, to);
---

{habits.length === 0 ? (
  <!-- ─── Empty State ─────────────────────────────────────────────────────── -->
  <div class="flex flex-col items-center justify-center h-full text-center">
    <div class="mb-4 text-5xl">🌱</div>
    <h2 class="mb-2 text-xl font-semibold text-slate-700">No habits yet</h2>
    <p class="text-sm text-slate-400">
      Add your first habit using the + button below to start tracking your progress.
    </p>
  </div>
) : (
  <!-- ─── Grid ───────────────────────────────────────────────────────────── -->
  <div class="flex flex-col h-full">
    <div class="habit-tracker-container p-4 overflow-x-auto flex-1">
      <Table class="min-w-full border-collapse border border-slate-200">
        <TableHeader>
          <TableRow class="bg-slate-50">
            <TableHead class="p-4 text-left border-b border-slate-200 min-w-[220px]">
              Habit
            </TableHead>
            {dates.map(date => (
              <TableHead class="p-2 text-center border-b border-l border-slate-200 text-xs">
                {date.split('-')[2]}
              </TableHead>
            ))}
          </TableRow>
        </TableHeader>
        <TableBody>
          {habits.map(habit => {
            const logMap = buildLogMap(habit.logs);

            return (
              <TableRow class="hover:bg-slate-50 transition-colors">

                <!-- ─── Habit name cell with delete ─────────────────────────── -->
                <TableCell class="p-4 border-b border-slate-200">
                  <div class="flex items-start justify-between gap-2 group">
                    <!-- Delete button — only visible on row hover -->
                    <Dialog>
                      <DialogTrigger asChild>
                        <button
                          class="delete-trigger opacity-0 group-hover:opacity-100 transition-opacity rounded p-1 text-slate-400 hover:text-red-500 hover:bg-red-50"
                          aria-label={`Delete ${habit.name}`}
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="3 6 5 6 21 6" />
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                            <path d="M10 11v6M14 11v6" />
                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                          </svg>
                        </button>
                      </DialogTrigger>
                      <DialogContent>
                        <DialogHeader>
                          <DialogTitle>{`Delete ${habit.name}?`}</DialogTitle>
                          <DialogDescription>
                            <p>This will permanently delete this habit and all its log entries. This action cannot be undone.</p>
                          </DialogDescription>
                        </DialogHeader>
                        <DialogFooter>
                          <DialogClose asChild>
                            <button
                              type="button"
                              class="inline-flex items-center justify-center rounded-md border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors"
                            >
                              Cancel
                            </button>
                          </DialogClose>
                          <button
                            type="button"
                            class="delete-confirm inline-flex items-center justify-center rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white hover:bg-red-700 transition-colors"
                            data-habit-id={habit.id}
                            data-habit-name={habit.name}
                          >
                            Delete habit
                          </button>
                        </DialogFooter>
                      </DialogContent>
                    </Dialog>

                    <div>
                      <span class="font-medium text-slate-700">{habit.name}</span>
                      <div class="text-xs text-slate-400 capitalize">{habit.tracking_type}</div>
                    </div>
                  </div>
                </TableCell>

                <!-- ─── Day cells ───────────────────────────────────────────── -->
                {dates.map(date => {
                  const log = logMap.get(date);
                  const isDone = log !== undefined;

                  return (
                    <TableCell
                      class={`habit-cell p-0 border-b border-l border-slate-200 cursor-pointer ${isDone ? 'is-completed' : ''}`}
                      data-habit-id={habit.id}
                      data-date={date}
                      data-type={habit.tracking_type}
                      data-log-id={log?.id ?? ''}
                    >
                      <div class="cell-trigger h-12 w-full flex items-center justify-center hover:bg-blue-50">
                        <div class="status-indicator h-6 w-6 rounded border-2 border-slate-200 transition-all flex items-center justify-center text-[10px] text-white font-bold">
                          {isDone && habit.tracking_type !== 'boolean' ? log.value : ''}
                        </div>
                      </div>
                    </TableCell>
                  );
                })}
              </TableRow>
            );
          })}
        </TableBody>
      </Table>
    </div>
    <div class="p-4 border-t border-slate-200 flex justify-center">
      <HabitCreateForm />
    </div>
  </div>
)}

<style>
  .habit-cell.is-completed .status-indicator {
    background-color: #3b82f6;
    border-color: #3b82f6;
    transform: scale(1.1);
  }

  .habit-cell:hover .status-indicator {
    border-color: #3b82f6;
  }
</style>

<script>
  import { actions } from 'astro:actions';
  import { toast } from '@/components/starwind/toast';

  // ─── Log Toggle — Optimistic UI ──────────────────────────────────────────────

  /**
   * Handles clicking a habit cell to toggle completion for that day.
   *
   * Uses optimistic UI — the cell updates immediately, and the action
   * runs in the background. If the action fails, the cell reverts and
   * a toast error is shown.
   */
  document.querySelectorAll<HTMLElement>('.habit-cell').forEach(cell => {
    cell.addEventListener('click', async () => {
      const habitId = cell.getAttribute('data-habit-id')!;
      const date = cell.getAttribute('data-date')!;
      const isCompleted = cell.classList.contains('is-completed');

      if (isCompleted) {
        const logId = cell.getAttribute('data-log-id')!;

        // Optimistic: remove immediately
        cell.classList.remove('is-completed');
        const prevLogId = logId;
        cell.setAttribute('data-log-id', '');

        const { error } = await actions.habit.deleteLog({ id: logId });

        if (error) {
          // Rollback
          cell.classList.add('is-completed');
          cell.setAttribute('data-log-id', prevLogId);
          toast.error('Could not remove log', {
            description: 'Please try again.',
          });
        }
      } else {
        // Optimistic: mark done immediately
        cell.classList.add('is-completed');

        const { data, error } = await actions.habit.upsertLog({
          habit_id: habitId,
          entry_date: date,
          value: 1,
        });

        if (error) {
          // Rollback
          cell.classList.remove('is-completed');
          toast.error('Could not save log', {
            description: 'Please try again.',
          });
        } else if (data) {
          // Store the real log id for future delete
          cell.setAttribute('data-log-id', data.id);
        }
      }
    });
  });

  // ─── Habit Delete ─────────────────────────────────────────────────────────────

  /**
   * Handles clicking the confirm button inside the delete AlertDialog.
   *
   * Uses toast.promise() to show loading, success, and error states
   * automatically while the delete action runs, then reloads the page.
   */
  document.querySelectorAll<HTMLElement>('.delete-confirm').forEach(btn => {
    btn.addEventListener('click', async () => {
      const habitId = btn.getAttribute('data-habit-id')!;
      const habitName = btn.getAttribute('data-habit-name')!;

      await toast.promise(
        actions.habit.delete({ id: habitId }),
        {
          loading: { title: 'Deleting...', description: `Removing "${habitName}"` },
          success: { title: 'Habit deleted', description: `"${habitName}" has been removed.` },
          error: { title: 'Could not delete', description: 'Please try again.' },
        }
      );

      // Reload to remove the row from the grid
      window.location.reload();
    });
  });
</script>