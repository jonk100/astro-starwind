---
import { getMonthNames } from "@/lib/habit/utils";
import Tooltip from "@/components/starwind/tooltip/Tooltip.astro";
import TooltipTrigger from "@/components/starwind/tooltip/TooltipTrigger.astro";
import TooltipContent from "@/components/starwind/tooltip/TooltipContent.astro";
import Button from "@/components/starwind/button/Button.astro";

interface Props {
  currentMonth: Date;
}

const { currentMonth } = Astro.props;

const months = getMonthNames();

const monthName = currentMonth.toLocaleDateString("en-US", { month: "long", year: "numeric" });

const prevMonthDate = new Date(currentMonth.getFullYear(), currentMonth.getMonth() - 1, 1);
const nextMonthDate = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1);
const prevMonthParam = `${prevMonthDate.getFullYear()}-${String(prevMonthDate.getMonth() + 1).padStart(2, '0')}`;
const nextMonthParam = `${nextMonthDate.getFullYear()}-${String(nextMonthDate.getMonth() + 1).padStart(2, '0')}`;
const nextMonthName = nextMonthDate.toLocaleDateString("en-US", { month: "long" });
const prevMonthName = prevMonthDate.toLocaleDateString("en-US", { month: "long" });
---
<div class="flex items-center gap-3.5">
  <Tooltip>
      <TooltipTrigger>
        <a
          href={`?month=${prevMonthParam}`}
          class="flex items-center justify-center size-12 rounded-full border border-slate-200 text-slate-500 hover:text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-all cursor-pointer outline-none shadow-sm"
          aria-label="Previous month"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
      </TooltipTrigger>
    <TooltipContent>
      {prevMonthName}
    </TooltipContent>
  </Tooltip>
  <!-- Month Title (Vertical centered with arrows) -->
  <h1>{monthName}</h1>

  <!-- Next month button -->
  <Tooltip>
    <TooltipTrigger>
      <a
        href={`?month=${nextMonthParam}`}
        class="flex relative items-center justify-center size-12 rounded-full border border-slate-200 text-slate-500 hover:text-slate-700 hover:bg-slate-50 hover:border-slate-300 transition-all cursor-pointer outline-none shadow-sm"
        aria-label="Next month"
      >  
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </TooltipTrigger>
    <TooltipContent side="right">
      {nextMonthName}
    </TooltipContent>
  </Tooltip>
</div>

<style>
  h1,
  a {
    font-size: var(--fsxxxl);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;
    color: var(--accent-bg);
  }

  .month-navigation {
    font-size: var(--fs-xs);
    font-weight: 500;
    background-color: var(--accent-bg);
  }

  .starwind-tooltip-content {
    background-color: var(--card-bg);
    color: var(--accent-text);
  }
</style>