---
import Button from '@/components/starwind/button/Button.astro';
import { Tooltip, TooltipTrigger, TooltipContent } from '@/components/starwind/tooltip';
---
<Tooltip>
  <TooltipTrigger asChild>
    <Button 
      variant="outline"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="black" stroke="black" stroke-width="4">
        <line x1="12" y1="5" x2="12" y2="19" />
        <line x1="5" y1="12" x2="19" y2="12" />
      </svg>
    </Button>
  </TooltipTrigger>
  <TooltipContent>
    Add habit
  </TooltipContent>
</Tooltip>