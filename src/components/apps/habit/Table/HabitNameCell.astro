---
import DeleteHabit from './DeleteHabit.astro';
import { TableCell } from '@/components/starwind/table';
import type { HabitWithLogs } from '@/lib/habit/types';

interface Props {
  habit: HabitWithLogs;
}

const { habit } = Astro.props;
---
<TableCell class="p-4 border-b border-slate-200">
  <div class="flex items-start justify-between gap-2 group">
    <div>
      <span class="font-medium text-slate-700 text-align-left">{habit.name}</span>
      <div class="text-xs text-slate-400 capitalize">{habit.tracking_type}</div>
    </div>
    <DeleteHabit habit={habit} />
  </div>
</TableCell>