---
/**
 * @file src/components/apps/habit/Table/HabitNameCell.astro
 * @description Premium Habit name cell displaying tracking type badge, contextual dropdown actions,
 * and a premium slide-out analytics dashboard, resolving overlay locking freezes.
 */

import { TableCell } from '@/components/starwind/table';
import { Badge } from '@/components/starwind/badge';
import {
  Dropdown,
  DropdownTrigger,
  DropdownContent,
  DropdownItem,
  DropdownSeparator,
} from '@/components/starwind/dropdown';
import {
  Dialog,
  DialogTrigger,
  DialogContent,
  DialogHeader,
  DialogFooter,
  DialogTitle,
  DialogDescription,
  DialogClose,
} from '@/components/starwind/dialog';
import {
  Sheet,
  SheetTrigger,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetDescription,
} from '@/components/starwind/sheet';
import {
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
} from '@/components/starwind/card';
import type { HabitWithLogs } from '@/lib/habit/types';
import { getHabitTheme } from '@/lib/habit/theme';
import { calculateStreak, generateDateRange, currentMonth as currentMonthRange } from '@/lib/habit/utils';
import HabitEditForm from '../HabitEditForm.astro';

interface Props {
  habit: HabitWithLogs;
}

const { habit } = Astro.props;

// Determine badge details based on tracking type
let badgeText = "Yes/No";
let badgeVariant: "info" | "success" | "warning" = "info";

if (habit.tracking_type === "count") {
  badgeText = "Count";
  badgeVariant = "success";
} else if (habit.tracking_type === "duration") {
  badgeText = "Duration";
  badgeVariant = "warning";
}

// Get the visual theme color for dynamic left-border/accent decoration
const theme = getHabitTheme(habit.id, habit.metadata);

// Calculate premium dynamic stats
const completedDates = habit.logs?.map(log => log.entry_date) ?? [];
const stats = calculateStreak(completedDates);

const { from, to } = currentMonthRange();
const datesInMonth = generateDateRange(from, to);
const completionRate = datesInMonth.length > 0 ? Math.round((completedDates.length / datesInMonth.length) * 100) : 0;
---

<TableCell class="habit-name-cell p-4 border-b border-slate-200 text-left relative group min-w-[260px] w-[260px] max-w-[260px] sticky left-0 bg-white z-10 shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">
  <!-- Left accent bar indicating habit theme color -->
  <div 
    class="absolute left-0 top-2 bottom-2 w-1.5 rounded-r transition-all duration-350"
    style={`background-color: rgb(${theme.primaryColor});`}
  ></div>

  <!-- Hidden Edit Sheet Trigger outside Dropdown to prevent Focus-Trap Lockup -->
  <HabitEditForm habit={habit}>
    <button id={`edit-trigger-${habit.id}`} class="hidden" aria-hidden="true"></button>
  </HabitEditForm>

  <!-- Hidden Delete Dialog Trigger outside Dropdown to prevent Focus-Trap Lockup -->
  <Dialog>
    <DialogTrigger asChild>
      <button id={`delete-trigger-${habit.id}`} class="hidden" aria-hidden="true"></button>
    </DialogTrigger>
    
    <!-- Delete Confirmation Dialog Content -->
    <DialogContent class="bg-white border border-slate-200 p-6 rounded-xl shadow-2xl max-w-md w-full">
      <DialogHeader class="mb-4">
        <DialogTitle class="text-lg font-bold text-slate-800 flex items-center gap-2">
          <span class="text-red-500">⚠️</span> Delete "{habit.name}"?
        </DialogTitle>
        <DialogDescription class="text-sm text-slate-500 mt-2 leading-relaxed">
          This will permanently delete this habit and all its log entries for this month and all past history. This action cannot be undone.
        </DialogDescription>
      </DialogHeader>
      <DialogFooter class="flex justify-end gap-3 border-t border-slate-100 pt-4 mt-6">
        <DialogClose asChild>
          <button
            type="button"
            class="inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-slate-50 cursor-pointer transition-all outline-none"
          >
            Cancel
          </button>
        </DialogClose>
        <button
          type="button"
          class="delete-confirm inline-flex items-center justify-center rounded-lg bg-red-600 px-4 py-2.5 text-xs font-bold text-white hover:bg-red-700 cursor-pointer transition-all outline-none"
          data-habit-id={habit.id}
          data-habit-name={habit.name}
        >
          Delete habit
        </button>
      </DialogFooter>
    </DialogContent>
  </Dialog>

  <div class="flex items-center justify-between gap-4 ml-2 w-full text-left">

    <!-- Interactive Name Trigger for Analytics Sheet -->
    <Sheet>
      <SheetTrigger asChild>
        <div 
          role="button"
          tabindex="0"
          class="flex flex-col gap-1.5 text-left items-start w-full flex-1 cursor-pointer outline-none hover:opacity-85 transition-opacity group-hover/cell:translate-x-0.5 duration-200"
          aria-label={`View analytics for ${habit.name}`}
        >
          <span class="font-semibold text-slate-700 leading-snug tracking-tight text-left">
            {habit.name}
          </span>
          <div class="flex items-center gap-1.5">
            <Badge variant={badgeVariant} size="sm" class="font-bold uppercase tracking-wider text-[9px] px-2 py-0">
              {badgeText}
            </Badge>
          </div>
        </div>
      </SheetTrigger>

      <!-- Premium Slide-out Analytics Dashboard -->
      <SheetContent side="right" class="max-w-md w-full bg-slate-50 border-l border-slate-200 overflow-y-auto">
        <SheetHeader class="px-6 pt-6 pb-4 bg-white border-b border-slate-200">
          <div class="flex items-center gap-2 mb-2">
            <span class="size-3.5 rounded-full" style={`background-color: rgb(${theme.primaryColor}); shadow: 0 0 8px rgb(${theme.primaryColor});`}></span>
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400">Habit Insights</span>
          </div>
          <SheetTitle class="text-xl font-bold text-slate-800">{habit.name}</SheetTitle>
          <SheetDescription class="text-xs text-slate-400 mt-1 capitalize">
            {habit.tracking_type} Tracking & Streak Metrics
          </SheetDescription>
        </SheetHeader>

        <div class="p-6 flex flex-col gap-5">
          <!-- Main Grid of Stats -->
          <div class="grid grid-cols-2 gap-4">
            <!-- Card 1: Current Streak -->
            <Card class="bg-white border border-slate-200 shadow-sm rounded-xl transition-all hover:shadow-md hover:border-slate-300">
              <CardHeader class="p-4 pb-1">
                <CardDescription class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Current Streak</CardDescription>
              </CardHeader>
              <CardContent class="p-4 pt-1 flex items-baseline gap-1">
                <span class="text-3xl font-extrabold text-orange-500">{stats.current}</span>
                <span class="text-xs font-semibold text-slate-400">days</span>
              </CardContent>
            </Card>

            <!-- Card 2: Longest Streak -->
            <Card class="bg-white border border-slate-200 shadow-sm rounded-xl transition-all hover:shadow-md hover:border-slate-300">
              <CardHeader class="p-4 pb-1">
                <CardDescription class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Longest Streak</CardDescription>
              </CardHeader>
              <CardContent class="p-4 pt-1 flex items-baseline gap-1">
                <span class="text-3xl font-extrabold text-violet-500">{stats.longest}</span>
                <span class="text-xs font-semibold text-slate-400">days</span>
              </CardContent>
            </Card>

            <!-- Card 3: Total Completions -->
            <Card class="bg-white border border-slate-200 shadow-sm rounded-xl transition-all hover:shadow-md hover:border-slate-300 col-span-2">
              <CardHeader class="p-4 pb-1">
                <CardDescription class="text-[10px] font-bold uppercase tracking-wider text-slate-400">Total Logs</CardDescription>
              </CardHeader>
              <CardContent class="p-4 pt-1 flex items-baseline justify-between">
                <div>
                  <span class="text-3xl font-extrabold text-slate-800">{stats.total}</span>
                  <span class="text-xs font-semibold text-slate-400 ml-1">completions achieved</span>
                </div>
                <div class="text-3xl">🎉</div>
              </CardContent>
            </Card>
          </div>

          <!-- Month Consistency card -->
          <Card class="bg-white border border-slate-200 shadow-sm rounded-xl p-4 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="text-xs font-bold text-slate-700 uppercase tracking-wider">Consistency Rate</h4>
                <p class="text-[10px] text-slate-400 mt-0.5">Frequency this month</p>
              </div>
              <span class="text-lg font-extrabold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">{completionRate}%</span>
            </div>
            
            <!-- Progress Bar -->
            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden shadow-inner">
              <div 
                class="h-full bg-emerald-500 rounded-full transition-all duration-500" 
                style={`width: ${completionRate}%;`}
              ></div>
            </div>
          </Card>

          <!-- Dynamic Tips based on stats -->
          <div class="bg-white border border-slate-200 rounded-xl p-4 text-xs leading-relaxed text-slate-500 shadow-inner border-l-4" style={`border-left-color: rgb(${theme.primaryColor});`}>
            <strong class="text-slate-700 block mb-1">💡 Coaching Tip</strong>
            {stats.current >= 5 ? (
              <span>Your momentum is incredible! Keep walking the path one day at a time to lock in neuroplastic loops. You're building a baseline of consistency.</span>
            ) : (
              <span>Consistency is born in the micro-wins. Try setting a specific daily trigger (e.g. "Right after I pour my coffee...") to anchor this habit to your routine.</span>
            )}
          </div>
        </div>
      </SheetContent>
    </Sheet>

    <!-- Sleek dropdown triggers decoupled triggers smoothly on selection -->
    <Dropdown>
      <DropdownTrigger asChild>
        <button
          class="flex items-center justify-center size-8 rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-100 border border-transparent hover:border-slate-200 transition-all cursor-pointer outline-none"
          aria-label="Habit options"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <circle cx="12" cy="12" r="1" />
            <circle cx="12" cy="5" r="1" />
            <circle cx="12" cy="19" r="1" />
          </svg>
        </button>
      </DropdownTrigger>

      <DropdownContent align="end" class="min-w-[160px] bg-white border border-slate-200 rounded-lg shadow-lg p-1">
        <DropdownItem class="edit-menu-item flex items-center gap-2 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 rounded-md cursor-pointer transition-colors outline-none" data-habit-id={habit.id}>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
          </svg>
          Edit Habit
        </DropdownItem>
        
        <DropdownSeparator class="bg-slate-100 my-1 h-px" />
        
        <DropdownItem class="delete-menu-item flex items-center gap-2 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50 hover:text-red-700 rounded-md cursor-pointer transition-colors outline-none" data-habit-id={habit.id}>
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
          </svg>
          Delete Habit
        </DropdownItem>
      </DropdownContent>
    </Dropdown>
  </div>
</TableCell>

<style>
  .habit-name-cell:has([data-state="open"]) {
    z-index: 100 !important;
  }
</style>

<script>
  import { actions } from 'astro:actions';
  import { toast } from '@/components/starwind/toast';

  // Decoupled click event listeners to safely trigger overlays programmatically
  document.querySelectorAll<HTMLElement>('.edit-menu-item').forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const habitId = item.getAttribute('data-habit-id')!;
      document.getElementById(`edit-trigger-${habitId}`)?.click();
    });
  });

  document.querySelectorAll<HTMLElement>('.delete-menu-item').forEach(item => {
    item.addEventListener('click', (e) => {
      e.preventDefault();
      const habitId = item.getAttribute('data-habit-id')!;
      document.getElementById(`delete-trigger-${habitId}`)?.click();
    });
  });

  // Wires up the confirm action inside the confirmation Dialog
  document.querySelectorAll<HTMLElement>('.delete-confirm').forEach(btn => {
    btn.addEventListener('click', async () => {
      const habitId = btn.getAttribute('data-habit-id')!;
      const habitName = btn.getAttribute('data-habit-name')!;

      await toast.promise(
        actions.habit.delete({ id: habitId }),
        {
          loading: { title: 'Deleting...', description: `Removing "${habitName}"` },
          success: { title: 'Habit deleted', description: `"${habitName}" has been removed.` },
          error: { title: 'Could not delete', description: 'Please try again.' },
        }
      );

      // Reload to remove the row from the grid
      window.location.reload();
    });
  });
</script>