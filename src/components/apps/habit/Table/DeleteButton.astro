---
import { Tooltip, TooltipTrigger, TooltipContent } from '@/components/starwind/tooltip';
import Button from '@/components/starwind/button/Button.astro';
import type { Habit } from '@/lib/habit/types';

interface Props {
  habit: Habit;
}

const { habit } = Astro.props;
---
<Tooltip>
  <TooltipTrigger asChild>
    <Button
      variant="outline"
      class="delete-trigger opacity-50 group-hover:opacity-100 transition-opacity rounded p-1 text-slate-400 hover:text-red-500 hover:bg-red-50"
      aria-label={`Delete ${habit.name}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="3 6 5 6 21 6" />
        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
        <path d="M10 11v6M14 11v6" />
        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
      </svg>
    </Button>
  </TooltipTrigger>
    <TooltipContent>
    Delete Habit
  </TooltipContent>
</Tooltip>