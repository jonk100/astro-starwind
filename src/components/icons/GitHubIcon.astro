---
import Icon from '../ui/icon/Icon.astro';
import GitHub from '!svg/github.svg';

interface Props {
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  px?: number;
  color?: string;
  label?: string;
  class?: string;
  style?: string;
}

const SIZE_MAP: Record<NonNullable<Props["size"]>, number> = {
  xs: 12,
  sm: 16,
  md: 20,
  lg: 24,
  xl: 32,
};

const {
  size = "md",
  px,
  color = "currentColor",
  label = "github",
  style,
  class: className,
} = Astro.props;

const resolvedSize = px ?? SIZE_MAP[size];
---

<Icon
  size={size}
  color={color}
  label={label}
  style={style}
  class={className}
>
  <GitHub width={resolvedSize} height={resolvedSize} />
</Icon>