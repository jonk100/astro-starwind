---
import type { Habit, HabitLog } from './db.types';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/starwind/table';

interface Props {
  habits: Habit[];
  logs: HabitLog[];
  currentMonth: Date;
}

const { habits, logs, currentMonth } = Astro.props;

const days = Array.from({ length: 30 }, (_, i) => i + 1);
const year = currentMonth.getFullYear();
const month = (currentMonth.getMonth() + 1).toString().padStart(2, '0');


const getLog = (habitId: string, dateStr: string) => {
  return logs.find((log) => log.habit_id === habitId && log.entry_date === dateStr);
};


