---
import { Cluster, Stack } from "../layout";
import { Button } from "@/components/starwind/button";
---

<section
  class="
		flex
		flex-col
		bg-background
		py-16
    border-t
    border-border
  "
>
  <Stack
    class="
      items-center
			m-auto
      px-6
      text-center
    "
    gap="md"
  >
    <h2
      class="
        mb-2
        text-4xl
        font-serif
        font-semibold
        leading-tight
        text-foreground
      "
    >
      Need Immediate Support?
    </h2>

    <p
      class="
        mx-auto
        mb-8
        max-w-xl
        text-lg
        leading-relaxed
        text-muted-foreground
        font-sans
      "
    >
      If you're in crisis, feeling overwhelmed, or need urgent emotional support, please reach out. Safe, compassionate, and entirely confidential help is available 24/7.
    </p>

    <Cluster
      class="
        flex-wrap
        justify-center
        gap-4
      "
    >
      <Button
        href="tel:988"
        size="lg"
        variant="primary"
        class="font-sans px-8 py-3"
      >
        Call 988 (Suicide & Crisis Lifeline)
      </Button>

      <Button
        href="https://www.crisistextline.org"
        target="_blank"
        rel="noopener noreferrer"
        size="lg"
        variant="secondary"
        class="font-sans px-8 py-3 border border-border"
      >
        Text HOME to 741741
      </Button>
    </Cluster>
  </Stack>
</section>