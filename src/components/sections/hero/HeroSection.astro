---
import HeroText from './hero-text.astro';
import HeroImage from './hero-image.astro';
import HeroAction from './hero-action.astro';
import type { HTMLAttributes } from 'astro/types';
import { Center } from '@/components/layout';

/** A button action with an optional link destination. */
interface ActionButton {
  type: 'button';
  text: string;
  href?: string;
}

/** A search/select action with a list of menu items. */
interface ActionSearch {
  type: 'search';
  placeholder: string;
  name: string;
  menuItems: string[];
}

/** A plain anchor link action. */
interface ActionLink {
  type: 'link';
  text: string;
  href: string;
}

/** Union of all supported hero action shapes. */
type HeroActionProps = ActionButton | ActionSearch | ActionLink;

interface Props extends HTMLAttributes<'section'> {
  h: string;
  p: string;
  style?: string;
  class?: string;
  textClass?: string;
  as?: keyof HTMLElementTagNameMap;
  imgSrc?: string;
  imgAlt?: string;
  width?: number;
  height?: number;
  /** Pass the full action object so HeroAction receives all required props. */
  action?: HeroActionProps;
}

const {
  h,
  p,
  style,
  class: className = '',
  textClass = '',
  as: Element = 'section',
  imgSrc,
  imgAlt = '',
  width = 0,
  height = 0,
  action,
} = Astro.props;
---

{imgSrc ? (
  <Element
    class={`${className} relative flex w-full min-h-[90vh] flex-col items-center justify-center overflow-hidden px-4 py-12 hero-section`}
    style={style}
  >
    <HeroImage src={imgSrc} alt={imgAlt} width={width} height={height} />
    <div
      class="hero-gradient"
      aria-hidden="true"
    />
    <div
      class="
        pointer-events-none
        absolute
        inset-0
        z-2
        bg-linear-to-b
        from-black/10
        via-black/30
        to-black/10
      "
      aria-hidden="true"
    />
    <HeroText
      h={h}
      p={p}
      class={`relative z-10 w-3/4 max-w-3xl ${textClass}`}
      tone="onImage"
    />
    {action && <HeroAction {...action} />}
  </Element>
) : (
  <Center axis="y" class="h-[90vh] w-full">
    <Element class={`${className} mx-auto section-container`} style={style}>
      <HeroText h={h} p={p} class={textClass} large />
      {action && <HeroAction {...action} />}
    </Element>
  </Center>
)}

<style>

  .hero-gradient {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    background-size: 200% 200%;

    inset: -10%;
    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(120, 119, 255, 0.10),
        transparent 65%
      ),
      radial-gradient(
        circle at 80% 30%,
        rgba(255, 120, 180, 0.08),
        transparent 80%
      ),
      radial-gradient(
        circle at 50% 80%,
        rgba(255, 200, 120, 0.08),
        transparent 90%
      );
    
    filter: blur(60px);
    mix-blend-mode: multiply;
    opacity: .1;
    color: var(--color-text);
    will-change: transform, opacity;
    animation: heroGradientFloat 24s ease-in-out infinite alternate;
  }

  .hero-section::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.03;

    background-image:
      radial-gradient(rgba(0,0,0,.4) 0.5px, transparent 0.5px);

    background-size: 4px 4px;
  }
  :global(html.dark) .hero-gradient {
    inset: -30%;
    background:
      radial-gradient(
        circle at 20% 20%,
        rgba(var(--neutral-5), 0.15),
        transparent 35%
      ),
      radial-gradient(
        circle at 80% 30%,
        rgba(var(--neutral-4), 0.1),
        transparent 40%
      ),
      radial-gradient(
        circle at 50% 80%,
        var(--border),
        transparent 50%
      );
    filter: blur(100px);
    opacity: 0.85;
    will-change: transform, opacity;
    animation: heroGradientFloat 24s ease-in-out infinite alternate;
  }

  @keyframes heroGradientFloat {
    0% {
      transform: translate3d(0%, 0%, 0) scale(1) rotate(0deg);
      opacity: 0.75;
    }
    50% {
      transform: translate3d(-4%, 2%, 0) scale(1.08) rotate(4deg);
      opacity: 0.9;
    }
    100% {
      transform: translate3d(3%, -3%, 0) scale(1.15) rotate(-4deg);
      opacity: 0.8;
    }
  }
</style>