---
import Image from '@/components/starwind/image';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  src: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
}

const { src, alt, width, height, class: className = '' } = Astro.props;
---

<div class:list={['absolute inset-0 z-0 opacity-20', className]}>
  <Image
    src={src}
    alt={alt}
    width={width}
    height={height}
    class="h-full w-full object-cover hero-image"
  />
</div>