---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  h: string;
  p: string;
  class?: string;
  style?: string;
  as?: keyof HTMLElementTagNameMap;
  large?: boolean;
  /** High-contrast text for hero imagery */
  tone?: 'default' | 'onImage';
}

const { h, p, class: className = '', style, as: Element = 'div', large = false, tone = 'default' } = Astro.props;
const onImage = tone === 'onImage';
---

<Element
  class:list={[
    'text-center text-balance m-auto',
    onImage && 'drop-shadow-md',
    className,
  ]}
  style={style}
>
  <h1
    class:list={[
      'font-serif tracking-wide',
      onImage ? 'text-4xl font-semibold text-white sm:text-5xl md:text-6xl py-4' 
      : large ? 'text-5xl font-semibold py-8 px-0 text-foreground' 
      : 'text-3xl lh-1.2 py-4 text-foreground',
    ]}
  >
    {h}
  </h1>
  <hr class="border-border/30" />
  <p
    class:list={[
      'font-sans leading-relaxed text-balance',
      onImage ? 'hero-text--paragraph text-white/90 sm:text-lg md:text-xl' 
      : large ? 'hero-text--paragraph-large text-muted-foreground max-w-2xl mx-auto' 
      : 'hero-text-paragraph text-muted-foreground max-w-xl mx-auto',
    ]}
    style="padding: 0; margin: 2rem auto;"
  >
    {p}
  </p>
</Element>

<style>
  .hero-text--paragraph {
    color: var(--color-foreground);
    font-size: var(--fsxl);
    line-height: var(--lh-tight);
    
  }
  hr {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    max-width: 420px;
    border-bottom: 2px solid var(--color-foreground);
    margin-left: auto;
    margin-right: auto;
  }
  h1 {
    animation: somaticFadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  p {
    animation: somaticFadeUp 1.0s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  
  @keyframes somaticFadeUp {
    from {
      transform: translateY(12px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .hero-divider {
  position: relative;
  width: min(420px, 100%);
  height: 24px;
  margin: 1.5rem auto;
}

.hero-divider::before,
.hero-divider::after {
  content: '';
  position: absolute;
  left: 0;
  width: 100%;
  height: 2px;
  background: var(--color-foreground);

  transition:
    transform 0.6s ease,
    opacity 0.6s ease;
  }

  .hero-divider::before {
    top: 6px;

    animation: dividerTop 5s ease-in-out infinite alternate;
  }

  .hero-divider::after {
    bottom: 6px;
    opacity: 0.35;

    animation: dividerBottom 5s ease-in-out infinite alternate;
  }

  @keyframes dividerTop {
    0% {
      transform: scaleX(1);
      opacity: 1;
    }

    100% {
      transform: scaleX(0.92);
      opacity: 0.35;
    }
  }

  @keyframes dividerBottom {
    0% {
      transform: scaleX(0.92);
      opacity: 0.35;
    }

    100% {
      transform: scaleX(1);
      opacity: 1;
    }
  }
</style>
