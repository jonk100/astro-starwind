---
import FeatureCard from './FeatureCard.astro';
import { ScrollReveal } from '@/components/layout';
import type { Feature } from '@/data/types/features.types';
import SectionHeader from '../shared/SectionHeader.astro';
import { type SectionHeaderVariant } from '!design/variants/SectionHeader.variants';

interface Props {
  heading?: string;
  subheading?: string;
  features: readonly Feature[];
  variant?: 'word' | 'action' | 'plea' | 'name';
  headerVariant?: SectionHeaderVariant;
  headingColor?: string;
  subheadingColor?: string;
  class?: string;
}

const { 
  heading = "Three ways to grow", 
  subheading = "Build better habits with our simple, powerful tools", 
  headingColor = "", 
  subheadingColor = "", 
  features, 
  variant = 'word',
  headerVariant = 'section',
  class: className = ''
} = Astro.props;

const transformedFeatures = features.map(feature => ({
  title: feature[variant]?.title ?? '',
  phrase: feature[variant]?.phrase ?? '',
  description: feature.description,
  link: feature.link,
}));

const schemes = ['light', 'dark', 'primary'] as const;
---

<section class={`py-12 ${className}`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <SectionHeader 
      variant={headerVariant}
      headingClass={headingColor}
      subheadingClass={subheadingColor}
      heading={heading}
      subheading={subheading}
    />

    <div class="grid grid-cols-1 md:grid-cols-3 lg:gap-16 md:gap-4 mt-8">
      {transformedFeatures.map((feature, i) => (
        <ScrollReveal key={i}>
          <FeatureCard
            title={feature.title}
            phrase={feature.phrase}
            description={feature.description}
            link={feature.link}
            scheme={schemes[i % schemes.length]}
            class="hover:border-accent min-w-[280px] max-w-[320px] mx-auto"
          />
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
