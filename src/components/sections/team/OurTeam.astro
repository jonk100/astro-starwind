---
interface TeamMember {
	name: string;
	role: string;
	bio: string;
	image?: string;
}

const teamMembers: TeamMember[] = [
	{
		name: "Sarah Chen",
		role: "Founder & CEO",
		bio: "Former therapist turned entrepreneur. Sarah believes mental health should be accessible, joyful, and free from judgment.",
		image: "https://api.dicebear.com/7.x/avataaars/svg?seed=Sarah&backgroundColor=b6e3f4"
	},
	{
		name: "Marcus Johnson",
		role: "Head of Content",
		bio: "Award-winning writer with a passion for making complex topics feel simple and approachable.",
		image: "https://api.dicebear.com/7.x/avataaars/svg?seed=Marcus&backgroundColor=c0aede"
	},
	{
		name: "Elena Rodriguez",
		role: "Lead Designer",
		bio: "Creates beautiful, calming interfaces that make mental health tools feel like a warm embrace.",
		image: "https://api.dicebear.com/7.x/avataaars/svg?seed=Elena&backgroundColor=ffdfbf"
	},
	{
		name: "David Kim",
		role: "Community Manager",
		bio: "Builds bridges between people and resources, ensuring everyone feels seen and supported.",
		image: "https://api.dicebear.com/7.x/avataaars/svg?seed=David&backgroundColor=d1d4f9"
	},
	{
		name: "Aisha Patel",
		role: "Research Director",
		bio: "PhD in psychology with a focus on evidence-based practices that actually work in real life.",
		image: "https://api.dicebear.com/7.x/avataaars/svg?seed=Aisha&backgroundColor=ffd5dc"
	},
	{
		name: "James Wilson",
		role: "Developer",
		bio: "Turns ideas into elegant code, building the tools that make mental health support accessible to all.",
		image: "https://api.dicebear.com/7.x/avataaars/svg?seed=James&backgroundColor=c0aede"
	}
];
---

<section class="team-section">
	<div class="container">
		<h2 class="team-heading">Meet Our Team</h2>
		<p class="team-subheading">The passionate people behind your journey</p>
		<div class="team-grid">
			{teamMembers.map((member) => (
				<div class="team-card">
					<div class="team-image">
						<img src={member.image} alt={member.name} />
					</div>
					<h3 class="team-name">{member.name}</h3>
					<p class="team-role">{member.role}</p>
					<p class="team-bio">{member.bio}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.team-section {
		padding: 4em 0;
		background: linear-gradient(to bottom, var(--purple-5), var(--purple3));
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2em;
	}

	.team-heading {
		font-size: 2.5em;
		text-align: center;
		margin-bottom: 0.5em;
		color: var(--text-primary);
	}

	.team-subheading {
		font-size: 1.25em;
		text-align: center;
		margin-bottom: 3em;
		color: var(--text-secondary);
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2em;
	}

	.team-card {
		background: var(--surface-primary);
		border-radius: 1em;
		padding: 2em;
		text-align: center;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.team-card:hover {
		transform: translateY(-0.5em);
		box-shadow: 0 1em 2em rgba(0, 0, 0, 0.1);
	}

	.team-image {
		width: 120px;
		height: 120px;
		margin: 0 auto 1.5em;
		border-radius: 50%;
		overflow: hidden;
		background: var(--purple-2);
	}

	.team-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.team-name {
		font-size: 1.5em;
		margin-bottom: 0.25em;
		color: var(--text-primary);
	}

	.team-role {
		font-size: 1em;
		color: var(--primary);
		margin-bottom: 1em;
		font-weight: 600;
	}

	.team-bio {
		font-size: 0.9em;
		color: var(--text-secondary);
		line-height: 1.6;
	}
</style>
