---
import { ScrollReveal } from '@/components/layout';
import { Input } from '@/components/starwind/input';
import { Button } from '@/components/starwind/button';

interface Props {
  heading: string;
  subheading?: string;
  buttonText?: string;
  disclaimer?: string;
  imageUrl?: string;
  imageAlt?: string;
  class?: string;
}

const { 
  heading, 
  subheading = 'Receive quiet reflections, mindful practices, and neurological insights straight to your inbox.', 
  buttonText = 'Join Sanctuary',
  disclaimer = 'By joining, you agree to our respectful storage rules. Unsubscribe with a single click at any time.',
  imageUrl,
  imageAlt = 'Newsletter illustration',
  class: className = '' 
} = Astro.props;
---

<section class={`py-16 bg-card border-y border-border ${className}`}>
  <div class="max-w-6xl mx-auto px-6 font-sans">
    <div class={`flex flex-col md:flex-row items-center gap-12 ${imageUrl ? 'md:gap-16' : ''}`}>
      <ScrollReveal axis="x" distance="-20px" class="flex-1 w-full">
        <div class={`${imageUrl ? 'md:text-left text-center' : 'w-full text-center max-w-2xl mx-auto'}`}>
          <h2 class="text-4xl md:text-5xl font-serif font-semibold text-foreground mb-4">
            {heading}
          </h2>
          {subheading && (
            <p class="text-lg text-muted-foreground mb-8 text-balance">
              {subheading}
            </p>
          )}
          
          <form class={`flex flex-col sm:flex-row gap-4 items-stretch ${imageUrl ? '' : 'max-w-md mx-auto'}`}>
            <div class="flex-1">
              <Input 
                id="newsletter-email"
                name="email"
                type="email" 
                placeholder="Enter your email address"
                required
                size="lg"
                class="w-full"
              />
            </div>
            <Button 
              type="submit"
              size="lg"
              variant="primary"
              class="px-8"
            >
              {buttonText}
            </Button>
          </form>
          
          <p class="text-xs text-muted-foreground opacity-80 mt-4 text-balance">
            {disclaimer}
          </p>
        </div>
      </ScrollReveal>
      
      {imageUrl && (
        <ScrollReveal axis="x" distance="20px" class="md:w-1/2">
          <div class="relative rounded-2xl overflow-hidden aspect-video shadow-sm bg-muted">
            <img 
              src={imageUrl} 
              alt={imageAlt}
              class="object-cover w-full h-full"
            />
          </div>
        </ScrollReveal>
      )}
    </div>
  </div>
</section>
