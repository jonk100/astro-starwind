---
import { Grid, ScrollReveal } from '@/components/layout';
import { default as BlogCard } from './blog-card.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[]
  
}

const { posts } = Astro.props;
---

<Grid min="22rem" class="w-full gap-8 mx-auto w-full">
  {posts.map((post) => (
    <ScrollReveal axis="x" distance="-420px">
      <BlogCard post={post} variant="standard" />
    </ScrollReveal>
  ))}
</Grid>