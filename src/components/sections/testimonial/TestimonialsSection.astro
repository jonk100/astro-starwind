---
import TestimonialCard from './TestimonialCard.astro';
import SectionHeader from '../shared/SectionHeader.astro';
import { type SectionHeaderVariant } from '!design/variants/SectionHeader.variants';
import { ScrollReveal } from '@/components/layout';

interface Props {
  heading?: string;
  subheading?: string;
  headingColor?: string;
  subheadingColor?: string;
  headerVariant?: SectionHeaderVariant;
  testimonials: ReadonlyArray<{
    quote: string;
    name: string;
    title: string;
    avatar?: string;
  }>;
  bgClass?: string;
  maxWidth?: string;
  class?: string;
}

const { 
  heading = "Real Stories", 
  subheading = "Stories from our community about their somatic and cognitive renewal journey.", 
  headingColor, 
  subheadingColor, 
  headerVariant = 'section', 
  testimonials, 
  bgClass = '',
  maxWidth = 'max-w-7xl',
  class: className = '' 
} = Astro.props;

const schemes = ['light', 'dark', 'primary'] as const;
---

<!-- 1. Outer container tracks full-bleed background colors -->
<section class={`w-full ${bgClass} ${className}`}>
  {/* 2. Inner container constrains content layouts horizontally */}
  <div class={`mx-auto ${maxWidth} px-4 sm:px-6 lg:px-8 py-10`}>
    <SectionHeader 
      variant={headerVariant}
      headingClass={headingColor}
      subheadingClass={subheadingColor}
      heading={heading}
      subheading={subheading}
    />

    <div class="grid grid-cols-1 md:grid-cols-3 lg:gap-16 md:gap-4 padding">
      {testimonials.map((testimonial, i) => (
        <ScrollReveal>
          <TestimonialCard
            quote={testimonial.quote}
            name={testimonial.name}
            title={testimonial.title}
            avatar={testimonial.avatar}
            scheme={schemes[i % schemes.length]}
            class="min-w-[280px] max-w-[320px]"
          />

        </ScrollReveal>
      ))}
    </div>
  </div>
</section>

<style>
  .scroll-reveal:nth-child(1) {
    transition-delay: 50ms;
  }

  .scroll-reveal:nth-child(2) {
    transition-delay: 150ms;
  }

  .scroll-reveal:nth-child(3) {
    transition-delay: 250ms;
  }
</style>
