---
import { Stack } from '@/components/layout';
import { Button } from '@/components/starwind/button';
import { Accordion, AccordionItem, AccordionTrigger, AccordionContent } from '@/components/starwind/accordion';
import { Image } from '@/components/starwind/image';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const faqs = [
  {
    question: "How do I begin my self-care journey here?",
    answer: "Simply create a private sanctuary account and choose your first supportive micro-habit. Our guided loops will help you establish a calming routine in under two minutes."
  },
  {
    question: "Is my journaling data entirely private and secure?",
    answer: "Absolutely. We hold emotional safety as a core principle. Your reflective journals, habit tracker metrics, and personal moments are fully encrypted and never shared with anyone."
  },
  {
    question: "Can I transition to deeper guides and specialized reflections?",
    answer: "Yes, you can easily access our extensive library of neuroscience-grounded guides and premium cognitive re-framing structures at any time to support your ongoing growth."
  },
  {
    question: "What if I need support or have questions?",
    answer: "Our compassionate support team is ready to guide you. You can reach us via our secure email or support line, and we will happily assist you in finding the right tools."
  },
  {
    question: "Do the reflection and habit tools work offline?",
    answer: "Yes, our interactive islands are designed for offline tranquility. Any journals or habits you record will automatically sync to your secure loop when you are next online."
  },
  {
    question: "Can I export my personal growth journals?",
    answer: "Always. Your words and path belong entirely to you. You can download and export all your journals, prompts, and habit metrics at any time in multiple formats including CSV and JSON."
  }
];
---
<div class:list={["max-w-6xl mx-auto px-4 sm:px-6 lg:px-8", className]}>
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-16 items-start">

    <!-- FAQ Section -->
    <div>
      <h2 class="text-4xl font-serif font-semibold mb-8 text-foreground">
        Frequently Asked Questions
      </h2>

      <Stack gap="md">
        <Accordion type="single" defaultValue="faq-0" class="w-full">
          {faqs.map((faq, i) => (
            <AccordionItem value={`faq-${i}`} class="border-b border-border pb-2">
              <AccordionTrigger class="text-lg font-serif font-semibold text-foreground py-4 hover:text-primary transition-colors">
                {faq.question}
              </AccordionTrigger>
              <AccordionContent class="text-muted-foreground leading-relaxed text-base font-sans pb-4">
                {faq.answer}
              </AccordionContent>
            </AccordionItem>
          ))}
        </Accordion>
      </Stack>

      <div class="mt-10 pt-8 border-t border-border">
        <p class="text-lg text-foreground font-sans mb-4">
          Need personal guidance or have a custom inquiry?
        </p>

        <Button href="/contact" size="lg" variant="primary">
          Reach out to our guides
        </Button>
      </div>
    </div>

    <!-- Contact Section -->
    <aside class="lg:sticky lg:top-24">
      <div class="
        rounded-3xl
        border
        border-border
        bg-card/85
        backdrop-blur-md
        p-8
      ">
        <div class="mb-8">
          <p class="text-xs font-sans font-semibold tracking-[0.2em] uppercase text-muted-foreground mb-3">
            Sanctuary Support
          </p>

          <h2 class="text-3xl font-serif font-semibold text-foreground mb-4">
            Get in touch
          </h2>

          <p class="text-muted-foreground font-sans leading-relaxed text-sm">
            Whether you have questions about our cognitive tools, feedback, or need technical assistance, we are here to support your peace of mind.
          </p>
        </div>

        <Stack gap="lg" class="font-sans">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">
              Email
            </p>

            <a
              href="mailto:hello@remindmatters.com"
              class="text-lg text-foreground font-medium hover:text-primary transition-colors"
            >
              hello@remindmatters.com
            </a>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">
              Phone
            </p>

            <a
              href="tel:+1234567890"
              class="text-lg text-foreground font-medium hover:text-primary transition-colors"
            >
              +1 (234) 567-890
            </a>
          </div>

          <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-2">
              Sanctuary Office
            </p>

            <address class="not-italic text-muted-foreground leading-relaxed text-sm">
              108 Serene Court<br />
              Calming Sage Valley, CA 94022<br />
              United States
            </address>

            <a
              href="https://maps.google.com/?q=108+Serene+Court+Calming+Sage+Valley+CA"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center mt-3 text-sm font-medium text-primary hover:underline"
            >
              Get directions →
            </a>
          </div>
        </Stack>

        <!-- Premium Botanical Illustration (Replaces support placeholder image) -->
        <div class="
          mt-10
          rounded-2xl
          overflow-hidden
          aspect-4/3
          bg-muted
          relative
        ">
          <Image
            src="https://res.cloudinary.com/dikyfam2c/image/upload/v1734536831/flower_gvof2g.webp"
            alt="Botanical flower illustration for calming focus"
            class="object-cover w-full h-full"
            inferSize
          />
        </div>
      </div>
    </aside>

  </div>
</div>
