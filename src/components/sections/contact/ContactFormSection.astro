---
import { Stack, Cluster } from "@/components/layout";
import { Input } from "@/components/starwind/input";
import { Label } from "@/components/starwind/label";
import { Textarea } from "@/components/starwind/textarea";
import { Button } from "@/components/starwind/button";
---

<section
  class="
		flex
		flex-col
		bg-gray-200
		py-16
  "
>
  <Stack
    class="
      items-center
			m-auto
			max-w-4xl
			w-full
			px-4
    "
    gap="lg"
  >
    <h2
      class="
        mb-4
        text-5xl
        font-bold
       	leading-tight
        text-accent
        text-center
      "
    >
      Send Us a Message
    </h2>

    <p
      class="
        mx-auto
        mb-8
        max-w-[37.5rem]
        text-2xl
        leading-relaxed
        text-accent
				font-bold
        text-center
      "
    >
      Fill out the form below and we'll get back to you within 24 hours
    </p>

    <form class="w-full max-w-2xl mx-auto bg-white rounded-lg p-8 shadow-lg">
      <Stack gap="lg">
        <Cluster class="flex-wrap gap-4">
          <div class="flex-1 min-w-[200px] space-y-2">
            <Label for="name" size="lg">Name</Label>
            <Input
              id="name"
              name="name"
              placeholder="Your name"
              size="lg"
              required
            />
          </div>
          <div class="flex-1 min-w-[200px] space-y-2">
            <Label for="email" size="lg">Email</Label>
            <Input
              id="email"
              name="email"
              type="email"
              placeholder="your@email.com"
              size="lg"
              required
            />
          </div>
        </Cluster>

        <div class="space-y-2">
          <Label for="subject" size="lg">Subject</Label>
          <Input
            id="subject"
            name="subject"
            placeholder="How can we help?"
            size="lg"
            required
          />
        </div>

        <div class="space-y-2">
          <Label for="message" size="lg">Message</Label>
          <Textarea
            id="message"
            name="message"
            placeholder="Tell us more about your inquiry..."
            size="lg"
            rows="6"
            required
            class="min-h-[150px]"
          />
        </div>

        <Button
          type="submit"
          size="lg"
          variant="primary"
          class="w-full py-4 text-lg"
        >
          Send Message
        </Button>
      </Stack>
    </form>
  </Stack>
</section>
