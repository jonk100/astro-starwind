---
/**
 * @file src/components/ui/FoldSection.astro
 * @description Reusable, accessible, and premium collapsible fold section 
 * for blog posts (MDX) using details and summary tags.
 */

interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<details class="fold-section group border-2 border-stone-200 dark:border-stone-800 rounded-2xl overflow-hidden my-6 transition-all duration-300">
  <summary class="flex items-center justify-between p-4 font-black text-lg cursor-pointer bg-stone-50 dark:bg-stone-900 hover:bg-stone-100 dark:hover:bg-stone-800 select-none transition-colors duration-200">
    <span>{heading}</span>
    <svg 
      class="w-5 h-5 text-stone-500 group-open:rotate-180 transition-transform duration-300" 
      fill="none" 
      stroke="currentColor" 
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 9l6 6 6-6" />
    </svg>
  </summary>
  <div class="p-6 border-t border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-950 prose dark:prose-invert max-w-none">
    <slot />
  </div>
</details>

<style>
  /* Prevent default browser details marker */
  details summary::-webkit-details-marker {
    display: none;
  }
  details summary {
    list-style: none;
  }
  
  /* Modern premium focus state */
  details summary:focus-visible {
    outline: 2px solid var(--primary-accent);
    outline-offset: -2px;
  }
</style>
