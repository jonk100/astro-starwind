---
import { tv } from "tailwind-variants";
import type { TableOfContentsItem } from "../types";
import { extractTableOfContents } from "../utils";


const {
  content,
  items: providedItems,
  title = "Table of Contents",
  maxDepth = 6,
  showCounts = false,
  sticky = false,
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const tableOfContents = tv({
  base: "",
  variants: {
    variant: {
      default: "",
      minimal: "border-0 shadow-none bg-transparent",
      sidebar: "border-l-4 border-[rgb(var(--accent))]"
    },
    sticky: {
      true: "fixed top-16 right-0 h-[calc(100vh-4rem)] overflow-y-auto",
      false: ""
    }
  }
});

// Extract items from content if not provided
const items = providedItems || (content ? extractTableOfContents(content) : []);

// Filter by max depth
const filteredItems = items.filter((item: TableOfContentsItem) => item.level <= maxDepth);

---

<div class={tableOfContents({ variant, sticky, class: className })} {...rest} data-toc-container>
  {filteredItems.length > 0 ? (
    <div class="p-4 bg-background border-l border-[rgb(var(--accent))] w-64">
      <h3 class="text-lg font-semibold text-[rgb(var(--purple))] mb-4">
        {title}
        {showCounts && (
          <span class="text-sm font-normal text-muted-foreground ml-2">
            ({filteredItems.length} items)
          </span>
        )}
      </h3>
      
      <nav class="space-y-1">
        {filteredItems.map((item: TableOfContentsItem) => (
          <a
            href={`#${item.id}`}
            class={`block py-1 px-2 text-sm rounded transition-colors hover:bg-[rgba(var(--accent),0.1)] hover:text-[rgb(var(--accent))] ${
              item.level === 1 ? "font-semibold" :
              item.level === 2 ? "font-medium pl-4" :
              item.level === 3 ? "pl-8" :
              item.level === 4 ? "pl-12" :
              item.level === 5 ? "pl-16" :
              "pl-20"
            }`}
            data-toc-link
            data-target={item.id}
          >
            {item.title}
          </a>
        ))}
      </nav>
    </div>
  ) : (
    <div class="text-center py-4 text-muted-foreground text-sm">
      No table of contents available
    </div>
  )}
</div>

<script>
  class TableOfContentsHandler {
    private container: HTMLElement;
    private links: HTMLElement[];
    private headings: HTMLElement[] = [];
    private activeClass: string;

    constructor(element: HTMLElement) {
      this.container = element;
      this.links = Array.from(element.querySelectorAll('[data-toc-link]')) as HTMLElement[];
      this.activeClass = '!font-bold !text-[rgb(var(--purple))] !bg-yellow-200';
      this.init();
    }

    private init() {
      // Find all headings
      this.headings = this.links
        .map(link => document.querySelector(`#${link.dataset.target}`) as HTMLElement)
        .filter(Boolean);

      // Update active link on scroll
      const updateActiveLink = () => {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        
        // Find the current heading
        let currentHeading: HTMLElement | null = null;
        for (let i = this.headings.length - 1; i >= 0; i--) {
          const heading = this.headings[i];
          if (heading && heading.offsetTop <= scrollTop + 100) {
            currentHeading = heading;
            break;
          }
        }

        // Update active states
        this.links.forEach(link => {
          const isActive = currentHeading && link.dataset.target === currentHeading.id;
          if (isActive) {
            link.classList.add(...this.activeClass.split(' '));
          } else {
            link.classList.remove(...this.activeClass.split(' '));
          }
        });
      };

      // Smooth scroll for links
      this.links.forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const targetId = link.dataset.target;
          const target = document.querySelector(`#${targetId}`) as HTMLElement;
          
          if (target) {
            const offset = 80; // Account for fixed headers
            const targetPosition = target.offsetTop - offset;
            
            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
          }
        });
      });

      // Initial update and scroll listener
      updateActiveLink();
      window.addEventListener('scroll', updateActiveLink, { passive: true });
    }
  }

  // Initialize all table of contents components
  const setupTableOfContents = () => {
    const elements = document.querySelectorAll('[data-toc-container]');
    elements.forEach((element) => {
      new TableOfContentsHandler(element as HTMLElement);
    });
  };

  setupTableOfContents();
  document.addEventListener('astro:after-swap', setupTableOfContents);
</script>
