---
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle, CardAction } from "@/components/starwind/card";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Image } from "@/components/starwind/image";
import { tv } from "tailwind-variants";
import type { BlogPost, HeroCardStyle } from "../types";
import { formatDate } from "../utils";

interface HeroCardLargeProps {
  post: BlogPost;
  style?: HeroCardStyle;
  href?: string;
  showAuthor?: boolean;
  showReadTime?: boolean;
  class?: string;
}

const {
  post,
  style = "modern",
  href,
  showAuthor = true,
  showReadTime = true,
  class: className,
  ...rest
} = Astro.props;

const heroCardLarge = tv({
  base: "group relative overflow-hidden transition-all duration-700 hover:shadow-3xl",
  variants: {
    style: {
      classic: "bg-card border-border rounded-2xl",
      modern: "bg-gradient-to-br from-[rgb(var(--accent))] via-[rgb(var(--blue))] to-[rgb(var(--purple))] text-white rounded-3xl",
      minimal: "bg-transparent border-0",
      overlay: "relative bg-card rounded-2xl"
    }
  }
});

const CardWrapper = href ? "a" : "div";
const wrapperProps = href ? { href, class: "block" } : { class: "block" };
---

<CardWrapper {...wrapperProps}>
  <div class={heroCardLarge({ style, class: className })} {...rest}>
    {style === "overlay" && post.image && (
      <div class="absolute inset-0 z-0">
        <Image 
          src={post.image} 
          alt={post.title}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent" />
      </div>
    )}
    
    <div class="relative z-10 min-h-[600px] lg:min-h-[700px] p-12 lg:p-20 flex flex-col justify-between">
      <div class="space-y-8">
        {post.tags && post.tags.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {post.tags.slice(0, 4).map((tag: string) => (
              <div class={`inline-block px-3 py-1 text-sm font-medium rounded-lg ${
                style === "modern" 
                  ? "bg-white/20 text-white border border-white/30 backdrop-blur-sm" 
                  : "bg-[rgb(var(--accent))] text-white"
              }`}>
                {tag}
              </div>
            ))}
          </div>
        )}
        
        <CardHeader class="p-0 space-y-6">
          <div class="space-y-2">
            {post.tags && post.tags.includes("featured") && (
              <div class="inline-block px-3 py-1 text-sm font-medium rounded-lg bg-[rgb(var(--accent))] text-white w-fit">
                ⭐ Featured Article
              </div>
            )}
          </div>
          <CardTitle class={`text-4xl lg:text-6xl xl:text-7xl font-bold leading-tight ${
            style === "modern" || style === "overlay" ? "text-white" : ""
          }`}>
            {post.title}
          </CardTitle>
          <CardDescription class={`text-xl lg:text-2xl line-clamp-4 max-w-4xl ${
            style === "modern" || style === "overlay" ? "text-white/90" : ""
          }`}>
            {post.description}
          </CardDescription>
        </CardHeader>
      </div>
      
      <CardFooter class="p-0 flex items-center justify-between mt-12">
        <div class={`text-base ${
          style === "modern" || style === "overlay" ? "text-white/80" : "text-muted-foreground"
        }`}>
          {showAuthor && post.author && (
            <>
              <span class="font-semibold text-lg">{post.author}</span>
              <span class="mx-3">•</span>
            </>
          )}
          {post.date && (
            <span class="text-lg">{formatDate(post.date)}</span>
          )}
          {showReadTime && post.minutesRead && (
            <>
              <span class="mx-3">•</span>
              <span class="text-lg">{post.minutesRead}</span>
            </>
          )}
        </div>
        
        <div class={`px-8 py-4 text-lg font-semibold rounded-lg text-center transition-all ${
          style === "modern" 
            ? "bg-white text-[rgb(var(--accent))] hover:bg-white/90 shadow-lg cursor-pointer" 
            : "bg-[rgb(var(--accent))] text-white hover:bg-[rgb(var(--accent-dark))] cursor-pointer"
        }`}>
          Read Full Article →
        </div>
      </CardFooter>
    </div>
    
    {style === "classic" && post.image && (
      <div class="absolute bottom-0 right-0 w-1/2 h-3/4 opacity-10 transform rotate-12">
        <Image 
          src={post.image} 
          alt={post.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}
    
    {style === "minimal" && post.image && (
      <div class="absolute -right-20 -bottom-20 w-96 h-96 opacity-5">
        <Image 
          src={post.image} 
          alt={post.title}
          class="w-full h-full object-cover"
        />
      </div>
    )}
  </div>
</CardWrapper>
