---
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle, CardAction } from "@/components/starwind/card";
import { Badge } from "@/components/starwind/badge";
import { Button } from "@/components/starwind/button";
import { Image } from "@/components/starwind/image";
import { tv } from "tailwind-variants";
import type { BlogPost, HeroCardStyle } from "../types";
import { formatDate } from "../utils";

interface HeroCardProps {
  post: BlogPost;
  style?: HeroCardStyle;
  href?: string;
  showAuthor?: boolean;
  showReadTime?: boolean;
  class?: string;
}

const {
  post,
  style = "classic",
  href,
  showAuthor = true,
  showReadTime = true,
  class: className,
  ...rest
} = Astro.props;

const heroCard = tv({
  base: "group relative overflow-hidden transition-all duration-500 hover:shadow-2xl",
  variants: {
    style: {
      classic: "bg-card border-border rounded-xl",
      modern: "bg-gradient-to-br from-[rgb(var(--accent))] to-[rgb(var(--accent-dark))] text-white rounded-2xl",
      minimal: "bg-transparent border-0",
      overlay: "relative bg-card rounded-xl"
    }
  }
});

const CardWrapper = href ? "a" : "div";
const wrapperProps = href ? { href, class: "block" } : { class: "block" };
---

<CardWrapper {...wrapperProps}>
  <div class={heroCard({ style, class: className })} {...rest}>
    {style === "overlay" && post.image && (
      <div class="absolute inset-0 z-0">
        <Image 
          src={post.image} 
          alt={post.title}
          weight="1200"
          height="800"
          class="w-full h-full object-cover"

        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent" />
      </div>
    )}
    
    <div class="relative z-10 min-h-[400px] lg:min-h-[500px] p-8 lg:p-12 flex flex-col justify-between">
      <div>
        {post.tags && post.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {post.tags.slice(0, 3).map((tag: string) => (
              <Badge 
                size="md" 
                variant={style === "modern" ? "secondary" : "primary"}
                class={style === "modern" ? "bg-white/20 text-white border-white/30" : ""}
              >
                {tag}
              </Badge>
            ))}
          </div>
        )}
        
        <CardHeader class="p-0 space-y-4">
          <CardTitle class={`text-3xl lg:text-5xl font-bold leading-tight ${
            style === "modern" || style === "overlay" ? "text-white" : ""
          }`}>
            {post.title}
          </CardTitle>
          <CardDescription class={`text-lg lg:text-xl line-clamp-3 ${
            style === "modern" || style === "overlay" ? "text-white/90" : ""
          }`}>
            {post.description}
          </CardDescription>
        </CardHeader>
      </div>
      
      <CardFooter class="p-0 flex items-center justify-between mt-8">
        <div class={`text-sm ${
          style === "modern" || style === "overlay" ? "text-white/80" : "text-muted-foreground"
        }`}>
          {showAuthor && post.author && (
            <>
              <span class="font-medium">{post.author}</span>
              <span class="mx-2">•</span>
            </>
          )}
          {post.date && (
            <span>{formatDate(post.date)}</span>
          )}
          {showReadTime && post.minutesRead && (
            <>
              <span class="mx-2">•</span>
              <span>{post.minutesRead}</span>
            </>
          )}
        </div>
        
        <Button 
          size="lg" 
          variant={style === "modern" ? "secondary" : "default"}
          class={style === "modern" ? "bg-white text-[rgb(var(--accent))] hover:bg-white/90" : ""}
        >
          Read Article →
        </Button>
      </CardFooter>
    </div>
    
    {style === "classic" && post.image && (
      <div class="absolute bottom-0 right-0 w-1/3 h-2/3 opacity-20">
        <Image 
          src={post.image} 
          alt={post.title}
          inferSize
          class="w-full h-full object-cover"
        />
      </div>
    )}
  </div>
</CardWrapper>
