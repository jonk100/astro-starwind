---
import { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from "@/components/starwind/carousel";
import { Card, CardContent } from "@/components/starwind/card";
import { tv } from "tailwind-variants";
import type { BlogPost, RelatedPostsOptions } from "../types";
import { getRelatedPosts } from "../utils";
import VerticalBlogCard from "../BlogCard/VerticalBlogCard.astro";

interface RelatedPostsCarouselProps {
  currentPost: BlogPost;
  allPosts: BlogPost[];
  options?: RelatedPostsOptions;
  showImage?: boolean;
  showTags?: boolean;
  showAuthor?: boolean;
  showReadTime?: boolean;
  autoplay?: boolean;
  showArrows?: boolean;
  slidesPerView?: number;
  class?: string;
}

const {
  currentPost,
  allPosts,
  options = {},
  showImage = true,
  showTags = true,
  showAuthor = true,
  showReadTime = true,
  autoplay = false,
  showArrows = true,
  slidesPerView = 1,
  class: className,
  ...rest
} = Astro.props;

const relatedPostsCarousel = tv({
  base: "w-full",
  variants: {
    slidesPerView: {
      1: "",
      2: "",
      3: ""
    }
  }
});

const relatedPosts = getRelatedPosts(currentPost, allPosts, options);
const carouselOpts = {
  align: "start" as const,
  loop: true,
  ...(autoplay && { autoplay: true })
};
---

<div class={relatedPostsCarousel({ slidesPerView, class: className })} {...rest}>
  {relatedPosts.length > 0 ? (
    <>
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-[rgb(var(--purple))]">Related Posts</h2>
        <p class="text-muted-foreground mt-1">Discover more articles like this one</p>
      </div>
      
      <Carousel 
        opts={carouselOpts}
        class="w-full"
      >
        <CarouselContent class="-ml-2 md:-ml-4">
          {relatedPosts.map((post) => (
            <CarouselItem class={`pl-2 md:pl-4 basis-full ${
              slidesPerView === 2 ? 'md:basis-1/2' : 
              slidesPerView === 3 ? 'md:basis-1/3 lg:basis-1/3' : ''
            }`}>
              <Card class="border-0 shadow-none">
                <CardContent class="p-0">
                  <VerticalBlogCard
                    post={post}
                    variant="compact"
                    size="md"
                    showImage={showImage}
                    showTags={showTags}
                    showAuthor={showAuthor}
                    showReadTime={showReadTime}
                    href={`/blog/${post.slug}`}
                  />
                </CardContent>
              </Card>
            </CarouselItem>
          ))}
        </CarouselContent>
        
        {showArrows && (
          <>
            <CarouselPrevious class="hidden md:flex" />
            <CarouselNext class="hidden md:flex" />
          </>
        )}
      </Carousel>
    </>
  ) : (
    <div class="text-center py-8 text-muted-foreground">
      <p>No related posts found</p>
    </div>
  )}
</div>
