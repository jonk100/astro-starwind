---
import type { CollectionEntry } from 'astro:content';
import { BlogCardCarousel } from '../BlogCarousel';

interface Props {
  recentPosts: CollectionEntry<'blog'>[];
}

const { recentPosts } = Astro.props as Props;
---

<!-- Recent Posts Carousel -->
    {recentPosts.length > 0 && (
      <section class="py-2">
        <h2 class="text-xl font-semibold text-[rgb(var(--purple))]">Recent Articles</h2>
        <BlogCardCarousel 
          posts={recentPosts.map(post => ({ ...post.data, slug: post.id }))}
          autoplay={false}
          showArrows={true}
          slidesPerView={2}
        />
      </section>
    )}