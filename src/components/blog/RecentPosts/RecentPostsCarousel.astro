---
import { BlogCardCarousel } from '../BlogCarousel';
import type { BlogPost } from "../";

interface Props {
  recentPosts: BlogPost[];
}

const { recentPosts } = Astro.props;
---

<!-- Recent Posts Carousel -->
{recentPosts.length > 0 && (
  <section 
    class
    ="
      he-full
      py-2
      my-8
      max-w-5xl
      mx-auto
      bg-color-white
      text-center
    "
  >
    <h2 class
    ="
        text-xl
        font-semibold
        text-[rgb(var(--purple))]
      "
    >
      Recent Articles
    </h2>
    <BlogCardCarousel
      posts={recentPosts}
      slidesPerView={2}
    />
  </section>
)}