---
import type { CollectionEntry } from 'astro:content';
import { BlogCardCarousel } from '../BlogCarousel';
import type { BlogPost, BlogCardVariant } from "../shared/types";

interface Props {
  recentPosts: BlogPost[];

}

const { recentPosts } = Astro.props;
---

<!-- Recent Posts Carousel -->
{recentPosts.length > 0 && (
  <section class="py-2 my-8 max-w-5xl mx-auto bg-color-white">
    <h2 class="text-xl font-semibold text-[rgb(var(--purple))]">Recent Articles</h2>
    <BlogCardCarousel 
      posts={recentPosts.map(post => ({ ...post.data, slug: post.id }))}
      slidesPerView={2}
    />
  </section>
)}