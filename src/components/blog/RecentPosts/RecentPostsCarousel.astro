---
import { BlogCardCarousel } from '../BlogCarousel';
import type { BlogPost } from "../";

interface Props {
  recentPosts: BlogPost[];
}

const { recentPosts } = Astro.props;
---

{recentPosts.length > 0 && (
  <section 
    class="
      h-full
      py-8
      my-12
      max-w-5xl
      mx-auto
      bg-[var(--warm-neutral-tint)]/30
      dark:bg-[var(--warm-neutral-tint)]/10
      border
      border-border
      rounded-3xl
      text-center
      px-4
      sm:px-8
      shadow-xs
    "
  >
    <h2 class="text-3xl font-semibold text-[rgb(var(--purple))] mb-4">
      Recent Articles
    </h2>
    <BlogCardCarousel
      posts={recentPosts}
      slidesPerView={2}
    />
  </section>
)}