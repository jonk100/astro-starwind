---
import { Input } from "@/components/starwind/input";
import { Button } from "@/components/starwind/button";
import { tv } from "tailwind-variants";
import type { BlogPost } from "../types";

interface BlogSearchProps {
  posts: BlogPost[];
  placeholder?: string;
  showFilters?: boolean;
  maxResults?: number;
  showDate?: boolean;
  showAuthor?: boolean;
  showTags?: boolean;
  class?: string;
}

const {
  posts,
  placeholder = "Search articles...",
  showFilters = true,
  maxResults = 14,
  showDate = true,
  showAuthor = true,
  showTags = true,
  class: className,
  ...rest
} = Astro.props;

const blogSearch = tv({
  base: "w-full space-y-2"
});

// Get unique tags and categories for filters
const allTags: string[] = Array.from(new Set(posts.flatMap((post: BlogPost) => post.tags || [])));
const allCategories: string[] = Array.from(new Set(posts.flatMap((post: BlogPost) => post.categories || [])));
const allAuthors: string[] = Array.from(new Set(posts.map((post: BlogPost) => post.author || post.authors).filter(Boolean)));

// Function to get tag colors for filter buttons
const getTagColor = (tag: string) => {
  const tagColors: { [key: string]: string } = {
    'mental health': 'background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; border-color: #3b82f6;',
    'mindfulness': 'background: linear-gradient(135deg, #10b981, #059669); color: white; border-color: #10b981;',
    'stress management': 'background: linear-gradient(135deg, #f59e0b, #ea580c); color: white; border-color: #f59e0b;',
    'anxiety': 'background: linear-gradient(135deg, #ef4444, #ec4899); color: white; border-color: #ef4444;',
    'self-care': 'background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; border-color: #8b5cf6;',
    'educational': 'background: linear-gradient(135deg, #06b6d4, #0891b2); color: white; border-color: #06b6d4;',
    'cognitive': 'background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border-color: #6366f1;',
    'emotional regulation': 'background: linear-gradient(135deg, #ec4899, #db2777); color: white; border-color: #ec4899;',
    'sleep': 'background: linear-gradient(135deg, #3b82f6, #6366f1); color: white; border-color: #3b82f6;',
    'well-being': 'background: linear-gradient(135deg, #14b8a6, #0d9488); color: white; border-color: #14b8a6;'
  };
  
  return tagColors[tag.toLowerCase()] || 'background: linear-gradient(135deg, #6b7280, #4b5563); color: white; border-color: #6b7280;';
};
---

<div 
  class={blogSearch({ class: className })} 
  data-blog-search
  data-posts={JSON.stringify(posts)}
  data-max-results={maxResults}
  data-show-date={showDate}
  data-show-author={showAuthor}
  data-show-tags={showTags}
  {...rest}
>
  <div class="relative bg-pink-300/50 rounded-lg font-black font-xl">
    <Input
      type="search"
      placeholder={placeholder}
      class="pr-20"
      data-blog-search-input
    />
    <div class="absolute right-8 top-1/2 transform -translate-y-1/2">
      <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <button 
      type="button"
      class="absolute right-3 top-1/2 transform -translate-y-1/2 text-muted-foreground hover:text-foreground transition-colors p-1 rounded hover:bg-muted"
      data-blog-search-clear
      title="Clear search"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  {showFilters && (
    <div class="flex flex-wrap gap-1 transition-all duration-500 ease-out justify-center" data-filter-container>
      {allTags.slice(0, 8).map((tag) => (
        <Button
          size="sm"
          variant="outline"
          data-filter-tag={tag}
          class="text-medium font-medium transition-all duration-300 hover:scale-105 transform"
          style={getTagColor(tag)}
        >
          {tag}
        </Button>
      ))}
    </div>
  )}

  <div class="space-y-3" data-search-results>
    <!-- Results will be populated by JavaScript -->
  </div>
</div>

<script>
  interface BlogPost {
    title: string;
    description?: string;
    date: string | Date;
    slug: string;
    author?: string;
    authors?: string;
    image?: string;
    tags?: string[];
    categories?: string[];
    minutesRead?: string;
  }

  interface SearchOptions {
    query?: string;
    tags?: string[];
    categories?: string[];
    author?: string;
    dateRange?: {
      from?: Date;
      to?: Date;
    };
  }

  class BlogSearchHandler {
    private container: HTMLElement;
    private input: HTMLInputElement;
    private resultsContainer: HTMLElement;
    private posts: any[];
    private maxResults: number;
    private showDate: boolean;
    private showAuthor: boolean;
    private showTags: boolean;
    private activeFilters: Set<string>;

    constructor(element: HTMLElement) {
      this.container = element;
      this.input = element.querySelector('[data-blog-search-input]') as HTMLInputElement;
      this.resultsContainer = element.querySelector('[data-search-results]') as HTMLElement;
      this.maxResults = parseInt(element.dataset.maxResults || '14');
      this.showDate = element.dataset.showDate !== 'false';
      this.showAuthor = element.dataset.showAuthor !== 'false';
      this.showTags = element.dataset.showTags !== 'false';
      this.activeFilters = new Set();
      
      // Posts data is passed as a data attribute
      this.posts = JSON.parse(element.dataset.posts || '[]');
      
      this.init();
    }

    private init() {
      // Search on input
      this.input.addEventListener('input', () => this.performSearch());
      
      // Clear on Escape key
      this.input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          this.clearSearch();
        }
      });
      
      // Clear button
      const clearButton = this.container.querySelector('[data-blog-search-clear]');
      if (clearButton) {
        clearButton.addEventListener('click', () => this.clearSearch());
      }
      
      // Filter buttons
      const filterButtons = this.container.querySelectorAll('[data-filter-tag]');
      filterButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const tag = target.dataset.filterTag;
          if (tag) {
            this.toggleFilter(tag, button as HTMLElement);
          }
        });
      });
      
      // Initial search (show no results initially)
      this.renderResults([]);
    }

    private toggleFilter(tag: string, button: HTMLElement) {
      if (this.activeFilters.has(tag)) {
        this.activeFilters.delete(tag);
        button.classList.remove('bg-[rgb(var(--accent))]', 'text-white');
      } else {
        this.activeFilters.add(tag);
        button.classList.add('bg-[rgb(var(--accent))]', 'text-white');
      }
      this.performSearch();
    }

    private clearSearch() {
      this.input.value = '';
      this.activeFilters.clear();
      
      // Clear filter button states
      const filterButtons = this.container.querySelectorAll('[data-filter-tag]');
      filterButtons.forEach(button => {
        button.classList.remove('bg-[rgb(var(--accent))]', 'text-white');
      });
      
      // Show filter container again
      const filterContainer = this.container.querySelector('[data-filter-container]');
      if (filterContainer) {
        filterContainer.classList.remove('opacity-0', 'scale-95', 'translate-y-2');
        filterContainer.classList.add('opacity-100', 'scale-100', 'translate-y-0');
      }
      
      // Clear results
      this.renderResults([]);
    }

    private performSearch() {
      const query = this.input.value.trim();
      
      // If both query and filters are empty, clear results
      if (!query && this.activeFilters.size === 0) {
        this.renderResults([]);
        return;
      }
      
      const options: SearchOptions = {
        query: query || undefined,
        tags: this.activeFilters.size > 0 ? Array.from(this.activeFilters) : undefined
      };
      
      const results = this.searchPosts(this.posts, options);
      this.renderResults(results);
    }

    private searchPosts(posts: BlogPost[], options: SearchOptions): BlogPost[] {
      const { query, tags } = options;
      
      return posts.filter(post => {
        // Text search
        if (query) {
          const searchLower = query.toLowerCase();
          const titleMatch = post.title.toLowerCase().includes(searchLower);
          const descMatch = post.description?.toLowerCase().includes(searchLower);
          const tagMatch = post.tags?.some((tag: string) => tag.toLowerCase().includes(searchLower));
          
          if (!titleMatch && !descMatch && !tagMatch) {
            return false;
          }
        }
        
        // Tag filter
        if (tags && tags.length > 0) {
          const hasTag = tags.some((tag: string) => post.tags?.includes(tag));
          if (!hasTag) return false;
        }
        
        return true;
      }).slice(0, this.maxResults);
    }

    private renderResults(results: BlogPost[]) {
      const filterContainer = this.container.querySelector('[data-filter-container]');
      
      if (results.length === 0) {
        const query = this.input.value.trim();
        const hasFilters = this.activeFilters.size > 0;
        
        // Show filter container when no results
        if (filterContainer) {
          filterContainer.classList.remove('opacity-0', 'scale-95', 'translate-y-2');
          filterContainer.classList.add('opacity-100', 'scale-100', 'translate-y-0');
        }
        
        this.resultsContainer.innerHTML = `
          <div class="text-center py-8 text-muted-foreground">
            <p class="text-lg">
              ${query && hasFilters 
                ? `No articles found matching "${query}" with selected filters` 
                : query 
                ? `No articles found matching "${query}"`
                : hasFilters
                ? 'No articles found with selected filters'
                : ''
              }
            </p>
          </div>
        `;
        return;
      }

      // Animate tags out when results appear
      if (filterContainer) {
        filterContainer.classList.add('opacity-0', 'scale-95', 'translate-y-2');
        filterContainer.classList.remove('opacity-100', 'scale-100', 'translate-y-0');
      }

      this.resultsContainer.innerHTML = results.map(post => this.renderSearchResultCard(post)).join('');
    }

    private renderSearchResultCard(post: BlogPost): string {
      const imageUrl = post.image || '/src/assets/blog-placeholder-1.jpg';
      const author = post.author || 'Anonymous';
      const date = post.date ? new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '';
      const readTime = post.minutesRead || '';
      
      return `
        <a href="/blog/${post.slug}" class="block group">
          <div class="bg-gradient-to-br from-red-400/40 to-pink-300/60 rounded-lg dark:from-gray-950 dark:to-black hover:from-red-400/30 hover:to-pink-300/50 border border-gray-700 dark:border-gray-800 p-4 hover:border-black-800 transition-all duration-300 h-[150px]">
            <div class="flex gap-3">
              <!-- Image -->
              <div class="flex-shrink-0 relative h-[130px] mr-auto overflow-hidden w-auto max-w-[120px]">
                <img src="${imageUrl}" alt="${post.title}" class="h-full w-full object-cover">
              </div>
              
              <!-- Content -->
              <div class="flex-1 min-w-0 ">
                <span class="font-semibold text-md lh-1 line-clamp-1 text-gray-900 dark:text-gray-100 transition-colors leading-tight mb-1">
                  ${post.title}
                </span>
                
                ${post.description ? `
                  <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed mb-0 line-clamp-1">
                    ${post.description}
                  </p>
                ` : ''}
                
                <!-- Meta info & Tags Row -->
                <div class="flex flex-col gap-2 text-sm text-gray-600 dark:text-gray-400">
                  ${this.showAuthor || this.showDate || (this.showTags && post.tags && post.tags.length > 0) ? `
                    <div class="flex items-center gap-2 overflow-hidden">
                      ${this.showAuthor ? `
                        <span class="font-medium">${author}</span>
                        <span class="text-gray-400">•</span>
                      ` : ''}
                      ${this.showDate && date ? `
                        <time datetime="${post.date}">${date}</time>
                        <span class="text-gray-400">•</span>
                      ` : ''}
                      ${this.showTags && post.tags && post.tags.length > 0 ? `
                        ${post.tags.slice(0, 2).map((tag: string) => this.renderColorfulTag(tag)).join('')}
                        ${post.tags.length > 2 ? `
                          <span class="inline-block px-1 py-0.5 text-xs bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400 rounded-full">
                            +${post.tags.length - 2}
                          </span>
                        ` : ''}
                      ` : ''}
                    </div>
                  ` : ''}
                  
                  ${readTime ? `<span class="text-gray-600 dark:text-gray-400">${readTime}</span>` : ''}
                </div>
              </div>
            </div>
          </div>
        </a>
      `;
    }

    private renderColorfulTag(tag: string): string {
      const tagColors: { [key: string]: string } = {
        'mental health': 'bg-gradient-to-r from-blue-100 to-blue-200 text-blue-800 dark:from-blue-900 dark:to-blue-800 dark:text-blue-200',
        'mindfulness': 'bg-gradient-to-r from-green-100 to-green-200 text-green-800 dark:from-green-900 dark:to-green-800 dark:text-green-200',
        'stress management': 'bg-gradient-to-r from-yellow-100 to-orange-200 text-orange-800 dark:from-yellow-900 dark:to-orange-800 dark:text-orange-200',
        'anxiety': 'bg-gradient-to-r from-red-100 to-pink-200 text-red-800 dark:from-red-900 dark:to-pink-800 dark:text-red-200',
        'self-care': 'bg-gradient-to-r from-purple-100 to-purple-200 text-purple-800 dark:from-purple-900 dark:to-purple-800 dark:text-purple-200',
        'educational': 'bg-gradient-to-r from-cyan-100 to-cyan-200 text-cyan-800 dark:from-cyan-900 dark:to-cyan-800 dark:text-cyan-200',
      };
      
      const colorClass = tagColors[tag.toLowerCase()] || 'bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300';
      
      return `
        <span class="inline-block px-1.5 py-0.5 text-xs rounded-full ${colorClass}">
          ${tag}
        </span>
      `;
    }
  }

  // Initialize all blog search components
  const setupBlogSearch = () => {
    const elements = document.querySelectorAll('[data-blog-search]');
    elements.forEach((element) => {
      new BlogSearchHandler(element as HTMLElement);
    });
  };

  // Wait for DOM to be ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBlogSearch);
  } else {
    setupBlogSearch();
  }
  
  document.addEventListener('astro:after-swap', setupBlogSearch);
</script>
