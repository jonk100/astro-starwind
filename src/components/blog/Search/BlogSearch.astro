---
import { Input } from "@/components/starwind/input";
import { Button } from "@/components/starwind/button";
import { Badge } from "@/components/starwind/badge";
import { tv } from "tailwind-variants";
import type { BlogPost, SearchOptions } from "../types";
import { searchPosts, formatDate } from "../utils";

interface BlogSearchProps {
  posts: BlogPost[];
  placeholder?: string;
  showFilters?: boolean;
  maxResults?: number;
  showDate?: boolean;
  showAuthor?: boolean;
  showTags?: boolean;
  class?: string;
}

const {
  posts,
  placeholder = "Search articles...",
  showFilters = true,
  maxResults = 10,
  showDate = true,
  showAuthor = true,
  showTags = true,
  class: className,
  ...rest
} = Astro.props;

const blogSearch = tv({
  base: "w-full space-y-4"
});

// Get unique tags and categories for filters
const allTags = Array.from(new Set(posts.flatMap((post: BlogPost) => post.tags || [])));
const allCategories = Array.from(new Set(posts.flatMap((post: BlogPost) => post.categories || [])));
const allAuthors = Array.from(new Set(posts.map((post: BlogPost) => post.author || post.authors).filter(Boolean)));

// Function to get tag colors for filter buttons
const getTagColor = (tag: string) => {
  const tagColors: { [key: string]: string } = {
    'mental health': 'background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; border-color: #3b82f6;',
    'mindfulness': 'background: linear-gradient(135deg, #10b981, #059669); color: white; border-color: #10b981;',
    'stress management': 'background: linear-gradient(135deg, #f59e0b, #ea580c); color: white; border-color: #f59e0b;',
    'anxiety': 'background: linear-gradient(135deg, #ef4444, #ec4899); color: white; border-color: #ef4444;',
    'self-care': 'background: linear-gradient(135deg, #8b5cf6, #7c3aed); color: white; border-color: #8b5cf6;',
    'educational': 'background: linear-gradient(135deg, #06b6d4, #0891b2); color: white; border-color: #06b6d4;',
    'cognitive': 'background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; border-color: #6366f1;',
    'emotional regulation': 'background: linear-gradient(135deg, #ec4899, #db2777); color: white; border-color: #ec4899;',
    'sleep': 'background: linear-gradient(135deg, #3b82f6, #6366f1); color: white; border-color: #3b82f6;',
    'well-being': 'background: linear-gradient(135deg, #14b8a6, #0d9488); color: white; border-color: #14b8a6;'
  };
  
  return tagColors[tag.toLowerCase()] || 'background: linear-gradient(135deg, #6b7280, #4b5563); color: white; border-color: #6b7280;';
};
---

<div 
  class={blogSearch({ class: className })} 
  data-blog-search
  data-posts={JSON.stringify(posts)}
  data-max-results={maxResults}
  data-show-date={showDate}
  data-show-author={showAuthor}
  data-show-tags={showTags}
  {...rest}
>
  <div class="relative">
    <Input
      type="search"
      placeholder={placeholder}
      class="pr-10"
      data-blog-search-input
    />
    <div class="absolute right-3 top-1/2 transform -translate-y-1/2">
      <svg class="w-4 h-4 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  {showFilters && (
    <div class="flex flex-wrap gap-2">
      {allTags.slice(0, 8).map((tag) => (
        <Button
          size="sm"
          variant="outline"
          data-filter-tag={tag}
          class="text-medium font-medium transition-all duration-200 hover:scale-105"
          style={getTagColor(tag)}
        >
          {tag}
        </Button>
      ))}
    </div>
  )}

  <div class="space-y-3" data-search-results>
    <!-- Results will be populated by JavaScript -->
  </div>
</div>

<script>
  class BlogSearchHandler {
    private container: HTMLElement;
    private input: HTMLInputElement;
    private resultsContainer: HTMLElement;
    private posts: any[];
    private maxResults: number;
    private showDate: boolean;
    private showAuthor: boolean;
    private showTags: boolean;
    private activeFilters: Set<string>;

    constructor(element: HTMLElement) {
      this.container = element;
      this.input = element.querySelector('[data-blog-search-input]') as HTMLInputElement;
      this.resultsContainer = element.querySelector('[data-search-results]') as HTMLElement;
      this.maxResults = parseInt(element.dataset.maxResults || '10');
      this.showDate = element.dataset.showDate !== 'false';
      this.showAuthor = element.dataset.showAuthor !== 'false';
      this.showTags = element.dataset.showTags !== 'false';
      this.activeFilters = new Set();
      
      // Posts data is passed as a data attribute
      this.posts = JSON.parse(element.dataset.posts || '[]');
      
      this.init();
    }

    private init() {
      // Search on input
      this.input.addEventListener('input', () => this.performSearch());
      
      // Filter buttons
      const filterButtons = this.container.querySelectorAll('[data-filter-tag]');
      filterButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          const tag = target.dataset.filterTag;
          if (tag) {
            this.toggleFilter(tag, button as HTMLElement);
          }
        });
      });
      
      // Initial search (show no results initially)
      this.renderResults([]);
    }

    private toggleFilter(tag: string, button: HTMLElement) {
      if (this.activeFilters.has(tag)) {
        this.activeFilters.delete(tag);
        button.classList.remove('bg-[rgb(var(--accent))]', 'text-white');
      } else {
        this.activeFilters.add(tag);
        button.classList.add('bg-[rgb(var(--accent))]', 'text-white');
      }
      this.performSearch();
    }

    private performSearch() {
      const query = this.input.value.trim();
      
      const options: any = {
        query: query || undefined,
        tags: this.activeFilters.size > 0 ? Array.from(this.activeFilters) : undefined
      };
      
      const results = this.searchPosts(this.posts, options);
      this.renderResults(results);
    }

    private searchPosts(posts: any[], options: any): any[] {
      const { query, tags } = options;
      
      return posts.filter(post => {
        // Text search
        if (query) {
          const searchLower = query.toLowerCase();
          const titleMatch = post.title.toLowerCase().includes(searchLower);
          const descMatch = post.description?.toLowerCase().includes(searchLower);
          const tagMatch = post.tags?.some((tag: string) => tag.toLowerCase().includes(searchLower));
          
          if (!titleMatch && !descMatch && !tagMatch) {
            return false;
          }
        }
        
        // Tag filter
        if (tags && tags.length > 0) {
          const hasTag = tags.some((tag: string) => post.tags?.includes(tag));
          if (!hasTag) return false;
        }
        
        return true;
      }).slice(0, this.maxResults);
    }

    private renderResults(results: any[]) {
      if (results.length === 0) {
        this.resultsContainer.innerHTML = `
          <div class="text-center py-8 text-muted-foreground">
            <p class="text-lg">Type to search articles or click tags above to filter</p>
          </div>
        `;
        return;
      }

      this.resultsContainer.innerHTML = results.map(post => `
        <a href="/blog/${post.slug}" class="block p-6 rounded-xl border border-border hover:border-[rgb(var(--accent))] hover:shadow-lg hover:bg-gradient-to-br hover:from-[rgba(var(--accent),0.05)] hover:to-[rgba(var(--accent-dark),0.02)] transition-all duration-300 mb-4">
          <div class="flex items-start gap-4">
            ${post.image ? `
              <img src="${post.image}" alt="${post.title}" class="w-20 h-20 object-cover rounded-lg flex-shrink-0">
            ` : ''}
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-xl hover:text-[rgb(var(--purple))] transition-colors line-clamp-2 mb-2">
                ${post.title}
              </h3>
              
              ${post.description ? `
                <p class="text-muted-foreground text-sm line-clamp-2 mb-3">
                  ${post.description}
                </p>
              ` : ''}
              
              <div class="flex items-center gap-3 text-xs text-muted-foreground mb-3">
                ${this.showAuthor && post.author ? `
                  <span class="font-medium">${post.author}</span>
                  <span class="text-gray-400">•</span>
                ` : ''}
                ${this.showDate && post.date ? `
                  <time datetime="${post.date}" class="text-gray-600">
                    ${new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                  </time>
                ` : ''}
                ${post.minutesRead ? `
                  <span class="text-gray-400">•</span>
                  <span class="text-gray-600">${post.minutesRead}</span>
                ` : ''}
              </div>
              
              ${this.showTags && post.tags && post.tags.length > 0 ? `
                <div class="flex flex-wrap gap-2">
                  ${post.tags.slice(0, 4).map((tag: string) => this.renderColorfulTag(tag)).join('')}
                  ${post.tags.length > 4 ? `
                    <span class="inline-block px-2 py-1 text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 rounded-full">
                      +${post.tags.length - 4}
                    </span>
                  ` : ''}
                </div>
              ` : ''}
            </div>
          </div>
        </a>
      `).join('');
    }

    private renderColorfulTag(tag: string): string {
      const tagColors: { [key: string]: string } = {
        'mental health': 'bg-gradient-to-r from-blue-100 to-blue-200 text-blue-800 dark:from-blue-900 dark:to-blue-800 dark:text-blue-200',
        'mindfulness': 'bg-gradient-to-r from-green-100 to-green-200 text-green-800 dark:from-green-900 dark:to-green-800 dark:text-green-200',
        'stress management': 'bg-gradient-to-r from-yellow-100 to-orange-200 text-orange-800 dark:from-yellow-900 dark:to-orange-800 dark:text-orange-200',
        'anxiety': 'bg-gradient-to-r from-red-100 to-pink-200 text-red-800 dark:from-red-900 dark:to-pink-800 dark:text-red-200',
        'self-care': 'bg-gradient-to-r from-purple-100 to-purple-200 text-purple-800 dark:from-purple-900 dark:to-purple-800 dark:text-purple-200',
        'educational': 'bg-gradient-to-r from-cyan-100 to-cyan-200 text-cyan-800 dark:from-cyan-900 dark:to-cyan-800 dark:text-cyan-200',
        'cognitive': 'bg-gradient-to-r from-indigo-100 to-indigo-200 text-indigo-800 dark:from-indigo-900 dark:to-indigo-800 dark:text-indigo-200',
        'emotional regulation': 'bg-gradient-to-r from-pink-100 to-pink-200 text-pink-800 dark:from-pink-900 dark:to-pink-800 dark:text-pink-200',
        'sleep': 'bg-gradient-to-r from-blue-100 to-indigo-200 text-indigo-800 dark:from-blue-900 dark:to-indigo-800 dark:text-indigo-200',
        'well-being': 'bg-gradient-to-r from-teal-100 to-teal-200 text-teal-800 dark:from-teal-900 dark:to-teal-800 dark:text-teal-200'
      };

      const colorClass = tagColors[tag.toLowerCase()] || 'bg-gradient-to-r from-gray-100 to-gray-200 text-gray-800 dark:from-gray-900 dark:to-gray-800 dark:text-gray-200';
      
      return `
        <a href="/blog/tag/${encodeURIComponent(tag.toLowerCase().replace(/\s+/g, '-'))}" 
           class="inline-block px-3 py-1 text-xs font-medium rounded-full transition-all duration-200 hover:scale-105 hover:shadow-md ${colorClass}"
           onclick="event.stopPropagation()">
          ${tag}
        </a>
      `;
    }
  }

  // Initialize all blog search components
  const setupBlogSearch = () => {
    const elements = document.querySelectorAll('[data-blog-search]');
    elements.forEach((element) => {
      new BlogSearchHandler(element as HTMLElement);
    });
  };

  // Wait for DOM to be ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBlogSearch);
  } else {
    setupBlogSearch();
  }
  
  document.addEventListener('astro:after-swap', setupBlogSearch);
</script>
