---
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from "@/components/starwind/carousel";
import { tv } from "tailwind-variants";
import type { BlogPost, BlogCardVariant } from "../shared/types";
import VerticalBlogCard from "../BlogCard/VerticalBlogCard.astro";

interface Props {
  posts: BlogPost[];
  cardVariant?: BlogCardVariant;
  showImage?: boolean;
  showTags?: boolean;
  showAuthor?: boolean;
  showReadTime?: boolean;
  maxPosts?: number;
  autoplay?: boolean;
  showArrows?: boolean;
  slidesPerView?: number;
  class?: string;
}

const {
  posts,
  cardVariant = "default",
  showImage = true,
  showTags = true,
  showAuthor = true,
  showReadTime = true,
  maxPosts,
  autoplay = false,
  showArrows = true,
  slidesPerView = 1,
  class: className,
} = Astro.props;

/**
 * Tailwind variants for the outer wrapper.
 * The `slidesPerView` variant is kept for potential future styling hooks
 * but does not affect layout directly — that's handled per CarouselItem.
 */
const blogCardCarousel = tv({
  base: "w-full",
  variants: {
    slidesPerView: {
      1: "",
      2: "",
      3: "",
    },
  },
});

/** Slice posts if a maximum is specified, otherwise show all. */
const displayPosts = maxPosts ? posts.slice(0, maxPosts) : posts;

/** Embla carousel options passed to the Starwind Carousel component. */
const carouselOpts = {
  align: "start" as const,
  loop: true,
  ...(autoplay && { autoplay: true }),
};

/**
 * Resolves the CarouselItem basis class based on the number of slides
 * visible at once. Defaults to full-width on mobile in all cases.
 *
 * @param {number} slidesPerView - Number of slides visible simultaneously.
 * @returns {string} Tailwind basis class string.
 */
const getItemBasis = (slidesPerView: 1 | 2 | 3): string => {
  if (slidesPerView === 2) return "basis-full md:basis-1/2";
  if (slidesPerView === 3) return "basis-full md:basis-1/3";
  return "basis-full";
};

const itemBasis = getItemBasis(slidesPerView);
---
<div class={blogCardCarousel({ slidesPerView, class: className })}>
  <div class="relative w-full px-20 rounded-xl">
    <Carousel
      opts={carouselOpts}
      class="w-full rounded-lg bg-white/10 bg-white shadow-[inset_0_16px_32px_rgba(0,0,0,0.40),inset_0_16px_24px_rgba(0,0,0,0.20),inset_0_0_0_4px_rgba(0,0,0,0.08),inset_0_26px_0_0_rgba(0.30,0,0,0)] p-6"
    >
      <CarouselContent class="ml-0">
        {displayPosts.map((post: BlogPost) => (
          <CarouselItem class={`${itemBasis} px-2`}>
            <VerticalBlogCard
              post={post}
              variant={cardVariant}
              size="md"
              showImage={showImage}
              showTags={showTags}
              showAuthor={showAuthor}
              showReadTime={showReadTime}
              href={`/blog/${post.slug}`}
            />
          </CarouselItem>
        ))}
      </CarouselContent>
      {showArrows && <CarouselPrevious class="border-1 bg-blur hidden md:flex size-12 [&>svg]:size-7 [&>svg]:mx-auto bg-primary/80 hover:bg-primary text-primary-foreground hover:text-primary-foreground hover:scale-110 transition-transform duration-200 mx-4 shadow-xl hover:scale-110 hover:shadow-2xl transition-all duration-300" />}
      {showArrows && <CarouselNext class="border-1 bg-blur hidden md:flex size-12 [&>svg]:size-7 [&>svg]:mx-auto bg-primary/80 hover:bg-primary text-primary-foreground hover:text-primary-foreground hover:scale-110 transition-transform duration-200 mx-4 shadow-xl hover:scale-110 hover:shadow-2xl transition-all duration-300" />}
    </Carousel>
  </div>
</div>