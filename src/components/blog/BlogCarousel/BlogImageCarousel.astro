---
import { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from "@/components/starwind/carousel";
import { tv } from "tailwind-variants";
import type { BlogPost } from "../types";
import BlogCardImage from "../BlogCard/BlogCardImage.astro";

interface BlogImageCarouselProps {
  posts: BlogPost[];
  aspectRatio?: "16/9" | "4/3" | "1/1" | "3/2";
  showOverlay?: boolean;
  showTitle?: boolean;
  showBadge?: boolean;
  maxPosts?: number;
  autoplay?: boolean;
  showArrows?: boolean;
  slidesPerView?: number;
  class?: string;
}

const {
  posts,
  aspectRatio = "16/9",
  showOverlay = true,
  showTitle = true,
  showBadge = true,
  maxPosts,
  autoplay = false,
  showArrows = true,
  slidesPerView = 1,
  class: className,
  ...rest
} = Astro.props;

const blogImageCarousel = tv({
  base: "w-full",
  variants: {
    slidesPerView: {
      1: "",
      2: "",
      3: "",
      4: ""
    }
  }
});

const displayPosts = maxPosts ? posts.slice(0, maxPosts) : posts;
const carouselOpts = {
  align: "center" as const,
  loop: true,
  ...(autoplay && { autoplay: true })
};

// Filter posts that have images
const postsWithImages = displayPosts.filter((post: BlogPost) => post.image);
---

<div class={blogImageCarousel({ slidesPerView, class: className })} {...rest}>
  <Carousel 
    opts={carouselOpts}
    class="w-full"
  >
    <CarouselContent class="-ml-1">
      {postsWithImages.map((post: BlogPost) => (
        <CarouselItem class={`pl-1 basis-full ${
          slidesPerView === 2 ? 'md:basis-1/2' : 
          slidesPerView === 3 ? 'md:basis-1/3 lg:basis-1/3' :
          slidesPerView === 4 ? 'md:basis-1/2 lg:basis-1/4' : ''
        }`}>
          <BlogCardImage
            post={post}
            aspectRatio={aspectRatio}
            showOverlay={showOverlay}
            showTitle={showTitle}
            showBadge={showBadge}
            href={`/blog/${post.slug}`}
          />
        </CarouselItem>
      ))}
    </CarouselContent>
    
    {showArrows && (
      <>
        <CarouselPrevious class="hidden md:flex" />
        <CarouselNext class="hidden md:flex" />
      </>
    )}
  </Carousel>
</div>
