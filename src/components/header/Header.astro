---
import HeaderLogo from './HeaderLogo.astro';
import { GitHubIcon } from '../icons';
import Menu from './Menu.astro';
import { ThemeToggle } from "@/components/starwind/theme-toggle";

interface Props {
  user?: {
    email?: string;
    name?: string;
  } | null;
}

const { user } = Astro.props;
---

<header class="bg-transparent border-none shadow-none w-full">
  <HeaderLogo />
  <div class="header-right">
    <Menu user={user} />
    <ThemeToggle size="md" variant="default" aria-label="Toggle site theme" />
    <a href="https://github.com/jonk100/astro-starwind" target="_blank" rel="noopener noreferrer" class="github-nav">
      <span class="sr-only">GitHub</span>
      <GitHubIcon size="md" />
    </a>
  </div>
</header>


<style>
  header {
    display: flex;
    height: 75px;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-8);
    
    box-shadow: none;
    border-bottom: none;
    background-color: rgba(var(--neutral-8),0.9);
    position: sticky;
    border-bottom: 2px solid var(--accent);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  :global(html.dark) header {
    background: rgba(var(--neutral-2),0.9);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .github-nav {
    display: flex;
    align-items: center;
    padding: 0 .5rem;
    color: var(--color-primary-300);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .github-nav:hover {
    color: var(--primary-accent);
    background-color: transparent;
    transform: scale(1.125);
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
  }

  @media (max-width: 768px) {
    header {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }

    .header-right {
      width: 100%;
      justify-content: center;
    }
  }
</style>
