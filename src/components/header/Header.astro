---
import HeaderLogo from './HeaderLogo.astro';
import { GitHubIcon } from '../icons';
import Menu from './Menu.astro';

interface Props {
  user?: {
    email?: string;
    name?: string;
  } | null;
}

const { user } = Astro.props;
---

<header class=" sticky top-0 ">
  <HeaderLogo />
  <div class="header-right">
    <Menu user={user} />
    <a href="https://github.com/jonk100/astro-starwind" target="_blank" rel="noopener noreferrer" class="github-nav">
      <span class="sr-only">GitHub</span>
      <GitHubIcon size="md" />
    </a>
  </div>
</header>


<style>
  header {
    display: flex;
    height: 10%;
    align-items: center;
    justify-content: space-around;
    padding: 1rem 2rem;
    margin: auto;
    background-color: lab(96.34% -12.13 -5.72 / 0.905);
    box-shadow: var(--shadow-sm);
    border-bottom: 1px solid var(--border);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .github-nav {
    display: flex;
    align-items: center;
    padding: 0 .5rem;
    color: var(--color-primary-300);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .github-nav:hover {
    color: var(--primary-accent);
    background-color: transparent;
    transform: scale(1.125);
    animation: pulse 3s ease-in-out infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.125); }
    100% { transform: scale(1); }
  }

  @media (max-width: 768px) {
    header {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
    }

    .header-right {
      width: 100%;
      justify-content: center;
    }
  }
</style>
