---
import { Dropdown, DropdownTrigger, DropdownContent, DropdownItem } from '@/components/starwind/dropdown';
import { Button } from '@/components/starwind/button';
import HeaderLink from './HeaderLink.astro';
import { getBlogPages } from '@/lib/utils';

const dropdownItems = await getBlogPages();
---

<header>
  <nav>
    <!-- <a href="/"><span><Logo /></span></a> -->
    <div class="internal-links">
      <HeaderLink href="/">Home</HeaderLink>
      <Dropdown class="max-w-80vw mx-auto">
        <DropdownTrigger asChild>
          <Button variant="ghost">Blog</Button>
        </DropdownTrigger>
        <DropdownContent align="center" class="rounded-lg flex flex-row gap-4 dropdown-full-width submenu">
          {dropdownItems.map((item) => (
            <DropdownItem as="a" href={item.href} class="flex-1 text-center">
              <span class="submenu-item">{item.label}</span>
            </DropdownItem>
          ))}
        </DropdownContent>
      </Dropdown>
      <HeaderLink href="/about">About</HeaderLink>
      <!-- <HeaderIcons /> -->
    </div>

  </nav>
</header>

<style>
  header {
    margin: 0;
    padding: 0;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-around;
    vertical-align: middle;
  }
    .internal-links {
      display: flex;
      /* width: 50%; */
      justify-content: center;
      margin-left: auto;
      margin-top: auto;
      margin-bottom: auto;
      transition: all 0.2s ease;
  }
  
  .internal-links a,
  .internal-links button {
    font-size: 0.875rem;
    padding: 0.5rem 1rem;
    margin: auto 0;
    color: var(--foreground);
    text-decoration: none;
    transition: all 0.15s ease;
    font-weight: 500;
    border-radius: 0.375rem;
  }
  
  .internal-links a:hover,
  .internal-links button:hover {
    color: var(--primary-accent);
    font-weight: 600;
    scale: 1.125;
  }

  .internal-links button[aria-expanded="true"] {
    color: var(--primary-accent);
    transform: scale(1.125);
    animation: pulse 3s ease-in-out infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.125); }
    100% { transform: scale(1); }
  }

  .dropdown-full-width {
    position: absolute !important;
    margin: 0 auto;
  }
  
  .dropdown-full-width[style*="width"] {
    min-width: 50ch;
  }

  .submenu a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
    margin: 0.25rem 0;
  }

  .submenu a:hover {
    color: var(--primary-accent);
    font-weight: 600;
  }
  
  .submenu-item {
    font-size: 1.25rem;
    align-items: center;
    margin: 0 auto;
  }


@media (max-width: 720px) {
    .social-links {
      display: none;
    }
  }
</style>
