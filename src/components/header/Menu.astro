---
import { Dropdown, DropdownItem, DropdownContent, DropdownTrigger } from "@/components/starwind/dropdown";
import type { HTMLAttributes } from "astro/types";
import UserNav from "./UserNav.astro";

type Props = HTMLAttributes<"div"> & {
  user?: {
    email?: string;
    name?: string;
    class?: string;
  } | null;
}

const { user } = Astro.props;
---
  <Dropdown class="group flex flex-row w-full">
    <a href="/" class="menu-item">Home</a>
    <a href="/about" class="menu-item">About</a>
    <DropdownTrigger class="menu-item">
      Blog
    </DropdownTrigger>
    <DropdownContent class="min-w-48 flex flex-col">
      <DropdownItem class="menu-item">
        <a href="/blog">All Posts</a>
      </DropdownItem>
      <DropdownItem class="menu-item">
        <a href="/blog/categories">Category</a>
      </DropdownItem>
      <DropdownItem class="menu-item">
        <a href="/blog/tags">Tag</a>
      </DropdownItem>
    </DropdownContent>
  </Dropdown>
  <Dropdown class="group flex flex-row w-full">
    <DropdownTrigger class="menu-item">
      Site
    </DropdownTrigger>
    <DropdownContent class="min-w-48 flex flex-col">
      <DropdownItem as="a" href="/" class="menu-item">Home</DropdownItem>
      <DropdownItem as="a" href="/about" class="menu-item" >About</DropdownItem>
      <DropdownItem as="a" href="/contact" class="menu-item">Contact</DropdownItem>
    </DropdownContent>
  </Dropdown>
  <Dropdown class="group flex flex-row w-full">
    <DropdownTrigger class="menu-item">
      Tools
    </DropdownTrigger>
    <DropdownContent class="min-w-48 flex flex-col">
      <DropdownItem as="a" href="/app/habit/track" class="menu-item">Habit Tracker</DropdownItem>
      <DropdownItem as="a" href="/app/write" class="menu-item">Journal</DropdownItem>
      <DropdownItem as="a" href="/app/relax/meditation" class="menu-item">Meditation Guide</DropdownItem>
    </DropdownContent>
  </Dropdown>
  <UserNav server:defer class="menu-item">
    <div slot="fallback" class="menu-item animate-pulse opacity-70 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
        <circle cx="12" cy="7" r="4"></circle>
      </svg>
      <span class="text-sm font-medium">Loading account...</span>
    </div>
  </UserNav>




<style>
  @reference "@/styles/global.css";

  .menu-item, .menu-item * {
    @apply w-full my-auto px-4 text-foreground hover:text-primary-accent font-black;
    font-size: 1.05rem;
  }

  @keyframes pulse-scale {
    0% { transform: scale(1); }
    50% { transform: scale(1.125); }
    100% { transform: scale(1); }
  }

  .menu-item:hover {
    animation: pulse-scale 1s ease-in-out infinite;
  }

  .starwind-dropdown-content a {
    font-size: 1.125em;
    font-weight: 500;
    padding: 0.5rem 0.5rem;
    text-align: center;
  }

  .starwind-dropdown-content {
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    box-shadow: var(--shadow);
    z-index: 50;
    overflow: hidden;
    font-size: smaller;
  }

  .user-nav {
    position: relative;
    display: flex;
    align-items: center;
  }

  .user-nav-trigger {
    position: relative;
  }

  .user-nav-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    /* min-width: 16rem; */
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    box-shadow: var(--shadow);
    z-index: 50;
    overflow: hidden;
  }

  .user-nav-header {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .user-nav-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
</style>