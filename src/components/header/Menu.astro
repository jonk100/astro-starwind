---
import { Dropdown, DropdownItem, DropdownContent, DropdownTrigger } from "@/components/starwind/dropdown";
import type { HTMLAttributes } from "astro/types";
import UserNav from "./UserNav.astro";
import Skeleton from "@/components/starwind/skeleton/Skeleton.astro";

type Props = HTMLAttributes<"div"> & {
  user?: {
    email?: string;
    name?: string;
    class?: string;
  } | null;
}

const { user } = Astro.props;
---
  <Dropdown class="group flex flex-row w-full">
    <a href="/" class="menu-item">Home</a>
    <a href="/about" class="menu-item">About</a>
    <DropdownTrigger class="menu-item">
      Blog
    </DropdownTrigger>
    <DropdownContent class="min-w-48 flex flex-col">
      <DropdownItem as="a" href="/blog" class="menu-item starwind-dropdown-item">
        All Posts
      </DropdownItem>
      <DropdownItem as="a" href="/blog/categories" class="menu-item starwind-dropdown-item">
        Browse by Category
      </DropdownItem>
      <DropdownItem as="a" href="/blog/tags" class="menu-item starwind-dropdown-item">
        Popular Tags
      </DropdownItem>
    </DropdownContent>
  </Dropdown>
  <Dropdown class="group flex flex-row w-full">
    <DropdownTrigger class="menu-item">
      Site
    </DropdownTrigger>
    <DropdownContent class="min-w-48 flex flex-col">
      <DropdownItem as="a" href="/" class="menu-item starwind-dropdown-item">Home</DropdownItem>
      <DropdownItem as="a" href="/about" class="menu-item starwind-dropdown-item">About</DropdownItem>
      <DropdownItem as="a" href="/contact" class="menu-item starwind-dropdown-item">Contact</DropdownItem>
    </DropdownContent>
  </Dropdown>
  <Dropdown class="group flex flex-row w-full">
    <DropdownTrigger class="menu-item">
      Tools
    </DropdownTrigger>
    <DropdownContent class="min-w-48 flex flex-col">
      <DropdownItem as="a" href="/app/habit/track" class="menu-item starwind-dropdown-item">Habit Tracker</DropdownItem>
      <DropdownItem as="a" href="/app/write" class="menu-item starwind-dropdown-item">Journal</DropdownItem>
      <DropdownItem as="a" href="/app/relax/meditation" class="menu-item starwind-dropdown-item">Meditation Guide</DropdownItem>
    </DropdownContent>
  </Dropdown>
  <UserNav server:defer class="menu-item">
    <div slot="fallback" class="menu-item flex items-center justify-center py-2 px-4 h-9 min-w-24">
      <Skeleton class="h-4 w-16 rounded-md bg-stone-200 dark:bg-stone-800" />
    </div>
  </UserNav>





<style>
  @reference "@/styles/global.css";

  .menu-item, .menu-item * {
    @apply w-full my-auto px-4 text-foreground hover:text-primary-accent font-black;
    font-size: var(--fssm)
  }

  @keyframes pulse-scale {
    0% { transform: scale(1); }
    50% { transform: scale(1.125); }
    100% { transform: scale(1); }
  }

  .menu-item:hover {
    animation: pulse-scale 1s ease-in-out infinite;
  }

  .starwind-dropdown-content a {
    display: block;
    font-size: var(--fsxs);
    font-weight: 600;
    padding: var(--space-2);
    text-align: center;
    background-color: var(--background);
    position: relative;
    z-index: 100;
    margin: var(--space-1) auto;
    border-radius: var(--radius-xs);
    color: var(--color-foreground);
    transition: all 0.2s ease;

  }

  .starwind-dropdown-item {
    transition: all 0.2s ease;
    color: var(--color-foreground);
    border: 1px solid var(--border);
    padding: var(--space-2);
    border-radius: var(--radius-xs);
  }

  .starwind-dropdown-item:hover {
    background-color: var(--accent-hover);
    color: var(--accent-text);
    animation: none;
    /* color: var(--accent-text); */
  }

  .user-nav {
    position: relative;
    display: flex;
    align-items: center;
  }

  .user-nav-trigger {
    position: relative;
  }

  .user-nav-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    /* min-width: 16rem; */
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    box-shadow: var(--shadow);
    z-index: 50;
    overflow: hidden;
  }

  .user-nav-header {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .user-nav-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
</style>