---
import { Button } from "@/components/starwind/button";
import User from "@tabler/icons/outline/user.svg";
import Settings from "@tabler/icons/outline/settings.svg";
import LogOut from "@tabler/icons/outline/logout.svg";

import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  user?: {
    email?: string;
    name?: string;
  } | null;
}

const { class: className } = Astro.props;
let user = Astro.props.user;

// Fallback to request-time locals if the prop was not provided (e.g. Server Island execution)
if (user === undefined && typeof Astro !== 'undefined' && Astro.locals) {
  user = Astro.locals.user;
}
---

{user ? (
  <nav class:list={["user-nav", className]} role="navigation" aria-label="User menu">
    <div class="user-nav-trigger">
      <Button variant="ghost" size="sm" class="user-nav-button">
        <User class="user-nav-icon" />
        <span class="user-nav-name">{user.email?.split('@')[0] || 'User'}</span>
      </Button>
    </div>
    
    <div class="user-nav-dropdown" hidden>
      <div class="user-nav-header">
        <div class="user-nav-info">
          <span class="user-nav-email">{user.email}</span>
          {user.name && <span class="user-nav-fullname">{user.name}</span>}
        </div>
      </div>
      
      <div class="user-nav-menu">
        <a href="/settings" class="user-nav-item">
          <Settings class="user-nav-item-icon" />
          <span>Settings</span>
        </a>
        <form method="POST" action="/api/auth/logout" class="user-nav-logout-form">
          <button type="submit" class="user-nav-item user-nav-logout-button">
            <LogOut class="user-nav-item-icon" />
            <span>Sign out</span>
          </button>
        </form>
      </div>
    </div>
  </nav>
) : (
  <nav class:list={["user-nav", className]} role="navigation" aria-label="Authentication">
    <a href={`/auth/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`} class="user-nav-login" style="white-space: nowrap;">
      <User class="user-nav-icon" />
      <span>Sign in</span>
    </a>
  </nav>
)}

<script>
  // Event delegation to support dynamic server islands seamlessly
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest('.user-nav-trigger') || target.closest('.user-nav-button');
    
    if (trigger) {
      const nav = trigger.closest('.user-nav');
      const dropdown = nav?.querySelector('.user-nav-dropdown') as HTMLElement;
      if (dropdown) {
        const isHidden = dropdown.hidden;
        dropdown.hidden = !isHidden;
        trigger.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      }
    } else {
      // Clicked outside - close any open user nav dropdowns
      document.querySelectorAll('.user-nav-dropdown').forEach((dropdown) => {
        const parentNav = dropdown.closest('.user-nav');
        if (parentNav && !parentNav.contains(target)) {
          (dropdown as HTMLElement).hidden = true;
          parentNav.querySelector('.user-nav-trigger')?.setAttribute('aria-expanded', 'false');
          parentNav.querySelector('.user-nav-button')?.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });

  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest('.user-nav-trigger') || target.closest('.user-nav-button');
    
    if (trigger && (e.key === 'Enter' || e.key === ' ')) {
      e.preventDefault();
      const nav = trigger.closest('.user-nav');
      const dropdown = nav?.querySelector('.user-nav-dropdown') as HTMLElement;
      if (dropdown) {
        const isHidden = dropdown.hidden;
        dropdown.hidden = !isHidden;
        trigger.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      }
    }
    
    if (e.key === 'Escape') {
      document.querySelectorAll('.user-nav-dropdown').forEach((dropdown) => {
        (dropdown as HTMLElement).hidden = true;
        const parentNav = dropdown.closest('.user-nav');
        parentNav?.querySelector('.user-nav-trigger')?.setAttribute('aria-expanded', 'false');
        parentNav?.querySelector('.user-nav-button')?.setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>

<style>
  .user-nav {
    position: relative;
    display: flex;
    align-items: center;
  }

  .user-nav-trigger {
    position: relative;
  }

  .user-nav-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
  }

  .user-nav-button:hover {
    color: var(--primary-accent);
    font-weight: 600;
  }

  .user-nav-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .user-nav-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    /* min-width: 16rem; */
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    box-shadow: var(--shadow);
    z-index: 50;
    overflow: hidden;
  }

  .user-nav-header {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .user-nav-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .user-nav-email {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--foreground);
  }

  .user-nav-fullname {
    font-size: 0.75rem;
    color: var(--muted-foreground);
    font-weight: 400;
  }

  .user-nav-menu {
    padding: 0.5rem;
  }

  .user-nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: var(--foreground);
    /* font-size: 0.875rem; */
    font-weight: 500;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
    margin: 0.25rem 0;
  }

  .user-nav-item:hover {
    color: var(--primary-accent);
    font-weight: 600;
  }

  .user-nav-item-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .user-nav-login {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    text-decoration: none;
    color: var(--foreground);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .user-nav-login:hover {
    /* color: var(--primary-accent); */
  }

  .user-nav-logout-form {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    font-size: 1rem;
  }

  .user-nav-logout-button {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: var(--foreground);
    font-size: 1rem;
    font-weight: 500;
    border-radius: 0.375rem;
    transition: all 0.15s ease;
    margin: 0.25rem 0;
    background: none;
    border: none;
    font-family: inherit;
    text-align: left;
    /* width: 100%; */
    cursor: pointer;
  }

  .user-nav-logout-button:hover {
    color: var(--primary-accent);
    font-weight: bold;
  }

  @media (max-width: 768px) {
    .user-nav-dropdown {
      right: 0;
      left: 0;
      min-width: 100%;
    }
    
    .user-nav-item {
      margin: 0.125rem 0;
    }
  }
</style>
