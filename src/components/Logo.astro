---
import { Image } from "@/components/starwind/image";
import LogoAsset from '@/assets/logo-black.png';

interface Props {
  class?: string;
  height?: number;
}

const { class: className, height = 40 } = Astro.props;
---

<a href="/" class={className}>
  <Image src={LogoAsset} alt="Logo" class="mx-auto" height={height} />
</a>
