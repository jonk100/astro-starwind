---
/**
 * FAQSection
 * - Standard FAQ layout block with structured question/answer flow.
 * @param {string} title - The title of the FAQ section.
 * @param {FAQItem[]} items - The FAQ items.
 * @param {string} items.question - The question text.
 * @param {string} items.answer - The answer text.
 */

import { Section, ContentWidth, Stack } from './';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FAQItem[];
}

const { title = 'FAQ', items } = Astro.props;
---

<Section size="lg">
  <ContentWidth width="md">
    <Stack gap="lg">

      <!-- Title -->
      <h2>{title}</h2>    
      {/**
       * FAQ items
       * - Each item is a details element
       * - Summary is the question
       * - P tag is the answer
       */}
      <Stack gap="md">
        {items.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </Stack>
    </Stack>
  </ContentWidth>
</Section>

<style>
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
  }

  .faq-item p {
    margin-top: 0.5rem;
    opacity: 0.8;
  }
</style>