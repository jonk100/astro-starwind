---
/**
 * Cluster
 * Horizontal flex layout with wrapping and alignment control.
 *
 * Features:
 * - Wrap-aware row layout
 * - Gap tokens
 * - Alignment control
 * - Semantic element rendering
 */

import type { HTMLAttributes } from 'astro/types';

type ClusterGap = 'sm' | 'md' | 'lg';
type Align = 'start' | 'center' | 'end' | 'between';

interface Props extends HTMLAttributes<'div'> {
  as?: keyof HTMLElementTagNameMap;
  gap?: ClusterGap;
  align?: Align;
}

const {
  as: Element = 'div',
  gap = 'md',
  align = 'start',
  class: className = '',
  style = '',
  ...attrs
} = Astro.props;

const gaps: Record<ClusterGap, string> = {
  sm: '0.5rem',
  md: '1rem',
  lg: '2rem'
};

const alignMap: Record<Align, string> = {
  start: 'flex-start',
  center: 'center',
  end: 'flex-end',
  between: 'space-between'
};
---

<Element
  class={`cluster ${className}`}
  style={`
    --cluster-gap: ${gaps[gap]};
    --cluster-justify: ${alignMap[align]};
    ${style}
  `}
  {...attrs}
>
  <slot />
</Element>

<style>
  .cluster {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cluster-gap);
    justify-content: var(--cluster-justify);
    align-items: center;
  }
</style>