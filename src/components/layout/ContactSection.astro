---
/**
 * ContactSection
 * Contact information + optional form slot.
 */

import { Section, ContentWidth, Stack, Cluster } from './';
import { Image } from '../starwind/image';


interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Contact',
  description
} = Astro.props;
---

<Section size="lg">
  <Cluster>
    <Stack>
      {title && <h2>{title}</h2>}
      {description && <p>{description}</p>}
      
    </Stack>
  <ContentWidth width="md">
    <Stack gap="lg">

      <Stack gap="sm">
        <h2>{title}</h2>
        {description && <p>{description}</p>}
      </Stack>

      <slot />

    </Stack>
  </ContentWidth>
</Section>