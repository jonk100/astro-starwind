---
import ScrollReveal from '@/components/layout/ScrollReveal.astro';
interface Props {
  title: string;
  phrase: string;
  description: string;
  link: string;
  scheme: 'light' | 'dark' | 'primary' | 'secondary';
  class?: string;
}

const { title, phrase, description, link, scheme, class: className = '' } = Astro.props;

const schemeClasses: Record<string, string> = {
  light: 'bg-[var(--purple-9)] text-stone-900 border-2 border-accent',
  dark: 'bg-stone-800 text-stone-100 border-2 border-accent',
  primary: 'bg-[var(--yellow-4)] text-accent border-2 border-stone-900',
  secondary: 'bg-secondary-500 text-accent border-2 border-stone-900',
};

const schemeClass = schemeClasses[scheme] ?? schemeClasses.light;
---
<div class={`card ${schemeClass} ${className} scroll-reveal max-w-[400px] h-[450px] space-around mx-auto min-h-full`}>
  <div class={`rounded-2xl p-3 m-1 border-2 border-primary max-w-[480px] h-[450px] space-around flex flex-col hover:opacity-80 transition-all duration-700s mx-auto ${schemeClass}`}>
    <a href={link} class="cursor-pointer hover:scale-105 hover:animate-pulse-1s transition-all duration-700">
      <ScrollReveal axis="x" distance="-860px">
        <h3 class="text-2xl font-bold m-2">{title}</h3>
      </ScrollReveal>
      <ScrollReveal axis="y" distance="280px">
        <p class="text-lg mb-6 font-bold">{phrase}</p>
      </ScrollReveal>
      <ScrollReveal axis="x" distance="160px">
        <p class="text-lg mb-8 grow">{description}</p>
      </ScrollReveal>
    </a>

    <a
      href={link}
      class="px-6 py-4 mt-auto items-center text-4xl font-medium 
        inline-flex group hover:scale-105 hover:font-black 
        transition-all duration-700"
    >
      Start
      <svg
        class="w-4 h-4 ml-2 transform group-hover:translate-x-8 transition-translate-x-8 transition-all duration-700"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"
        />
      </svg>
    </a>
  </div>
</div>

<style>
  .scroll-reveal:nth-child(1) {
    transition-delay: 50ms;
  }

  .scroll-reveal:nth-child(2) {
    transition-delay: 150ms;
  }

  .scroll-reveal:nth-child(3) {
    transition-delay: 250ms;
  }
  .group:hover {
    scale: 1.1;
    font-weight: 900;
  }
  .card {
  position: relative;

  overflow: hidden;

  border-radius: 1rem;

  transition:
    transform 0.75s ease,
    opacity 0.75s ease;
}

.card::before {
  content: '';

  position: absolute;
  inset: 0;

  border-radius: inherit;

  border: 2px solid currentColor;

  transform: scale(1);

  opacity: 0.7;

  transition:
    transform 0.75s ease,
    opacity 0.75s ease;

  pointer-events: none;
}

.card:hover::before {
  transform: scale(1.04);

  opacity: 1;
}

.image-card {
  position: relative;
  overflow: hidden;
}

.image-card img {
  display: block;
  width: 100%;
  height: auto;
}

.overlay {
  position: absolute;
  inset: 0;

  background: rgb(0 0 0 / 0.5);
}
</style>
