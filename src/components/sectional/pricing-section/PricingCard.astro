---
import ScrollReveal from '@/components/layout/ScrollReveal.astro';

interface Props {
  title: string;
  price: string;
  period?: string;
  features: string[];
  highlighted?: boolean;
  ctaText?: string;
  scheme?: 'light' | 'dark' | 'primary';
  class?: string;
}

const { 
  title, 
  price, 
  period = '/mo', 
  features, 
  highlighted = false, 
  ctaText = 'Get started',
  scheme = 'light',
  class: className = '' 
} = Astro.props;

const schemeClasses: Record<string, string> = {
  light: 'bg-white text-stone-900 border-2 border-stone-200',
  dark: 'bg-stone-800 text-stone-100 border-2 border-stone-600',
  primary: 'bg-[var(--yellow-4)] text-stone-900 border-2 border-stone-900',
};

const schemeClass = schemeClasses[scheme] ?? schemeClasses.light;
const highlightedClass = highlighted ? 'ring-4 ring-red-500 scale-105' : '';
---

<div class={`card ${schemeClass} ${highlightedClass} ${className} scroll-reveal max-w-[400px] h-[500px] rounded-2xl p-6 flex flex-col mx-auto`}>
  <ScrollReveal axis="y" distance="40px">
    <div class="text-center mb-6">
      <h3 class="text-2xl font-bold mb-2">{title}</h3>
      <div class="flex items-baseline justify-center">
        <span class="text-5xl font-bold">{price}</span>
        {period && <span class="text-lg opacity-75 ml-1">{period}</span>}
      </div>
    </div>
  </ScrollReveal>
  
  <ScrollReveal axis="y" distance="40px">
    <ul class="space-y-3 mb-6 grow">
      {features.map((feature) => (
        <li class="flex items-start">
          <svg class="w-5 h-5 mr-2 mt-0.5 shrink-0 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </ScrollReveal>
  
  <ScrollReveal axis="x" distance="40px">
    <button class={`w-full py-3 px-6 rounded-lg font-bold text-lg transition-all duration-300 hover:scale-105 ${
      highlighted 
        ? 'bg-red-500 text-white hover:bg-red-600' 
        : 'bg-stone-900 text-white hover:bg-stone-800'
    }`}>
      {ctaText}
    </button>
  </ScrollReveal>
</div>

<style>
  .card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }
</style>
