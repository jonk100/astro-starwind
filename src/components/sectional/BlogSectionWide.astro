---
import { getCollection } from 'astro:content';
import ScrollReveal from '@/components/layout/ScrollReveal.astro';
import FormattedDate from '@/components/FormattedDate.astro';
import { Image } from '@/components/starwind/image';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'section' | 'article' | 'main' | 'span' | 'a';
  image: string;
  alt?: string;
  title?: string;
  description?: string;
  class: string;
}

const { 
  image,
  alt,
  title,
  description,
  class: className = ''
} = Astro.props;

const allPosts = (await getCollection('blog'))
  .filter(post => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
  .slice(0, 6);

const featuredPost = {
  ...allPosts[0],
  title: allPosts[0].data.title,
  description: allPosts[0].data.description,
  image: allPosts[0].data.image,
  date: allPosts[0].data.date,
  id: allPosts[0].id,
  tags: allPosts[0].data.tags,
  categories: allPosts[0].data.categories,
  keywords: allPosts[0].data.keywords,
  minutesRead: allPosts[0].data.minutesRead
};

const otherPosts = allPosts.slice(1);
---

<section class={`blog-section-wide ${className}`}>
  <!-- Full-screen hero section -->
  <div class="blog-hero relative min-h-[60vh] flex items-center justify-center overflow-hidden">
    {allPosts[0].data.image && (
      <a href={`/blog/${featuredPost.id}`}>
        <Image 
          src={featuredPost.image} 
          alt={featuredPost.title}
          infersize
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-linear-to-b from-black/50 via-black/30 to-black/70" />
        <div class="relative z-10 text-center px-4 max-w-4xl">
          <ScrollReveal>
            <h2 class="text-5xl md:text-7xl font-bold text-white mb-6">
              {featuredPost.title}
            </h2>
            <p class="text-xl md:text-2xl text-stone-200">
              {featuredPost.description}
            </p>
          </ScrollReveal>
        </div>
      </a>
    )}
  </div>

  <!-- 2x2 grid of blog posts -->
  <div class="blog-grid-container py-16 px-4">
    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {allPosts.map((post, index) => (
          <ScrollReveal axis="y" distance={40}>
            <a href={`/blog/${post.id}/`} class="h-full blog-card group block">
              <div class="blog-card-inner bg-stone-100 h-full dark:bg-stone-800 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                {post.data.image && (
                  <div class="blog-image-container aspect-video overflow-hidden">
                    <img 
                      src={post.data.image} 
                      alt={post.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                )}
                <div class="p-6">
                  <div class="blog-meta flex items-center gap-4 mb-3 text-sm text-stone-600 dark:text-stone-400">
                    {post.data.date && (
                      <FormattedDate date={post.data.date} />
                    )}
                    {post.data.minutesRead && (
                      <span>• {post.data.minutesRead} min read</span>
                    )}
                  </div>
                  <h3 class="blog-title text-xl font-bold text-stone-900 dark:text-stone-50 mb-3 group-hover:text-[rgb(var(--purple))] transition-colors">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="blog-description text-stone-600 dark:text-stone-400 line-clamp-2">
                      {post.data.description}
                    </p>
                  )}
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="blog-tags flex flex-wrap gap-2 mt-4">
                      {post.data.tags.slice(0, 3).map((tag) => (
                        <span class="blog-tag text-xs px-3 py-1 rounded-full bg-[rgb(var(--purple-9))] text-stone-900">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </a>
          </ScrollReveal>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .blog-section-wide {
    background: linear-gradient(to bottom, transparent, var(--purple-5), transparent);
  }

  .blog-hero {
    position: relative;
  }

  .blog-card {
    text-decoration: none;
  }

  .blog-card-inner {
    border: 2px solid transparent;
    transition: all 0.3s ease;
  }

  .blog-card:hover .blog-card-inner {
    border-color: rgb(var(--purple-6));
  }

  .blog-image-container {
    background: linear-gradient(135deg, rgb(var(--purple-8)), rgb(var(--purple-6)));
  }

  .blog-title {
    line-height: 1.3;
  }

  .blog-description {
    line-height: 1.6;
  }

  .blog-tag {
    transition: all 0.2s ease;
  }

  .blog-tag:hover {
    background: rgb(var(--purple-7));
  }

  @media (max-width: 768px) {
    .blog-hero {
      min-height: 50vh;
    }

    .blog-hero h2 {
      font-size: 2.5rem;
    }

    .blog-hero p {
      font-size: 1.1rem;
    }
  }
</style>
