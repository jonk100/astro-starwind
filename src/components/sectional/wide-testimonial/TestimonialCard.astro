---
import { ScrollReveal } from '@/components/layout';

interface Props {
  quote: string;
  name: string;
  title: string;
  avatar?: string;
  scheme?: 'light' | 'dark' | 'primary';
  class?: string;
}

const { quote, name, title, avatar, scheme = 'light', class: className = '' } = Astro.props;

const schemeClasses: Record<string, string> = {
  light: 'bg-white text-stone-900 border-2 border-stone-200',
  dark: 'bg-stone-800 text-stone-100 border-2 border-stone-600',
  primary: 'bg-[var(--yellow-4)] text-stone-900 border-2 border-stone-900',
};

const schemeClass = schemeClasses[scheme] ?? schemeClasses.light;
---

<div class={`card ${schemeClass} ${className} scroll-reveal max-w-[400px] h-[400px] rounded-2xl p-6 flex flex-col mx-auto`}>
  <ScrollReveal axis="y" distance="40px">
    <div class="grow">
      <svg class="w-8 h-8 text-stone-400 mb-4" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
      </svg>
      <p class="text-lg mb-6 italic">"{quote}"</p>
    </div>
  </ScrollReveal>
  
  <ScrollReveal axis="x" distance="40px">
    <div class="flex items-center mt-auto">
      <div class="w-12 h-12 rounded-full bg-stone-300 flex items-center justify-center mr-4 overflow-hidden">
        {avatar ? (
          <img src={avatar} alt={name} class="w-full h-full object-cover" />
        ) : (
          <span class="text-stone-600 font-bold text-xl">{name.charAt(0)}</span>
        )}
      </div>
      <div>
        <p class="font-bold text-lg">{name}</p>
        <p class="text-sm opacity-75">{title}</p>
      </div>
    </div>
  </ScrollReveal>
</div>

<style>
  .card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
  }
</style>
