---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  h: string;
  p: string;
  class?: string;
  style?: string;
  as?: keyof HTMLElementTagNameMap;
  large?: boolean;
  /** High-contrast text for hero imagery */
  tone?: 'default' | 'onImage';
}

const { h, p, class: className = '', style, as: Element = 'div', large = false, tone = 'default' } = Astro.props;
const onImage = tone === 'onImage';
---

<Element
  class:list={[
    'text-center text-balance m-auto',
    onImage && 'drop-shadow-md',
    className,
  ]}
  style={style}
>
  <h1
    class:list={[
      onImage ? 'text-3xl font-semibold tracking-tight text-white sm:text-4xl md:text-5xl py-4' 
      : large ? 'text-5xl font-medium py-8 px-0 text-slate-100 shadow-lg' 
      : 'text-3xl lh-1.2 py-4 text-slate-100 shadow-lg',
    ]}
  >
    {h}
  </h1>
  <hr />
  <p
    class:list={[
      onImage ? 'text-base leading-relaxed text-zinc-100/95 sm:text-lg md:text-xl' 
      : large ? 'text-3xl font-medium text-slate-100 shadow-lg' 
      : 'text-xl lh-1.2 text-slate-100 shadow-lg font-bold',
      !onImage && 'text-muted',
    ]}
    style="padding: 0; margin: 2rem auto;"
  >
    {p}
  </p>
</Element>

<style>
  hr {
    margin-top: 2rem;
    margin-bottom: 3rem;
  }
  p {
    animation: fadeIn 2s ease-in;
  }
  
  @keyframes fadeIn {
    from {
      transform: translateY(200px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  h1 {
    animation: slideL 1s ease, 
    pulse 3s ease-in-out infinite 1s;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      transform-origin: center;
    }
    50% {
      transform: scale(1.05);
      transform-origin: center;
    }
  }
  
  @keyframes slideL {
    from {
      transform: translateX(700px);
      letter-spacing: 0.5em;
      opacity: 0;
    }
    50% {
      transform: translateX(-100px);
      letter-spacing: 0.1em;
      opacity: 0.2;
    }
    70% {
      transform: translateX(100px);
      opacity: 0.5;
    }
    80% {
      transform: translateX(-50px);
      opacity: 0.7;
    }
    90% {
      transform: translateX(30px);
      opacity: 0.80;
    }
    95% {
      transform: translateX(-20px);
      opacity: 0.90;
    }
    to {
      transform: translateX(0);
      letter-spacing: 0em;
      opacity: 1;
    }
  }


</style>
