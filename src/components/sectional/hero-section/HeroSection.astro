---
import HeroText from './hero-text.astro';
import HeroImage from './hero-image.astro';
import HeroAction from './hero-action.astro';
import type { HTMLAttributes } from 'astro/types';
import Center from '@/components/layout/Center.astro';

interface Props extends HTMLAttributes<'section'> {
  h: string;
  p: string;
  style?: string;
  class?: string;
  textClass?: string;
  as?: keyof HTMLElementTagNameMap;
  imgSrc?: string;
  imgAlt?: string;
  width?: number;
  height?: number;
  action?: 'button' | 'search' | 'link';
}

const { h, p, style, class: className = '', textClass = '', as: Element = 'section', imgSrc, imgAlt = '', width = 0, height = 0, action } = Astro.props;
---
{imgSrc ? (
  <Element
    class={`${className} relative flex w-full min-h-[90vh] flex-col items-center justify-center overflow-hidden px-4 py-12 hero-section`}
    style={style}
  >
    <HeroImage src={imgSrc} alt={imgAlt} width={width} height={height} />
    <div
      class="hero-gradient"
      aria-hidden="true"
    />
    <div 
      class="
        pointer-events-none 
        absolute 
        inset-0 
        z-2 
        bg-linear-to-b 
        from-black/10 
        via-black/30
        to-black/10
      "
      aria-hidden="true"
    />
    <HeroText 
      h={h} 
      p={p} 
      class={`relative z-10 w-3/4 max-w-3xl ${textClass}`} 
      tone="onImage" 
    />
    {action && <HeroAction type={action} />}
  </Element>
) : (
  <Center axis="y" class="h-[90vh] w-full">
    <Element class={`${className} mx-auto section-container`} style={style}>
      <HeroText h={h} p={p} class={textClass} large />
      {action && <HeroAction type={action} />}
    </Element>
  </Center>
)}

<style>
  .hero-gradient {
  position: absolute;
  inset: -30%;

  z-index: 1;

  pointer-events: none;

  background:
    radial-gradient(
      circle at 20% 20%,
      rgb(255 0 128 / 0.7),
      transparent 25%
    ),
    radial-gradient(
      circle at 80% 30%,
      rgb(0 212 255 / 0.6),
      transparent 30%
    ),
    radial-gradient(
      circle at 50% 80%,
      rgb(124 255 0 / 0.5),
      transparent 30%
    );

  background-size: 250% 250%;

  filter: blur(120px);

  mix-blend-mode: screen;

  opacity: 0.9;

  will-change:
    transform,
    background-position,
    opacity;

  animation:
    gradientMove 12s ease infinite,
    heroGradientFloat 18s ease-in-out infinite alternate;
}

@keyframes gradientMove {
  0% {
    background-position: 0% 50%;
  }

  25% {
    background-position: 100% 20%;
  }

  50% {
    background-position: 50% 100%;
  }

  75% {
    background-position: 20% 30%;
  }

  100% {
    background-position: 0% 50%;
  }
}

@keyframes heroGradientFloat {
  0% {
    transform:
      translate3d(0%, 0%, 0)
      scale(1)
      rotate(0deg);

    opacity: 0.75;
  }

  50% {
    transform:
      translate3d(-8%, 4%, 0)
      scale(1.15)
      rotate(8deg);

    opacity: 1;
  }

  100% {
    transform:
      translate3d(6%, -6%, 0)
      scale(1.3)
      rotate(-8deg);

    opacity: 0.8;
  }
}
</style>