---
/**
 * BlogIndexLayout
 * Full-page shell layout for the blog index.
 *
 * Composes BaseHead, Header, and Footer with the shared layout
 * primitive system (Section, ContentWidth, Stack, PageHeader).
 *
 * Slots:
 * - `head`         — Extra <head> tags (meta, scripts, etc.)
 * - `header`       — Content injected after the sticky nav Header
 * - `hero-search`  — Search bar and any hero-area content
 * - default        — Main page body (post grid, carousel, etc.)
 * - `footer`       — Content injected before the Footer
 */

import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from '../components/header/Header.astro';
import { BlogBreadcrumbs } from '../components/blog';
import PageHeader from '../components/layout/PageHeader.astro';
import Section from '../components/layout/Section.astro';
import ContentWidth from '../components/layout/ContentWidth.astro';
import Stack from '../components/layout/Stack.astro';
import Center from '../components/layout/Center.astro';

import '@/styles/global.css';
import '@/styles/starwind.css';

interface Breadcrumb {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  /** Browser tab title (e.g. "All Posts - My Blog"). */
  title: string;

  /** Meta description for SEO. */
  description: string;

  /**
   * Heading text displayed in the hero area.
   * Kept separate from `title` so no string-slicing is needed.
   */
  heading: string;

  /** Optional sub-heading / description shown below the hero heading. */
  subheading?: string;

  /**
   * Whether to render the breadcrumb trail above the hero.
   * @default false
   */
  showBreadcrumbs?: boolean;

  /** Breadcrumb items. Only used when `showBreadcrumbs` is true. */
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description,
  heading,
  subheading,
  showBreadcrumbs = false,
  breadcrumbs
} = Astro.props;

const user = Astro.locals.user;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <slot name="head" />
  </head>

  <body class="blog-index-body">

    <!-- ── Sticky navigation ───────────────────────────────────────── -->
    <header class="blog-index-header">
      <Header user={user} />
      <slot name="header" />
    </header>

    <!-- ── Optional breadcrumbs ───────────────────────────────────── -->
    {showBreadcrumbs && breadcrumbs && (
      <BlogBreadcrumbs breadcrumbs={breadcrumbs} />
    )}

    <!-- ── Main content ───────────────────────────────────────────── -->
    <main class="blog-index-main">

      <!-- Hero / search band -->
      <div class="blog-index-hero blog-list-hero section">
        <ContentWidth width="md" padded>
          <Stack gap="lg">
            <Center axis="x">
              <PageHeader title={heading} description={subheading} as="div" />
            </Center>
            <slot name="hero-search" />
          </Stack>
        </ContentWidth>
      </div>

      <!-- Page body (carousel, grid, etc.) -->
      <Section size="lg">
        <ContentWidth padded>
          <Stack gap="lg">
            <slot />
          </Stack>
        </ContentWidth>
      </Section>

    </main>

    <!-- ── Footer ─────────────────────────────────────────────────── -->
    <footer class="blog-index-footer">
      <slot name="footer" />
      <Footer />
    </footer>

  </body>
</html>

<style>

@reference "../styles/global.css";

.blog-list-hero {

	/* @apply bg-blue-200; */
	margin: 0 auto;
	min-height: 100vh;
	background-size: cover;
}

.section {
	padding-top: 8rem;
}

.blog-list-hero h1 {
	@apply font-bold;
}

  .blog-index-body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  .blog-index-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .blog-index-main {
    flex: 1;
  }

  .blog-index-hero {
    text-align: center;
  }

  .blog-index-footer {
    margin-top: auto;
  }
</style>