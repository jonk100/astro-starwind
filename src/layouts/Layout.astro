---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from '../components/header/Header.astro';
import Navigation from '@/components/header/Navigation.astro';

interface Props {
  title: string;
  description?: string;
  mainWidth?: number | null;
  hideGlobalHeader?: boolean;
}

const { title, description = '', mainWidth, hideGlobalHeader = false } = Astro.props;
const user = Astro.locals.user;

import '@/styles/global.css';
import '@/styles/starwind.css';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
    <slot name="head" />
    <script is:inline>
      function initTheme() {
        const colorTheme = localStorage.getItem("colorTheme");
        if (!colorTheme) {
          if (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) {
            document.documentElement.classList.add("dark");
            localStorage.setItem("colorTheme", "dark");
          } else {
            document.documentElement.classList.remove("dark");
            localStorage.setItem("colorTheme", "light");
          }
        } else {
          if (colorTheme === "dark") {
            document.documentElement.classList.add("dark");
          } else if (colorTheme === "light") {
            document.documentElement.classList.remove("dark");
          } else if (colorTheme === "system") {
            const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
            document.documentElement.classList.toggle("dark", prefersDark);
          }
        }
      }
      initTheme();
      document.addEventListener("astro:after-swap", initTheme);
    </script>
	</head>

	<body class="layout-body">
    {!hideGlobalHeader && (
      <header class="layout-header sticky top-0 z-50">
        <Header user={user} />
        <slot name="header" />
      </header>
    )}
    <container class="app--hero-slot">
      <slot name="hero" />
    </container>
    
    <main class="main--base-layout"></main>
      <slot />
    </main>
    
    <container class="app--hero-slot">
      <slot name="zero" />
    </container>
    <footer class="layout-footer">
      <slot name="footer" />
      <Footer />
    </footer>
	</body>

  <style>
    .layout-header {
      height: 64px;
      min-height: 64px;
      max-height: 64px;
      z-index: 100;
      display: flex;
      flex-direction: column;
      justify-content: center;
      background: linear-gradient(135deg, var(--purple-5, #f3e8ff) 0%, var(--purple-4, #e9d5ff) 100%);
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    }
    :global(.dark) .layout-header {
      background: linear-gradient(135deg, #18122b 0%, #0f0c1b 100%);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    
  </style>
</html>