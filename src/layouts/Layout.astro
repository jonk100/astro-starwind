---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from '../components/header/Header.astro';
import Navigation from '@/components/header/Navigation.astro';

interface Props {
  title: string;
  description?: string;
  mainWidth?: number | null;
}

const { title, description = '', mainWidth } = Astro.props;
const user = Astro.locals.user;

import '@/styles/global.css';
import '@/styles/starwind.css';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
    <slot name="head" />
	</head>

	<body class="layout-body">
    <header class="layout-header sticky top-0 z-50">
      <!-- <Header user={user} /> -->
      <Navigation user={user} />
      <slot name="header" />
    </header>
    
    <main class="layout-main" style={mainWidth != null ? `max-width: ${mainWidth}px` : undefined}>
      <!-- <div class="layout-main-content"> -->
      <slot />
      <!-- </div> -->
    </main>

    <footer class="layout-footer">
      <slot name="footer" />
      <Footer />
    </footer>
	</body>

</html>