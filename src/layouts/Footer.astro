---
/**
 * @file src/layouts/Footer.astro
 * @description Premium, modern, multi-column navigation footer with responsive layouts,
 * hover transitions, and clean integration of legal/informative links.
 */
const today = new Date();
---

<footer class="w-full bg-[var(--warm-neutral)] border-t border-border pt-16 pb-12 font-sans select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* ── Main Multi-Column Grid ── */}
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10 md:gap-8 pb-12 border-b border-border">
      
      {/* Column 1: Mission & Brand */}
      <div class="space-y-4">
        <a href="/" class="inline-block">
          <span class="font-serif text-xl font-extrabold text-[rgb(var(--purple))]">reMindMatters</span>
        </a>
        <p class="text-xs text-muted-foreground leading-relaxed max-w-xs font-medium">
          A quiet digital sanctuary built for deep reflections, consistent habit grids, and therapeutic meditation loops. Dedicated to guarding your emotional safety.
        </p>
      </div>

      {/* Column 2: Pages Links */}
      <div class="flex flex-col gap-3">
        <h4 class="font-serif text-sm font-bold text-foreground uppercase tracking-widest leading-none mb-1">
          Explore
        </h4>
        <nav class="flex flex-col gap-2.5 text-xs text-muted-foreground font-semibold">
          <a href="/" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Home</a>
          <a href="/about" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">About Our Path</a>
          <a href="/blog" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Wellness Blog</a>
          <a href="/contact" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Get In Touch</a>
          <a href="/faq" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">FAQ / Support</a>
        </nav>
      </div>

      {/* Column 3: Applications Links */}
      <div class="flex flex-col gap-3">
        <h4 class="font-serif text-sm font-bold text-foreground uppercase tracking-widest leading-none mb-1">
          Sanctuary Apps
        </h4>
        <nav class="flex flex-col gap-2.5 text-xs text-muted-foreground font-semibold">
          <a href="/habits" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Habit Tracker Matrix</a>
          <a href="/journal" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Reflective Journal</a>
          <a href="/meditation" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Mindfulness Guide</a>
        </nav>
      </div>

      {/* Column 4: Legal & Transparency */}
      <div class="flex flex-col gap-3">
        <h4 class="font-serif text-sm font-bold text-foreground uppercase tracking-widest leading-none mb-1">
          Transparency
        </h4>
        <nav class="flex flex-col gap-2.5 text-xs text-muted-foreground font-semibold">
          <a href="/privacy" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Privacy Policy</a>
          <a href="/legal" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Terms & Legal stuff</a>
          <a href="/statistics" class="hover:text-primary hover:translate-x-0.5 transition-all duration-200">Platform Statistics</a>
        </nav>
      </div>

    </div>

    {/* ── Footer Bottom Copyright & Socials ── */}
    <div class="pt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 text-xs font-semibold text-muted-foreground">
      
      <div class="flex items-center gap-1.5">
        <span>&copy; {today.getFullYear()} reMindMatters. All rights reserved.</span>
        <span>•</span>
        <span>Made with absolute care in CA.</span>
      </div>

      <div class="flex items-center gap-4">
        <a 
          href="https://github.com/jonk100/astro-starwind" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-foreground hover:scale-110 transition-all duration-200 flex items-center gap-1"
          aria-label="GitHub Repository"
        >
          <span>GitHub</span>
        </a>
        <span>•</span>
        <a 
          href="https://twitter.com/astrodotbuild" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-foreground hover:scale-110 transition-all duration-200 flex items-center gap-1"
          aria-label="Twitter Account"
        >
          <span>Twitter</span>
        </a>
        <span>•</span>
        <a 
          href="https://m.webtoo.ls/@astro" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hover:text-foreground hover:scale-110 transition-all duration-200 flex items-center gap-1"
          aria-label="Mastodon Profile"
        >
          <span>Mastodon</span>
        </a>
      </div>

    </div>

  </div>
</footer>
