---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from '../components/header/Header.astro';
import { TableOfContents, RelatedPostsCards, NextPostButton, PreviousPostButton } from '../components/blog';
import { Separator } from '@/components/starwind/separator';
import type { BlogPost, BlogPostWithContent, BlogNavigation } from '../components/blog/types';

interface Props {
  title: string;
  description: string;
  showProgress?: boolean;
  showToc?: boolean;
  showRelatedPosts?: boolean;
  showNavigation?: boolean;
  post?: BlogPostWithContent;
  allPosts?: BlogPost[];
  navigation?: BlogNavigation;
}

const { 
  title, 
  description, 
  showToc = true,
  showRelatedPosts = true,
  showNavigation = true,
  post,
  allPosts = [],
  navigation
} = Astro.props;

import '@/styles/global.css';
import '@/styles/starwind.css';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
    <slot name="head" />
    {post?.image && <link rel="preload" as="image" href={post.image} />}
	</head>

	<body class="layout-body">
    
    <header class="layout-header">
      <Header />
      <slot name="header" />
    </header>
    
    <main class="layout-main">
      <div class="layout-main-content max-w-4xl">
        <!-- <div class="mb-8"> -->
        <!-- </div> -->
        
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
          <div class="lg:col-span-3">
            <article class="prose prose-lg max-w-none">
              <slot />
            </article>
            
            {showNavigation && navigation && (
              <div class="mt-12 space-y-4">
                <Separator />
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {navigation.previous && (
                    <PreviousPostButton 
                      previousPost={navigation.previous}
                      variant="outline"
                    />
                  )}
                  {navigation.next && (
                    <NextPostButton 
                      nextPost={navigation.next}
                      variant="default"
                    />
                  )}
                </div>
              </div>
            )}
            
            {showRelatedPosts && post && allPosts.length > 0 && (
              <div class="mt-16">
                <RelatedPostsCards 
                  currentPost={post}
                  allPosts={allPosts}
                  maxPosts={3}
                  columns={3}
                />
              </div>
            )}
          </div>
          
          <aside class="lg:col-span-1">
            <div class="sticky top-4 space-y-6">
              {showToc && post?.content && (
                <TableOfContents 
                  content={post.content}
                  title="Table of Contents"
                  maxDepth={3}
                  sticky={true}
                  variant="sidebar"
                />
              )}
              
              <slot name="sidebar" />
            </div>
          </aside>
        </div>
      </div>
    </main>

    <footer class="layout-footer">
      <slot name="footer" />
      <Footer />
    </footer>
	</body>
</html>
