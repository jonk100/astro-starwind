---
import Head from './BaseHead.astro';
import Navigation from '../components/header/Header.astro';
import Footer from '../layouts/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	user?: any;
}

const { title, description, user: userProp } = Astro.props;
const user = userProp ?? Astro.locals.user;
---
<html lang="en">
	<head>
		<Head title={title} description={description} />
	</head>
	<body>
    <div class="site-header-region">
      <Navigation user={user} />
      <slot name="header" />
    </div>
      <slot name="hero" class="hero-section" />
    <main>
      <slot name="main-top" />
      <slot />
      <slot name="main-bottom" />
    </main>
    <slot name="zero" />
    <footer class="mt-auto">
      <Footer />
      <slot name="footer" />
    </footer>
	</body>
</html>

<style>
  @reference "../styles/global.css";
  html, body {
    height: 100%;
    margin: 0;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .site-header-region {
    flex-shrink: 0;
  }
  header {
    flex-shrink: 0;
  }
  main {
    flex: 1 0 auto;
  }
  footer {
    flex-shrink: 0;
  }
  .hero-section {
    animation: bgIn 3s ease-in-out;
    /* background-color: var(--color-background); */
  }
  .section-container {
    @apply mx-auto;
  }
</style>
