---
/**
 * Base site layout with header, main content, and footer
 */
import Head from './BaseHead.astro';
import Header from '../components/header/Header.astro';
import Footer from '../layouts/Footer.astro';
import '../styles/global.css';
import type { User } from '@supabase/supabase-js';
import { Stack } from '@/components/layout';

interface Props {
	title: string;
	description: string;
	user?: User;
}

const { title, description, user: userProp } = Astro.props;
const user = userProp ?? Astro.locals.user;
---
<html lang="en">
	<head>
		<Head 
    title={title} description={description} />

	</head>
	<body>
    <header class="layout-header sticky top-0 z-50">
      <Header user={user} />
      <slot name="header" />
    </header>
      <slot name="hero" class="hero-section" />
          <main>

          <Stack>
          <slot name="main-top" />

          </Stack>

          <slot />
          
          <Stack>
          <slot name="main-bottom" />
        </Stack>
      </main>
    <slot name="zero" />
    <footer class="mt-auto">
      <Footer />
      <slot name="footer" />
    </footer>
	</body>
</html>

<style>
  @reference "../styles/global.css";
  html, body {
    height: 100%;
    margin: 0;
  }
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .site-header-region {
    flex-shrink: 0;
  }
  header {
    flex-shrink: 0;
  }
  main {
    flex: 1 0 auto;
  }
  footer {
    flex-shrink: 0;
  }
  .hero-section {
    animation: bgIn 3s ease-in-out;
    /* background-color: var(--color-background); */
  }
  .section-container {
    @apply mx-auto;
  }
</style>
