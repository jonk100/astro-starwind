---
/**
 * Base site layout with header, main content, and footer
 */
import Head from './BaseHead.astro';
import Header from '../components/header/Header.astro';
import Footer from '../layouts/Footer.astro';
import '../styles/global.css';
import type { User } from '@supabase/supabase-js';
import { Stack } from '@/components/layout';
import BgBalls from './BgBalls.astro';

interface Props {
	title: string;
	description: string;
	user?: User;
}

const { title, description, user: userProp } = Astro.props;
const user = userProp ?? Astro.locals.user;
---
<html lang="en">
  <!-- Head and head slot -->
	<head>
		<Head title={title} description={description} />
    <slot name="head" />
	</head>

  <body class="layout-body">

    <!-- Header and header slot -->
    <Header user={user} />
    <slot name="header" />
    
    <!-- Hero and hero slot -->
    <slot name="hero" class="hero-section" />

    <!-- Main content with 3 slots -->
    <main>
      <BgBalls>
      <Stack>
        <slot name="main-top" />
      </Stack>
      <slot />
      <Stack>
        <slot name="main-bottom" />
      </Stack>
      </main>

    <!-- Zero slot -->
    <slot name="zero" />
    
    <!-- Footer and footer slot -->
    <footer class="mt-auto">
      <Footer />
      <slot name="footer" />

    </footer>
	</body>
</html>

<style>
  @reference "../styles/global.css";

  .hero-section {
    animation: bgIn 3s ease-in-out;
    /* background-color: var(--color-background); */
  }

  .section-container {
    @apply mx-auto;
  }

</style>
