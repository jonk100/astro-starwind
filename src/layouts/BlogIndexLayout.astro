---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from '../components/header/Header.astro';
import { BlogBreadcrumbs } from '../components/blog';

interface Props {
  title: string;
  description: string;
  showProgress?: boolean;
  showBreadcrumbs?: boolean;
  breadcrumbs?: Array<{label: string; href: string; current?: boolean}>;
}

const { 
  title, 
  description, 
  showBreadcrumbs = true,
  breadcrumbs
} = Astro.props;

const user = Astro.locals.user;

import '@/styles/global.css';
import '@/styles/starwind.css';
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
    <slot name="head" />
	</head>

	<body class="layout-body">

    <!-- Header Slot -->
    <header class="layout-header sticky top-0 z-50">
      <Header user={user} />
      <slot name="header" />
    </header>
    {showBreadcrumbs && (
      <div class="relative top-0 left-0 z-10 text-color-foreground font-size-lg m-0 p-0">
        <BlogBreadcrumbs breadcrumbs={breadcrumbs} />
      </div>
    )}
    
    <!-- Hero / Search Slot -->
     <div class="relative"> 
      <div class="min-h-[90vh] bg-rose-200 my-auto flex items-center justify-center">
        <div class="w-full">
          <slot name="hero-search" />
        </div>
      </div>
    </div>  
      <main>
        <div class="max-w-5xl mx-auto px-4 bg-transparent">
          <slot name="main-top" />
        </div>
        <div class="layout-main-content relative">
          <slot />
        </div>
      </main>

    <footer class="layout-footer">
      <slot name="footer" />
      <Footer />
    </footer>
	</body>
</html>
