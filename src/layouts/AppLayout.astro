---
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import Footer from './Footer.astro';
import type { User } from '@supabase/supabase-js';
import { Toaster } from '@/components/starwind/toast';
import Layout from './Layout.astro';
import '@/styles/global.css';

export const prerender = false;

interface Props {
	title: string;
	description: string;
	user?: User;
	hideGlobalHeader?: boolean;
};



const { title = `App - ${SITE_TITLE}`, description = SITE_DESCRIPTION, user: userProp, hideGlobalHeader = false } = Astro.props;
const user = userProp ?? Astro.locals.user;
---

<Layout title={title} description={description} hideGlobalHeader={hideGlobalHeader}>
  <head>
    <slot name="head" slot="head"/>
  </head>
  <Toaster position="bottom-right" />

	<body class="app-body">
    <slot name="header" slot="header"/>
    <main class="app--main-top">
      <slot name="hero" slot="hero"/>
      <container class="app--main-top-slot">
        <slot name="main-top" slot="main-top"/>
      </container>
      
      <container class="app--main-content-slot">
        <slot />
      </container>
      

      <container class="app--main-bottom-slot">
        <slot name="main-bottom" slot="main-bottom"/>
      </container>

      <container class="app--zero-slot">
        <slot name="zero" slot="zero"/>
      </container>
      <footer class="app--footer-slot">
        <slot name="footer" slot="footer"/>
      </footer>
    </main>
</Layout>

<style>
  .app-body {
    color: var(--color-foreground);
    background-color: var(--color-background);
  }

  :global(html.dark) .app-body {
    color: var(--color-background);
    background-color: var(--color-foreground);
  }
</style>