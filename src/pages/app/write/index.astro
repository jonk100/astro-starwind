---
/**
 * @file src/pages/app/write/index.astro
 * @description Main entry point for the Write app.
 *
 * FIX d: The toolbar is sticky within the write-main column.
 * The write-main column itself does NOT scroll — only write-canvas-wrapper
 * scrolls. This means the toolbar is always visible regardless of doc length.
 *
 * FIX g: Sidebar scroll position is saved to sessionStorage keyed by
 * the active document ID and restored on each page load.
 */

import AppLayout from "@/layouts/AppLayout.astro";
import JournalSidebar from "@/components/apps/write/sidebar/JournalSidebar.astro";
import EditorCanvas from "@/components/apps/write/editor/EditorCanvas.astro";
import { createClient } from "@/lib/supabase";
import { getDocumentIndex, getFolders, getDocumentById } from "@/lib/journal/queries";
import { parseBlocks } from "@/lib/journal/utils";
import type { DocumentIndexRow, Folder, Block } from "@/lib/journal/types";
import { editorActor } from "@/components/apps/write/editor/editorCanvas/editorCanvas.ts";
import TipTop from "@/components/apps/tiptop/TipTop.astro";
import CardDisplayPage from "@/components/apps/write/CardDisplayPage.astro";


export const prerender = false;
const user = Astro.locals.user!;
const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });

const [indexResult, foldersResult] = await Promise.all([
  getDocumentIndex(supabase, user.id),
  getFolders(supabase, user.id),
]);

const documents: DocumentIndexRow[] = indexResult.data ?? [];
const folders: Folder[]             = foldersResult.data ?? [];

const docId = Astro.url.searchParams.get("doc");

let activeBlocks: Block[]     = [];
let activeTitle: string       = "";
let activeDocumentId: string  = "";
let isPinned: boolean         = false;
let isArchived: boolean       = false;

if (docId) {
  const { data: doc, error } = await getDocumentById(supabase, docId, user.id);
  if (doc && !error) {
    activeDocumentId = doc.id;
    activeTitle      = doc.title;
    isPinned         = doc.pinned ?? false;
    isArchived       = doc.is_archived ?? false;
    const parsed     = parseBlocks(doc.content_blocks);
    activeBlocks     = parsed.ok ? parsed.blocks : [];
    // Ensure checklist blocks have meta.checked set
    activeBlocks.forEach((block) => {
      if (block.type === 'checklist') {
        if (block.meta?.checked === undefined) {
          if (!block.meta) block.meta = {};
          block.meta.checked = false;
        }
      }
    });
  }
  console.log('Loaded blocks:', activeBlocks);
  if (editorActor) {
  console.log('Loaded blocks:', activeBlocks);
  editorActor.send({ type: 'BLOCKS_CHANGED', blocks: activeBlocks });
  }
};

const activeFolderId = Astro.url.searchParams.get("folder");
---
<AppLayout title="Write" description="A calm place to think.">
<script type="application/json" id="tiptap-content" set:html={JSON.stringify(activeBlocks)}></script>

  <div id="tiptap-meta" data-document-id={activeDocumentId} hidden slot="head"></div>
   <div class="write-shell">
    <aside class="write-sidebar" id="write-sidebar">
      <JournalSidebar
        documents={documents}
        folders={folders}
        activeDocumentId={activeDocumentId}
        user={user}
        activeFolderId={activeFolderId}
      />
    </aside>
    <div class="write-main">
      <main class="write-canvas-wrapper" id="write-canvas-wrapper">
      {!activeDocumentId ? (
        <CardDisplayPage
          folders={folders}
          documents={documents}
          activeFolderId={activeFolderId}
        />
      ) : (
        <TipTop
          documentId={activeDocumentId}
          title={activeTitle}
          isArchived={isArchived}
          isPinned={isPinned}
          user={user}
        />
      )}
      </main>
    </div>
  </div>
</AppLayout>

<style>
  /*
   * The app shell is a full-viewport grid. Neither column scrolls at this
   * level — each child manages its own internal scroll independently.
   */
  .write-shell {
    display: grid;
    grid-template-columns: 280px 1fr;
    height: calc(100vh - 64px);
    max-height: calc(100vh - 64px);
    overflow: hidden;          /* shell itself never scrolls                  */
    background-color: var(--color-bg);
  }

  /* ── Sidebar ──
   * Scrolls independently. Scroll position is saved/restored by the script
   * below (FIX g).
   */
  .write-sidebar {
    border-right: 1px solid var(--color-border);
    overflow-y: auto;
    height: calc(100vh - 64px);
  }

  /* ── Right panel ──
   * Flex column, overflow:hidden. The toolbar is a flex child with a fixed
   * height — it never grows or shrinks. The canvas wrapper takes the rest.
   * This is what makes the toolbar sticky (FIX d).
   */
  .write-main {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 64px);
    overflow: hidden;
  }

  /* ── Canvas wrapper ──
   * This is the ONLY scrollable area on the right. The toolbar above it
   * is always visible.
   */
  .write-canvas-wrapper {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
  }
</style>

<script>


  /**
   * FIX g: Persist and restore sidebar scroll position across page loads.
   *
   * We use sessionStorage (not localStorage) so the position resets when
   * the browser tab is closed — avoids jarring jumps on cold starts.
   * The key includes the active document ID so switching documents can
   * potentially restore the scroll to where it was for that doc.
   */
  (function restoreSidebarScroll() {
    const sidebar = document.getElementById("write-sidebar");
    if (!sidebar) return;

    const key        = "write:sidebar-scroll";
    const savedPos   = sessionStorage.getItem(key);

    // Restore immediately (before paint) to avoid a visible jump
    if (savedPos) {
      sidebar.scrollTop = parseInt(savedPos, 10);
    }

    // Save on every scroll (throttled to every 200ms)
    let ticking = false;
    sidebar.addEventListener("scroll", () => {
      if (ticking) return;
      ticking = true;
      setTimeout(() => {
        sessionStorage.setItem(key, String(sidebar.scrollTop));
        ticking = false;
      }, 200);
    });
  })();
</script>