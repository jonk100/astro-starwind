---
/**
 * @file src/pages/app/write/index.astro
 * @description Main entry point for the Write app.
 *
 * Renders the two-column shell: sidebar on the left, editor canvas on the right.
 * On first load with no document selected, the canvas shows an empty state.
 *
 * The active document ID is read from the `?doc=` query parameter. When present,
 * the full document is fetched server-side and passed to EditorCanvas for
 * server-rendered initial content. The editor then takes over client-side.
 *
 * Protected by middleware — only authenticated users can reach /app/*.
 */

import AppLayout from "@/layouts/AppLayout.astro";
import JournalSidebar from "@/components/apps/write/sidebar/JournalSidebar.astro";
import JournalToolbar from "@/components/apps/write/toolbar/JournalToolbar.astro";
import EditorCanvas from "@/components/apps/write/editor/EditorCanvas.astro";
import { createClient } from "@/lib/supabase";
import { getDocumentIndex, getFolders, getDocumentById } from "@/lib/journal/queries";
import { parseBlocks } from "@/lib/journal/utils";
import type { DocumentIndexRow, Folder, Block } from "@/lib/journal/types";

// ── Auth ──────────────────────────────────────────────────────────────────────
export const prerender = false;
const user = Astro.locals.user!;
const supabase = createClient({ request: Astro.request, cookies: Astro.cookies });

// ── Data Fetching ─────────────────────────────────────────────────────────────

// Fetch the lightweight index (sidebar) and folders in parallel.
// Never fetch full content_blocks here unless a specific doc is requested.
const [indexResult, foldersResult] = await Promise.all([
  getDocumentIndex(supabase, user.id),
  getFolders(supabase, user.id),
]);

const documents: DocumentIndexRow[] = indexResult.data ?? [];
const folders: Folder[] = foldersResult.data ?? [];

// ── Active Document ───────────────────────────────────────────────────────────
const docId = Astro.url.searchParams.get("doc");

let activeBlocks: Block[] = [];
let activeTitle: string = "";
let activeDocumentId: string | null = null;
let isPinned: boolean = false; // ← declare here with a safe default

if (docId) {
  const { data: doc, error } = await getDocumentById(supabase, docId, user.id);

  if (doc && !error) {
    activeDocumentId = doc.id;
    activeTitle = doc.title;
    isPinned = doc.pinned ?? false; // ← read from the DB row, not the URL

    const parsed = parseBlocks(doc.content_blocks);
    activeBlocks = parsed.ok ? parsed.blocks : [];
  }
}

activeDocumentId = activeDocumentId ?? "";
---

<AppLayout title="Write" description="A calm place to think. Pan around, write freely, style as you go.">
  <div class="write-shell">

    <!-- Left: Sidebar -->
    <aside class="write-sidebar">
      <JournalSidebar
        documents={documents}
        folders={folders}
        activeDocumentId={activeDocumentId}
        user={user}
      />
    </aside>

    <!-- Right: Toolbar + Canvas -->
    <div class="write-main">
      <JournalToolbar
        activeDocumentId={activeDocumentId}
        user={user}
        isPinned={isPinned}
      />

      <main class="write-canvas-wrapper">
        <EditorCanvas
          documentId={activeDocumentId ?? ""}
          title={activeTitle}
          blocks={activeBlocks}
          user={user}
        />
      </main>
    </div>

  </div>
</AppLayout>

<style>
  .write-shell {
    display: grid;
    grid-template-columns: 280px 1fr;
    height: 100vh;
    overflow: hidden;
    background-color: var(--color-bg);
  }

  .write-sidebar {
    border-right: 1px solid var(--color-border);
    overflow-y: auto;
    height: 100vh;
  }

  .write-main {
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }

  .write-canvas-wrapper {
    flex: 1;
    overflow-y: auto;
  }
</style>