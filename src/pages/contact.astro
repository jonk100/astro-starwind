---
import Layout from '@/layouts/Site.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { HeroSection } from '@/components/sectional/hero-section';
import NewsletterSection from '@/components/sectional/misc-section/NewsletterSection.astro';
import FAQSection from '@/components/sectional/faq-section/FAQSection.astro';
import { ContactSection } from '@/components/layout';
import Center from '@/components/layout/primitives/Center.astro';
import SuicideCta from '@/components/sectional/SuicideCta.astro';

export const prerender = false;
---

<Layout 
	title={`Contact Us - ${SITE_TITLE}`} 
	description={SITE_DESCRIPTION}
>
	<HeroSection 
		h="Get In Touch"
		p="We'd love to hear from you. Whether you have questions, feedback, or just want to say hello, our team is here to help."
		imgSrc="https://res.cloudinary.com/dikyfam2c/image/upload/v1734536831/flower_gvof2g.webp"
		imgAlt="Contact us"
		width={2688}
		height={1920}
		slot="hero"
		style="background: linear-gradient(to bottom, var(--purple-5), var(--purple3)) no-repeat;"
	/>

	<section class="contact-info-section">
		<div class="container">
			<h2 class="contact-heading">Ways to Reach Us</h2>
			<p class="contact-subheading">Choose the method that works best for you</p>
			<div class="contact-grid">
				<div class="contact-card">
					<div class="contact-icon">📧</div>
					<h3 class="contact-title">Email Us</h3>
					<p class="contact-text">For general inquiries and support</p>
					<a href="mailto:hello@remindmatters.com" class="contact-link">hello@remindmatters.com</a>
				</div>
				<div class="contact-card">
					<div class="contact-icon">📱</div>
					<h3 class="contact-title">Call Us</h3>
					<p class="contact-text">Mon-Fri, 9am-5pm EST</p>
					<a href="tel:+1234567890" class="contact-link">+1 (234) 567-890</a>
				</div>
				<div class="contact-card">
					<div class="contact-icon">💬</div>
					<h3 class="contact-title">Live Chat</h3>
					<p class="contact-text">Instant support during business hours</p>
					<a href="#" class="contact-link">Start Chat</a>
				</div>
			</div>
		</div>
	</section>

	<section class="contact-form-section">
		<div class="container">
			<h2 class="form-heading">Send Us a Message</h2>
			<p class="form-subheading">Fill out the form below and we'll get back to you within 24 hours</p>
			<form class="contact-form">
				<div class="form-row">
					<div class="form-group">
						<label for="name">Name</label>
						<input type="text" id="name" name="name" required placeholder="Your name" />
					</div>
					<div class="form-group">
						<label for="email">Email</label>
						<input type="email" id="email" name="email" required placeholder="your@email.com" />
					</div>
				</div>
				<div class="form-group">
					<label for="subject">Subject</label>
					<input type="text" id="subject" name="subject" required placeholder="How can we help?" />
				</div>
				<div class="form-group">
					<label for="message">Message</label>
					<textarea id="message" name="message" rows="6" required placeholder="Tell us more about your inquiry..."></textarea>
				</div>
				<button type="submit" class="submit-button">Send Message</button>
			</form>
		</div>
	</section>

	<FAQSection />
	<SuicideCta />


	<section class="cta-section">
		<div class="container">
			<h2 class="cta-heading">Need Immediate Help?</h2>
			<p class="cta-subheading">If you're in crisis or need urgent support, please reach out to emergency services</p>
			<div class="cta-buttons">
				<a href="tel:988" class="cta-button primary">Call 988 (Suicide & Crisis Lifeline)</a>
				<a href="https://www.crisistextline.org" target="_blank" class="cta-button secondary">Text HOME to 741741</a>
			</div>
		</div>
	</section>

	<Center axis="both" class="h-[100vh]">
		<NewsletterSection heading="Stay updated" class="h-em "/>
	</Center>
</Layout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2em;
	}

	.contact-info-section {
		padding: 4em 0;
		background: var(--surface-primary);
	}

	.contact-heading {
		font-size: 2.5em;
		text-align: center;
		margin-bottom: 0.5em;
		color: var(--text-primary);
	}

	.contact-subheading {
		font-size: 1.25em;
		text-align: center;
		margin-bottom: 3em;
		color: var(--text-secondary);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2em;
	}

	.contact-card {
		background: var(--surface-secondary);
		border-radius: 1em;
		padding: 2em;
		text-align: center;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
	}

	.contact-card:hover {
		transform: translateY(-0.5em);
		box-shadow: 0 1em 2em rgba(0, 0, 0, 0.1);
	}

	.contact-icon {
		font-size: 3em;
		margin-bottom: 1em;
	}

	.contact-title {
		font-size: 1.5em;
		margin-bottom: 0.5em;
		color: var(--text-primary);
	}

	.contact-text {
		font-size: 1em;
		color: var(--text-secondary);
		margin-bottom: 1em;
	}

	.contact-link {
		color: var(--primary);
		text-decoration: none;
		font-weight: 600;
		transition: color 0.3s ease;
	}

	.contact-link:hover {
		color: var(--primary-dark);
	}

	.contact-form-section {
		padding: 4em 0;
		background: linear-gradient(to bottom, var(--purple3), var(--purple-5));
	}

	.form-heading {
		font-size: 2.5em;
		text-align: center;
		margin-bottom: 0.5em;
		color: var(--text-primary);
	}

	.form-subheading {
		font-size: 1.25em;
		text-align: center;
		margin-bottom: 3em;
		color: var(--text-secondary);
	}

	.contact-form {
		max-width: 700px;
		margin: 0 auto;
		background: var(--surface-primary);
		padding: 3em;
		border-radius: 1em;
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5em;
	}

	.form-group {
		margin-bottom: 1.5em;
	}

	.form-group label {
		display: block;
		margin-bottom: 0.5em;
		font-weight: 600;
		color: var(--text-primary);
	}

	.form-group input,
	.form-group textarea {
		width: 100%;
		padding: 0.75em;
		border: 2px solid var(--surface-secondary);
		border-radius: 0.5em;
		font-size: 1em;
		transition: border-color 0.3s ease;
		background: var(--surface-secondary);
		color: var(--text-primary);
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--primary);
	}

	.submit-button {
		width: 100%;
		padding: 1em 2em;
		background: var(--primary);
		color: white;
		border: none;
		border-radius: 0.5em;
		font-size: 1.125em;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.submit-button:hover {
		background: var(--primary-dark);
		transform: translateY(-0.125em);
	}

	.cta-section {
		padding: 6em 0;
		background: var(--surface-primary);
		text-align: center;
	}

	.cta-heading {
		font-size: 3em;
		margin-bottom: 1em;
		color: var(--text-primary);
	}

	.cta-subheading {
		font-size: 1.25em;
		margin-bottom: 2em;
		color: var(--text-secondary);
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.cta-buttons {
		display: flex;
		gap: 1em;
		justify-content: center;
		flex-wrap: wrap;
	}

	.cta-button {
		padding: 1em 2em;
		border-radius: 0.5em;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.cta-button.primary {
		background: var(--primary);
		color: white;
	}

	.cta-button.primary:hover {
		background: var(--primary-dark);
		transform: translateY(-0.125em);
	}

	.cta-button.secondary {
		background: var(--surface-secondary);
		color: var(--text-primary);
		border: 2px solid var(--primary);
	}

	.cta-button.secondary:hover {
		background: var(--primary);
		color: white;
		transform: translateY(-0.125em);
	}

	@media (max-width: 768px) {
		.form-row {
			grid-template-columns: 1fr;
		}

		.contact-form {
			padding: 2em;
		}
	}
</style>
