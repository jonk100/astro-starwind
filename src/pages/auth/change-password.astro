---
import Layout from '@/layouts/Layout.astro';
import { createClient } from '@/lib/supabase';
import { Button } from "@/components/starwind/button";
import { InputGroup, InputGroupInput, InputGroupAddon } from "@/components/starwind/input-group";
import Lock from "@tabler/icons/outline/lock.svg";

const supabase = createClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/auth/login');
}
---

<Layout title="Change Password">
  <main class="auth-root">
    <div class="auth-shell">
      <header class="auth-header">
        <Lock class="auth-icon" />
        <h1 class="auth-title">Change Password</h1>
      </header>

      <div class="error-banner" id="error-banner" role="alert" aria-live="assertive" hidden>
        <span class="error-icon" aria-hidden="true">!</span>
        <span id="error-message"></span>
      </div>

      <div class="success-banner" id="success-banner" role="status" aria-live="polite" hidden>
        <span id="success-message"></span>
      </div>

      <form class="auth-form" id="change-password-form" novalidate>
        <div class="field" id="field-current-password">
          <label for="current-password">Current Password</label>
          <InputGroup>
            <InputGroupInput
              id="current-password"
              name="currentPassword"
              type="password"
              autocomplete="current-password"
              required
              placeholder="Enter current password"
            />
            <InputGroupAddon>
              <Lock />
            </InputGroupAddon>
          </InputGroup>
          <span class="field-error" id="error-current-password" aria-live="polite"></span>
        </div>

        <div class="field" id="field-new-password">
          <label for="new-password">New Password</label>
          <InputGroup>
            <InputGroupInput
              id="new-password"
              name="newPassword"
              type="password"
              autocomplete="new-password"
              required
              placeholder="Enter new password"
            />
            <InputGroupAddon>
              <Lock />
            </InputGroupAddon>
          </InputGroup>
          <span class="field-error" id="error-new-password" aria-live="polite"></span>
        </div>

        <div class="field" id="field-confirm-password">
          <label for="confirm-password">Confirm New Password</label>
          <InputGroup>
            <InputGroupInput
              id="confirm-password"
              name="confirmPassword"
              type="password"
              autocomplete="new-password"
              required
              placeholder="Confirm new password"
            />
            <InputGroupAddon>
              <Lock />
            </InputGroupAddon>
          </InputGroup>
          <span class="field-error" id="error-confirm-password" aria-live="polite"></span>
        </div>

        <Button type="submit" variant="primary" id="submit-btn" class="w-full">
          <span class="btn-label">Change Password</span>
          <span class="btn-spinner" aria-hidden="true" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spinner-icon">
              <path d="M12 2v4M12 2v4M12 2v4M12 2v4"/>
            </svg>
          </span>
        </Button>
      </form>

      <div class="auth-nudge">
        <a href="/settings">← Back to Settings</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('change-password-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnLabel = submitBtn?.querySelector('.btn-label') as HTMLSpanElement;
    const btnSpinner = submitBtn?.querySelector('.btn-spinner') as HTMLSpanElement;
    const errorBanner = document.getElementById('error-banner') as HTMLDivElement;
    const errorMsg = document.getElementById('error-message') as HTMLSpanElement;
    const successBanner = document.getElementById('success-banner') as HTMLDivElement;
    const successMsg = document.getElementById('success-message') as HTMLSpanElement;

    function setLoading(loading: boolean) {
      if (submitBtn) {
        submitBtn.disabled = loading;
        if (btnLabel) btnLabel.hidden = loading;
        if (btnSpinner) btnSpinner.hidden = !loading;
        submitBtn.setAttribute('aria-busy', String(loading));
      }
    }

    function showError(message: string) {
      if (errorMsg) errorMsg.textContent = message;
      if (errorBanner) errorBanner.hidden = false;
      if (successBanner) successBanner.hidden = true;
    }

    function showSuccess(message: string) {
      if (successMsg) successMsg.textContent = message;
      if (successBanner) successBanner.hidden = false;
      if (errorBanner) errorBanner.hidden = true;
    }

    function clearErrors() {
      if (errorBanner) errorBanner.hidden = true;
      if (successBanner) successBanner.hidden = true;
      document.querySelectorAll('.field-error').forEach(el => el.textContent = '');
      document.querySelectorAll('.field').forEach(el => el.classList.remove('field--error'));
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();
      setLoading(true);

      const formData = new FormData(form);
      const currentPassword = formData.get('currentPassword') as string;
      const newPassword = formData.get('newPassword') as string;
      const confirmPassword = formData.get('confirmPassword') as string;

      // Client-side validation
      if (newPassword.length < 6) {
        setLoading(false);
        showError('Password must be at least 6 characters long.');
        return;
      }

      if (newPassword !== confirmPassword) {
        setLoading(false);
        showError('New passwords do not match.');
        return;
      }

      try {
        const response = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            currentPassword,
            newPassword,
          }),
        });

        const result = await response.json();

        if (result.success) {
          showSuccess('Password changed successfully!');
          form.reset();
          setTimeout(() => {
            window.location.href = '/settings';
          }, 2000);
        } else {
          showError(result.error || 'Failed to change password.');
        }
      } catch (err) {
        setLoading(false);
        showError('A network error occurred. Please try again.');
        console.error('[change-password] error:', err);
      }

      setLoading(false);
    });
  });
</script>

<style>
  .auth-root {
    min-height: 100dvh;
    display: grid;
    place-items: start center;
    padding: 2rem 1rem;
  }

  .auth-shell {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 3rem;
    border-radius: 0.75rem;
    background-color: var(--color-teal-500);
    box-shadow: var(--shadow);
  }

  .auth-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .auth-icon {
    width: 2rem;
    height: 2rem;
    color: var(--foreground);
  }

  .auth-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--foreground);
    margin: 0;
  }

  .error-banner,
  .success-banner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.85rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .error-banner {
    border: 1px solid var(--color-border-danger);
    background: color-mix(in srgb, var(--color-background-danger) 60%, transparent);
    color: var(--color-text-danger);
  }

  .success-banner {
    border: 1px solid var(--color-border-success);
    background: color-mix(in srgb, var(--color-background-success) 60%, transparent);
    color: var(--color-text-success);
  }

  .error-icon {
    flex-shrink: 0;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    display: grid;
    place-items: center;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .field-error {
    font-size: 0.75rem;
    color: var(--color-text-danger);
    min-height: 1em;
    line-height: 1.3;
  }

  .field--error .input-group {
    border-color: var(--color-border-danger);
  }

  .auth-nudge {
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
    margin: 0;
  }

  .auth-nudge a {
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border-tertiary);
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .auth-nudge a:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-secondary);
  }

  .spinner-icon {
    width: 1rem;
    height: 1rem;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 768px) {
    .auth-root {
      padding: 1rem 0.5rem;
    }

    .auth-shell {
      padding: 2rem;
      gap: 1rem;
    }
  }
</style>
