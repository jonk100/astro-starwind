---
import Layout from '@/layouts/Layout.astro';
import { createClient } from '@/lib/supabase';
import { Button } from "@/components/starwind/button";
import { InputGroup, InputGroupInput, InputGroupAddon } from "@/components/starwind/input-group";
import SettingsIcon from "@tabler/icons/outline/settings.svg";
import User from "@tabler/icons/outline/user.svg";
import Shield from "@tabler/icons/outline/shield.svg";
import Cookie from "@tabler/icons/outline/cookie.svg";

export const prerender = false;


// Get user data
const supabase = createClient(Astro);
const { data: { user } } = await supabase.auth.getUser();

// Redirect if not logged in
if (!user) {
  return Astro.redirect('/auth/login');
}
---

<Layout title="Settings">
  <main class="settings-root">
    <div class="settings-shell">
      <header class="settings-header">
        <SettingsIcon class="settings-icon" />
        <h1 class="settings-title">Settings</h1>
      </header>

      <section class="settings-section">
        <h2 class="section-title">
          <User class="section-icon" />
          Profile
        </h2>
        
        <div class="form-group">
          <label for="email">Email</label>
          <InputGroup>
            <InputGroupInput
              id="email"
              name="email"
              type="email"
              value={user?.email || ''}
              readonly
              disabled
            />
            <InputGroupAddon>
              <User />
            </InputGroupAddon>
          </InputGroup>
        </div>
      </section>

      <section class="settings-section">
        <h2 class="section-title">
          <Cookie class="section-icon" />
          Privacy & Cookies
        </h2>
        
        <div class="consent-section">
          <p class="consent-description">
            Manage your privacy preferences and cookie settings for this site.
          </p>
          
          <div class="consent-actions">
            <Button 
              variant="outline" 
              class="consent-button"
              onclick="showCookiePreferences()"
            >
              <Cookie class="button-icon" />
              Manage Cookie Preferences
            </Button>
          </div>
        </div>
      </section>

      <section class="settings-section">
        <h2 class="section-title">
          <Shield class="section-icon" />
          Security
        </h2>
        
        <div class="security-actions">
          <Button 
            variant="outline" 
            class="security-button"
            onclick="window.location.href='/auth/change-password'"
          >
            Change Password
          </Button>
          
          <form method="POST" action="/api/auth/logout" class="logout-form">
            <Button type="submit" variant="error" class="logout-button">
              Sign Out
            </Button>
          </form>
        </div>
      </section>
    </div>
  </main>
</Layout>

<script is:inline>
  function showCookiePreferences() {
    // Try to find the cookie consent banner and modal elements
    const banner = document.getElementById('astro-consent-banner');
    const modal = document.getElementById('astro-consent-modal');
    
    if (banner && modal) {
      // Add the cb-visible class to show the modal
      // Add cb-mode-overlay to ensure it shows as an overlay modal
      banner.classList.add('cb-mode-overlay', 'cb-visible');
      modal.classList.add('cb-visible');
      
      // Set focus to the modal for accessibility
      modal.focus();
      
      // Set up toggle monitoring after modal is visible
      setTimeout(setupToggleMonitoring, 100);
    } else {
      // If the elements don't exist, it might mean astro-consent hasn't initialized yet
      // Try to reset consent to trigger the banner
      const astroConsent = window.astroConsent;
      if (astroConsent && astroConsent.reset) {
        astroConsent.reset();
      } else {
        console.warn('Cookie consent not available');
        alert('Cookie preferences are not available. Please refresh the page and try again.');
      }
    }
  }

  function setupToggleMonitoring() {
    // Find all toggle buttons in the cookie modal
    const toggles = document.querySelectorAll('#astro-consent-modal .cb-toggle');
    const acceptButton = document.querySelector('#astro-consent-modal .cb-accept');
    
    if (!toggles.length || !acceptButton) {
      // If elements aren't found, try again after a short delay
      setTimeout(setupToggleMonitoring, 200);
      return;
    }

    function updateButtonText() {
      // Check if analytics and marketing toggles are active
      let allOptionalEnabled = true;
      
      toggles.forEach((toggle, index) => {
        // Skip the first toggle (essential) since it's always on
        if (index > 0 && !toggle.classList.contains('active')) {
          allOptionalEnabled = false;
        }
      });

      // Update button text based on toggle states
      if (allOptionalEnabled) {
        acceptButton.textContent = 'Accept all';
      } else {
        acceptButton.textContent = 'Accept';
      }
    }

    // Add click listeners to all toggles
    toggles.forEach(toggle => {
      toggle.addEventListener('click', updateButtonText);
    });

    // Set initial button text
    updateButtonText();
  }

  // Also set up monitoring when the modal is shown normally (not via settings page)
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
        const modal = document.getElementById('astro-consent-modal');
        if (modal && modal.classList.contains('cb-visible')) {
          setTimeout(setupToggleMonitoring, 100);
        }
      }
    });
  });

  // Start observing the modal for changes
  const modalToObserve = document.getElementById('astro-consent-modal');
  if (modalToObserve) {
    observer.observe(modalToObserve, { attributes: true });
  } else {
    // If modal doesn't exist yet, wait for it
    setTimeout(() => {
      const modal = document.getElementById('astro-consent-modal');
      if (modal) {
        observer.observe(modal, { attributes: true });
      }
    }, 1000);
  }
</script>

<style>
  .settings-root {
    min-height: 100dvh;
    display: grid;
    place-items: start center;
    padding: 2rem 1rem;
  }

  .settings-shell {
    width: 100%;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2.5rem;
    border-radius: 0.75rem;
    background-color: var(--color-teal-500);
    box-shadow: var(--shadow);
  }

  .settings-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .settings-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--foreground);
  }

  .settings-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--foreground);
    margin: 0;
  }

  .settings-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--foreground);
    margin: 0 0 1rem 0;
  }

  .section-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--muted-foreground);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .consent-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .consent-description {
    color: var(--muted-foreground);
    line-height: 1.6;
    margin: 0;
  }

  .consent-actions {
    display: flex;
    gap: 1rem;
  }

  .consent-button {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .button-icon {
    width: 1rem;
    height: 1rem;
  }

  .security-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .logout-form {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
  }

  @media (max-width: 768px) {
    .settings-root {
      padding: 1rem 0.5rem;
    }

    .settings-shell {
      padding: 1.5rem;
      gap: 1.5rem;
    }

    .consent-actions,
    .security-actions {
      flex-direction: column;
    }
  }
</style>
