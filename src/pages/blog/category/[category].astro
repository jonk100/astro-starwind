---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import { ThreeColumnGrid, BlogSearch } from '@/components/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // Extract all unique categories
  const categories = new Set<string>();
  posts.forEach(post => {
    if (post.data.categories) {
      post.data.categories.forEach(category => {
        categories.add(category);
      });
    }
  });

  // Create paths for each category
  return Array.from(categories).map((category) => ({
    params: { category },
    props: { posts: posts.filter(post => post.data.categories?.includes(category)) }
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;

// Sort posts by date
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Convert posts to blog component format
const postsData = sortedPosts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body
}));
---
<BlogIndexLayout 
  title={`${category} - ${SITE_TITLE}`} 
  description={`${SITE_DESCRIPTION} - Posts in ${category} category`}
  showProgress={true}
  breadcrumbs={[
    { label: 'Home', href: '/' }, 
    { label: 'Blog', href: '/blog' }, 
    { label: 'Categories', href: '/blog/categories' },
    { label: category, href: `/blog/category/${category}`, current: true }
  ]}
>
  <div class="space-y-12">
    <!-- Header Section -->
    <div class="text-center space-y-4">
      <h1 class="text-4xl lg:text-6xl font-bold text-[rgb(var(--purple))]">{category}</h1>
      <p class="text-xl text-muted-foreground">
        {sortedPosts.length} {sortedPosts.length === 1 ? 'post' : 'posts'} in this category
      </p>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        Explore all articles related to {category}. Discover insights, tips, and stories on this topic.
      </p>
    </div>

    <!-- Search Section -->
    <div class="max-w-2xl mx-auto">
      <BlogSearch posts={postsData} placeholder={`Search articles in ${category}...`} showFilters={false} />
    </div>

    <!-- Posts Grid -->
    {postsData.length > 0 ? (
      <section class="space-y-6">
        <h2 class="text-2xl font-semibold text-[rgb(var(--purple))] text-center">
          {sortedPosts.length} {sortedPosts.length === 1 ? 'Article' : 'Articles'} Found
        </h2>
        <ThreeColumnGrid 
          posts={postsData}
          cardVariant="default"
          showImage={true}
          showTags={true}
          showAuthor={true}
          showReadTime={true}
        />
      </section>
    ) : (
      <div class="text-center py-16 space-y-4">
        <h2 class="text-2xl font-semibold text-muted-foreground">
          No posts found in {category}
        </h2>
        <p class="text-muted-foreground">
          Check back later for new content in this category.
        </p>
        <a 
          href="/blog/" 
          class="inline-block px-6 py-3 bg-[rgb(var(--accent))] text-white rounded-lg font-medium hover:bg-[rgb(var(--accent-dark))] transition-colors"
        >
          Back to Blog
        </a>
      </div>
    )}
  </div>
</BlogIndexLayout>
