---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import { ThreeColumnGrid, BlogSearch } from '@/components/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // Extract all unique tags
  const tags = new Set<string>();
  posts.forEach(post => {
    if (post.data.tags) {
      post.data.tags.forEach(tag => {
        tags.add(tag);
      });
    }
  });

  // Create paths for each tag
  return Array.from(tags).map(tag => ({
    params: { tag },
    props: { 
      posts: posts.filter(post => post.data.tags?.includes(tag)),
      allTags: Array.from(tags)
    }
  }));
}

const { tag } = Astro.params;
const tagString = tag as string;
const { posts, allTags } = Astro.props;

// Sort posts by date
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Convert posts to blog component format
const postsData = sortedPosts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body
}));

// Color mapping for tags
const tagColors: { [key: string]: string } = {
  'mental health': 'from-blue-500 to-indigo-600',
  'mindfulness': 'from-green-500 to-emerald-600', 
  'stress management': 'from-yellow-500 to-orange-600',
  'anxiety': 'from-red-500 to-pink-600',
  'self-care': 'from-purple-500 to-pink-600',
  'educational': 'from-cyan-500 to-blue-600',
  'cognitive': 'from-indigo-500 to-purple-600',
  'emotional regulation': 'from-pink-500 to-rose-600',
  'sleep': 'from-blue-500 to-indigo-600',
  'well-being': 'from-teal-500 to-cyan-600'
};

const getTagGradient = (tag: string) => {
  return tagColors[tag.toLowerCase()] || 'from-gray-500 to-slate-600';
};
---
<BlogIndexLayout 
  title={`${tagString} - ${SITE_TITLE}`} 
  description={`${SITE_DESCRIPTION} - Posts tagged with ${tagString}`}
  showProgress={true}
  breadcrumbs={[
    { label: 'Home', href: '/' }, 
    { label: 'Blog', href: '/blog' }, 
    { label: 'Tags', href: '/blog/tags' },
    { label: tagString, href: `/blog/tag/${tagString}`, current: true }
  ]}
>
  <div class="space-y-12">
    <!-- Tag Header -->
    <div class="text-center space-y-6">
      <div class={`inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r ${getTagGradient(tagString)} text-white font-bold text-xl shadow-2xl`}>
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
        </svg>
        {tagString}
      </div>
      <p class="text-2xl text-muted-foreground max-w-3xl mx-auto">
        Explore <span class="font-bold text-[rgb(var(--purple))]">{sortedPosts.length}</span> article{sortedPosts.length !== 1 ? 's' : ''} about <span class="font-bold text-[rgb(var(--accent))]">{tagString}</span>
      </p>
    </div>

    <!-- All Tags Navigation -->
    <div class="max-w-6xl mx-auto">
      <h3 class="text-xl font-semibold text-center mb-6 text-[rgb(var(--purple))]">Browse All Tags</h3>
      <div class="flex flex-wrap gap-3 justify-center">
        {allTags.map((t: string) => (
          <a 
            href={`/blog/tag/${t}`}
            class={`inline-flex items-center gap-2 px-4 py-2 rounded-full font-medium transition-all duration-200 hover:scale-105 hover:shadow-lg ${
              t === tag 
                ? `bg-gradient-to-r ${getTagGradient(t)} text-white shadow-xl scale-105` 
                : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'
            }`}
          >
            <span class="w-2 h-2 rounded-full bg-current opacity-60"></span>
            {t}
          </a>
        ))}
      </div>
    </div>

    <!-- Search Section -->
    <div class="max-w-2xl mx-auto">
      <BlogSearch posts={postsData} placeholder={`Search "${tagString}" articles...`} showFilters={true} />
    </div>

    <!-- Articles Grid -->
    <div class="space-y-8">
      <div class="text-center space-y-4">
        <h2 class="text-3xl font-bold text-[rgb(var(--purple))]">
          {tagString} Articles
        </h2>
        <div class={`inline-block px-6 py-2 bg-gradient-to-r ${getTagGradient(tagString)} text-white rounded-full text-sm font-semibold`}>
          {sortedPosts.length} {sortedPosts.length === 1 ? 'Article' : 'Articles'}
        </div>
      </div>
      
      {postsData.length > 0 ? (
        <ThreeColumnGrid 
          posts={postsData}
          cardVariant="colorful"
          showImage={true}
          showTags={true}
          showAuthor={true}
          showReadTime={true}
        />
      ) : (
        <div class="text-center py-16 space-y-6">
          <div class="w-24 h-24 mx-auto bg-gray-100 dark:bg-gray-800 rounded-full flex items-center justify-center">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656-1.659l4-4a4 4 0 010-5.656l-4-4a4 4 0 00-5.656 0L4 8.586V12a4 4 0 004 4h4a2 2 0 002-2V8.586z" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold text-muted-foreground">
            No articles found for "{tagString}"
          </h3>
          <p class="text-muted-foreground max-w-md mx-auto">
            Try browsing other tags or check back later for new content.
          </p>
          <a 
            href="/blog/" 
            class="inline-flex items-center gap-2 px-6 py-3 bg-[rgb(var(--accent))] text-white rounded-lg font-medium hover:bg-[rgb(var(--accent-dark))] transition-all duration-200 hover:scale-105"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Back to All Articles
          </a>
        </div>
      )}
    </div>
  </div>
</BlogIndexLayout>
