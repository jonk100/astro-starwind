---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import { ThreeColumnGrid, BlogSearch, type BlogPost } from '@/components/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { RecentPostsCarousel } from '@/components/blog/RecentPosts';
import BlogHero from '@/components/sections/blog/BlogHero.astro';
import MinimalBlogSection from '@/components/sections/blog/MinimalBlogSection.astro';
import BgBalls from '@/layouts/BgBalls.astro';

export const prerender = false;

// Get all blog posts sorted by date (newest first)
const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

// Extract recent posts (excluding the first one which is featured)
const recentPosts: BlogPost[] = posts.slice(1, 7).map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body,
}));

// Prepare all posts data for the search component
const allPostsData = posts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body,
}));
---

<BlogIndexLayout
  title={`All Posts - ${SITE_TITLE}`}
  description={`${SITE_DESCRIPTION} | Blog posts`}
  showBreadcrumbs={false}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog', current: true },
  ]}
>
  <BlogHero
    heading="Our Sanctuary Journal"
    subheading="Delve into deep-dive essays, evidence-based self-care guides, and cognitive science breakthroughs centered around active renewal and emotional restoration."
    variant="card"
    slot="hero-search"
  >
    <BlogSearch
      posts={allPostsData}
      placeholder="Search articles..."
      showFilters={true}
    />
    <a
      href="/blog/tags"
      class="
        px-5
        py-2
        rounded-lg
        border
        border-border
        text-sm
        font-medium
        hover:bg-muted
        transition-colors
        font-sans
      "
    >
      Browse by Tag
    </a>
    <a
      href="/app/journal"
      class="
        px-5
        py-2
        rounded-lg
        bg-primary
        text-primary-foreground
        text-sm
        font-medium
        hover:bg-primary/95
        transition-colors
        font-sans
      "
    >
      Open Write Sanctuary →
    </a>
  </div>
  </BlogHero>


  <div slot="main-top" class=
    "flex items-center justify-center h-[70vh] w-screen relative left-1/2
      -translate-x-1/2 bg-background py-8 my-auto
    "
  >
    <div class=
      "max-w-5xl mx-auto px-4 w-full"
    >
      <RecentPostsCarousel
        recentPosts={recentPosts}
      >
        <BgBalls />
      </RecentPostsCarousel>
    </div>

  </div>

  <!-- Main Content Section -->
  <section class=
    "my-auto space-y-4 mx-auto py-16 px-6 max-w-5xl"
  >
    <h2 
      class="text-3xl font-serif font-semibold text-primary"
    >
      Featured micro-reflections:
    </h2>

    <MinimalBlogSection 
      variant="blog" 
      o="long" 
      i={2}
      style="width:auto"
    />
  </section>


  <section class="my-auto space-y-4 mx-auto py-16 px-6 max-w-5xl">
    <ThreeColumnGrid
      posts={allPostsData}
      cardVariant="colorful"
      showImage={true}
      showTags={true}
      showAuthor={true}
      showReadTime={true}
    />
  </section>


</BlogIndexLayout>