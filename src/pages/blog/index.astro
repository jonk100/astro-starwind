---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import { ThreeColumnGrid, BlogSearch } from '@/components/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { RecentPostsCarousel } from '@/components/blog/RecentPosts';
import BlogHero from '@/components/layout/BlogHero.astro';

export const prerender = false;

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

const recentPosts = posts.slice(1, 7);

const allPostsData = posts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body,
}));
---

<BlogIndexLayout
  title={`All Posts - ${SITE_TITLE}`}
  description={`${SITE_DESCRIPTION} | Blog posts`}
  showBreadcrumbs={false}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog', current: true },
  ]}
>
  <div slot="hero-search">
    <BlogHero
      heading="All Posts"
      subheading="Explore our latest articles, insights, and stories on technology, design, and development."
      variant="card"
    >
      <BlogSearch
        posts={allPostsData}
        placeholder="Search articles..."
        showFilters={true}
      />
    </BlogHero>
  </div>

  <div
    slot="main-top"
    class="w-screen relative left-1/2 -translate-x-1/2 bg-primary dark:bg-slate-900 py-8"
  >
    <div class="max-w-5xl mx-auto px-4">
      <RecentPostsCarousel recentPosts={recentPosts} />
    </div>
  </div>

  <section class="space-y-6">
    <h2 class="text-2xl font-semibold text-[rgb(var(--purple))]">All Articles</h2>
    <ThreeColumnGrid
      posts={allPostsData}
      cardVariant="colorful"
      showImage={true}
      showTags={true}
      showAuthor={true}
      showReadTime={true}
    />
  </section>
</BlogIndexLayout>