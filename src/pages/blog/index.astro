---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import { HeroCard, ThreeColumnGrid, BlogSearch, BlogCardCarousel } from '@/components/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { RecentPostsCarousel } from '@/components/blog/RecentPosts';

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);

const featuredPost = posts[0];
const recentPosts = posts.slice(1, 7);
const allPostsData = posts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body
}));
---

<BlogIndexLayout 
  title={`${SITE_TITLE} | Blog`} 
  description={`${SITE_DESCRIPTION} | Blog posts`}
  showProgress={true}
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog', current: true }]}
>
  <div class="space-y-12">
    <!-- Hero Section -->
    <div class="text-center space-y-4">
      <h1 class="text-4xl lg:text-6xl font-bold text-[rgb(var(--purple))]">Blog</h1>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
        Explore our latest articles, insights, and stories on technology, design, and development.
      </p>
    </div>

    <!-- Search Section -->
    <div class="max-w-2xl mx-auto">
      <BlogSearch posts={allPostsData} placeholder="Search articles..." showFilters={true} />
    </div>

    <!-- Featured Post -->
    <!-- {featuredPost && (
      <section class="space-y-6">
        <h2 class="text-2xl font-semibold text-[rgb(var(--purple))]">Featured Article</h2>
        <HeroCard 
          post={{ ...featuredPost.data, slug: featuredPost.id }}
          style="modern"
          href={`/blog/${featuredPost.id}`}
        />
      </section>
    )} -->

    <!-- Recent Posts Carousel -->
    <RecentPostsCarousel recentPosts={recentPosts} />

    <!-- All Posts Grid -->
    <section class="space-y-6">
      <h2 class="text-2xl font-semibold text-[rgb(var(--purple))]">All Articles</h2>
      <ThreeColumnGrid 
        posts={allPostsData}
        cardVariant="colorful"
        showImage={true}
        showTags={true}
        showAuthor={true}
        showReadTime={true}
      />
    </section>
  </div>
</BlogIndexLayout>