---
import { getCollection } from 'astro:content';
import BaseHead from '@/layouts/BaseHead.astro';
import Header from '@/components/header/Header.astro';
import Footer from '@/layouts/Footer.astro';
import Layout from '@/layouts/Layout.astro';
// import BlogHeader from '@/layouts/BlogHeader.astro';
// import BlogPreviewCard from '@/components/BlogPreviewCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);
---
<Layout title={`${SITE_TITLE} | Blog`} description={`${SITE_DESCRIPTION} | Blog posts`}>
		<div class="blog-hero">
			<div class="blog-hero-content">
				<h1>Blog</h1>
				<p>Explore our latest articles, insights, and stories on technology, design, and development.</p>
			</div>
		</div>
		<container class="blog-index-page-container">
		<main>
			<section>
				<ul class="blog-grid">
					{
						posts.map((post, index) => (
							<li>
								{/* <BlogPreviewCard 
									post={post} 
									isFeatured={index === 0}
									variant="default"
								/> */}
							</li>
						))
					}
				</ul>
			</section>
		</container>
</Layout>

<style>
	.blog-index-page-container {
		display: flex;
		flex-direction: column;
		max-width: 960px;
		margin: 0 auto;
	}
	.blog-index-page-container h1 {
		text-align: center;
	}
</style>