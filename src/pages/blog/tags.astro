---
import { getCollection } from 'astro:content';
import BaseHead from '@/layouts/BaseHead.astro';
import Footer from '@/layouts/Footer.astro';

import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

// Get all posts and extract tags
const posts = await getCollection('blog');

// Extract and organize tags
const tagMap = new Map();
posts.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      if (!tagMap.has(tag)) {
        tagMap.set(tag, []);
      }
      tagMap.get(tag).push(post);
    });
  }
});

// Sort tags alphabetically and by post count
const sortedTags = Array.from(tagMap.entries())
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([tag, tagPosts]) => ({
    name: tag,
    posts: tagPosts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()),
    count: tagPosts.length
  }));

// Sort by post count (descending) for popular tags
const tagsByCount = [...sortedTags].sort((a, b) => b.count - a.count);

// Group tags alphabetically for better organization
const tagsByLetter = {};
sortedTags.forEach(tag => {
  const firstLetter = tag.name.charAt(0).toUpperCase();
  if (!tagsByLetter[firstLetter]) {
    tagsByLetter[firstLetter] = [];
  }
  tagsByLetter[firstLetter].push(tag);
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Tags - ${SITE_TITLE}`} description={`${SITE_DESCRIPTION} - Browse all blog tags`} />
    <style>
      .tags-header {
        text-align: center;
        margin-bottom: 3rem;
        padding: 2rem 0;
      }

      .tags-title {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 1rem;
        color: var(--text-primary, #111827);
      }

      .tags-description {
        font-size: 1.25rem;
        color: var(--text-secondary, #6b7280);
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
      }

      .tags-stats {
        display: flex;
        justify-content: center;
        gap: 2rem;
        margin: 2rem 0;
        flex-wrap: wrap;
      }

      .stat {
        text-align: center;
      }

      .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: var(--accent, #3b82f6);
      }

      .stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .popular-tags {
        margin-bottom: 3rem;
      }

      .section-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        text-align: center;
        color: var(--text-primary, #111827);
      }

      .popular-cloud {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        margin-bottom: 2rem;
      }

      .tag-cloud-item {
        background: var(--accent, #3b82f6);
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 9999px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .tag-cloud-item:hover {
        background: var(--accent-dark, #2563eb);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
      }

      .post-count {
        background: rgba(255, 255, 255, 0.2);
        padding: 0.25rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.75rem;
      }

      .alphabetical-section {
        margin-bottom: 2rem;
      }

      .letter-header {
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        color: var(--text-primary, #111827);
        border-bottom: 2px solid var(--accent, #3b82f6);
        padding-bottom: 0.5rem;
        display: inline-block;
      }

      .tags-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .tag-card {
        background: var(--bg-primary, #ffffff);
        border: 1px solid var(--border, #e5e7eb);
        border-radius: 8px;
        padding: 1.5rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
        color: inherit;
        display: block;
      }

      .tag-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.1));
      }

      .tag-name {
        font-size: 1.125rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
        color: var(--text-primary, #111827);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .tag-icon {
        width: 1.25em;
        height: 1.25em;
        opacity: 0.7;
      }

      .tag-count {
        font-size: 1rem;
        color: var(--text-secondary, #6b7280);
        margin-bottom: 0.75rem;
      }

      .tag-posts {
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border, #e5e7eb);
      }

      .tag-posts-title {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-secondary, #6b7280);
        margin-bottom: 0.5rem;
      }

      .recent-posts {
        list-style-type: none;
        padding: 0;
        margin: 0;
      }

      .recent-post {
        font-size: 0.8rem;
        color: var(--text-secondary, #6b7280);
        margin-bottom: 0.25rem;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .recent-post:hover {
        color: var(--accent, #3b82f6);
      }

      .no-tags {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-secondary, #6b7280);
      }

      .back-to-blog {
        display: inline-block;
        margin: 2rem auto;
        padding: 0.75rem 1.5rem;
        background: var(--bg-secondary, #f3f4f6);
        color: var(--text-primary, #111827);
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: background-color 0.2s ease;
        border: 1px solid var(--border, #e5e7eb);
      }

      .back-to-blog:hover {
        background: var(--accent, #3b82f6);
        color: white;
        border-color: var(--accent, #3b82f6);
      }

      @media (max-width: 768px) {
        .tags-title {
          font-size: 2rem;
        }

        .tags-grid {
          grid-template-columns: 1fr;
          gap: 1rem;
        }

        .tags-stats {
          gap: 1rem;
        }

        .stat-number {
          font-size: 1.5rem;
        }

        .popular-cloud {
          gap: 0.75rem;
        }

        .tag-cloud-item {
          padding: 0.5rem 1rem;
          font-size: 0.875rem;
        }
      }

      @media (max-width: 480px) {
        .tags-header {
          margin-bottom: 2rem;
          padding: 1rem 0;
        }

        .tags-title {
          font-size: 1.75rem;
        }

        .tag-card {
          padding: 1rem;
        }

        .letter-header {
          font-size: 1.25rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- <BlogHeader /> -->
    
    <container class="blog-index-page-container">
      <div class="tags-header">
        <h1 class="tags-title">Tags</h1>
        <p class="tags-description">
          Browse all blog tags to find specific topics. Tags help organize content by specific themes and keywords.
        </p>
        
        <div class="tags-stats">
          <div class="stat">
            <div class="stat-number">{sortedTags.length}</div>
            <div class="stat-label">Tags</div>
          </div>
          <div class="stat">
            <div class="stat-number">{posts.length}</div>
            <div class="stat-label">Total Posts</div>
          </div>
        </div>
      </div>

      <main>
        {tagsByCount.length > 0 && (
          <div class="popular-tags">
            <h2 class="section-title">Popular Tags</h2>
            <div class="popular-cloud">
              {tagsByCount.slice(0, 20).map(({ name, count }) => (
                <a href={`/blog/tag/${name}/`} class="tag-cloud-item">
                  #{name}
                  <span class="post-count">{count}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {sortedTags.length > 0 ? (
          <div class="alphabetical-section">
            <h2 class="section-title">All Tags</h2>
            {Object.entries(tagsByLetter).map(([letter, tags]) => (
              <div style="margin-bottom: 2rem;">
                <h3 class="letter-header">{letter}</h3>
                <div class="tags-grid">
                  {tags.map(({ name, posts, count }) => (
                    <a href={`/blog/tag/${name}/`} class="tag-card">
                      <div class="tag-name">
                        <svg class="tag-icon" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M17.707 9.293a1 1 0 010 1.414l-7 7a1 1 0 01-1.414 0l-7-7A.997.997 0 012 10V5a3 3 0 013-3h5c.256 0 .512.098.707.293l7 7zM5 6a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd"/>
                        </svg>
                        {name}
                      </div>
                      <p class="tag-count">{count} {count === 1 ? 'post' : 'posts'}</p>
                      
                      {posts.length > 0 && (
                        <div class="tag-posts">
                          <h4 class="tag-posts-title">Recent Posts</h4>
                          <ul class="recent-posts">
                            {posts.slice(0, 3).map(post => (
                              <li>
                                <a href={`/blog/${post.id}/`} class="recent-post">
                                  {post.data.title}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="no-tags">
            <h2>No tags found</h2>
            <p>Check back later for tagged content.</p>
          </div>
        )}

        <div style="text-align: center;">
          <a href="/blog/" class="back-to-blog">← Back to Blog</a>
        </div>
      </main>

      <Footer />
    </container>
  </body>
</html>

<style>
  .blog-index-page-container {
    display: flex;
    flex-direction: column;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
