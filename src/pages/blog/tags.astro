---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import { BlogSearch, MasonryGrid } from '@/components/blog';
import { Badge } from '@/components/starwind/badge';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

// Get all posts and extract tags
const posts = await getCollection('blog');

// Extract and organize tags
const tagMap = new Map<string, any[]>();
posts.forEach(post => {
  if (post.data.tags) {
    post.data.tags.forEach(tag => {
      if (!tagMap.has(tag)) {
        tagMap.set(tag, []);
      }
      tagMap.get(tag)?.push(post);
    });
  }
});

// Sort tags alphabetically and by post count
const sortedTags = Array.from(tagMap.entries())
  .sort(([a]: [string, any[]], [b]: [string, any[]]) => a.localeCompare(b))
  .map(([tag, tagPosts]) => ({
    name: tag,
    posts: tagPosts.sort((a: any, b: any) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()),
    count: tagPosts.length
  }));

// Sort by post count (descending) for popular tags
const tagsByCount = [...sortedTags].sort((a, b) => b.count - a.count);

// Group tags alphabetically for better organization
const tagsByLetter: Record<string, typeof sortedTags> = {};
sortedTags.forEach(tag => {
  const firstLetter = tag.name.charAt(0).toUpperCase();
  if (!tagsByLetter[firstLetter]) {
    tagsByLetter[firstLetter] = [];
  }
  tagsByLetter[firstLetter].push(tag);
});

// Convert posts to blog component format
const allPostsData = posts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body
}));
---
<BlogIndexLayout 
  title={`Tags - ${SITE_TITLE}`} 
  description={`${SITE_DESCRIPTION} - Browse all blog tags`}
  showProgress={true}
  breadcrumbs={[
    { label: 'Home', href: '/' }, 
    { label: 'Blog', href: '/blog' }, 
    { label: 'Tags', href: '/blog/tags', current: true }
  ]}
>
  <div class="space-y-12">
    <!-- Header Section -->
    <div class="text-center space-y-4">
      <h1 class="text-4xl lg:text-6xl font-bold text-[rgb(var(--purple))]">Tags</h1>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
        Browse all blog tags to find specific topics. Tags help organize content by specific themes and keywords.
      </p>
      
      <div class="flex justify-center gap-8 flex-wrap">
        <div class="text-center">
          <div class="text-3xl font-bold text-[rgb(var(--accent))]">{sortedTags.length}</div>
          <div class="text-sm text-muted-foreground uppercase tracking-wide">Tags</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-[rgb(var(--accent))]">{posts.length}</div>
          <div class="text-sm text-muted-foreground uppercase tracking-wide">Total Posts</div>
        </div>
      </div>
    </div>

    <!-- Search Section -->
    <div class="max-w-2xl mx-auto">
      <BlogSearch posts={allPostsData} placeholder="Search articles by tag..." showFilters={true} />
    </div>

    <!-- Popular Tags -->
    {tagsByCount.length > 0 && (
      <section class="space-y-6">
        <h2 class="text-2xl font-semibold text-[rgb(var(--purple))] text-center">Popular Tags</h2>
        <div class="flex flex-wrap justify-center gap-3">
          {tagsByCount.slice(0, 20).map((tagData) => (
            <a 
              href={`/blog/tag/${tagData.name}/`}
              class="inline-flex items-center gap-2 px-4 py-2 bg-[rgb(var(--accent))] text-white rounded-full font-medium hover:bg-[rgb(var(--accent-dark))] transition-colors"
            >
              #{tagData.name}
              <span class="bg-white/20 px-2 py-0.5 rounded-full text-xs">
                {tagData.count}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- All Tags Grid -->
    {sortedTags.length > 0 ? (
      <section class="space-y-8">
        <h2 class="text-2xl font-semibold text-[rgb(var(--purple))] text-center">All Tags</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedTags.map((tagData) => (
            <a 
              href={`/blog/tag/${tagData.name}/`}
              class="block p-6 border border-border rounded-lg hover:border-[rgb(var(--accent))] hover:shadow-lg transition-all group"
            >
              <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 bg-[rgb(var(--accent))] text-white rounded-full flex items-center justify-center text-sm font-bold">
                  #
                </div>
                <h3 class="text-lg font-semibold group-hover:text-[rgb(var(--purple))] transition-colors">
                  {tagData.name}
                </h3>
              </div>
              
              <p class="text-muted-foreground mb-4">
                {tagData.count} {tagData.count === 1 ? 'post' : 'posts'}
              </p>
              
              {tagData.posts.length > 0 && (
                <div class="border-t pt-4">
                  <h4 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-2">
                    Recent Posts
                  </h4>
                  <ul class="space-y-1 text-sm text-muted-foreground">
                    {tagData.posts.slice(0, 3).map((post: any) => (
                      <li class="truncate hover:text-[rgb(var(--accent))] transition-colors">
                        {post.data.title}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </a>
          ))}
        </div>
      </section>
    ) : (
      <div class="text-center py-16 text-muted-foreground">
        <h2 class="text-2xl font-semibold mb-2">No tags found</h2>
        <p>Check back later for tagged content.</p>
      </div>
    )}
  </div>
</BlogIndexLayout>
