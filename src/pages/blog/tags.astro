---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import MinimalBlogCardLong from '@/components/blog/MinimalBlogCardLong.astro';
import { getTagColorClass } from '@/lib/blog/tagColors';
import { getCategoryTheme } from '@/components/blog/shared/categoryColors';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import SuicideCta from '@/components/sections/SuicideCta.astro';
import FAQSection from '@/components/sections/faq/FAQSection.astro';
import NewsletterSection from '@/components/sections/newsletter/NewsletterSection.astro';
import ContactSection from '@/components/sections/contact/ContactSection.astro';
import Center from '@/components/layout/primitives/Center.astro';
import BlogHero from '@/components/sections/blog/BlogHero.astro';
import BlogSearch from '@/components/blog/Search/BlogSearch.astro';

export const prerender = true;

// Fetch all posts, sorted newest-first
const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Map each tag to its list of posts
const tagPostsMap = new Map<string, typeof allPosts>();
allPosts.forEach(post => {
  post.data.tags?.forEach(tag => {
    const normalized = tag.toLowerCase().trim();
    if (!tagPostsMap.has(normalized)) {
      tagPostsMap.set(normalized, []);
    }
    tagPostsMap.get(normalized)!.push(post);
  });
});

// Sort tags by post count descending (popular tags first), falling back to alphabetical
const sortedTags = [...tagPostsMap.keys()].sort((a, b) => {
  const countA = tagPostsMap.get(a)!.length;
  const countB = tagPostsMap.get(b)!.length;
  if (countB !== countA) {
    return countB - countA;
  }
  return a.localeCompare(b);
});

// Shape posts for BlogSearch
const allPostsData = allPosts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body,
}));
---

<BlogIndexLayout
  title={`Browse by Tag - ${SITE_TITLE}`}
  description={`Explore all blog tags on ${SITE_TITLE}. ${SITE_DESCRIPTION}`}
  showProgress={false}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog' },
    { label: 'Tags', href: '/blog/tags', current: true },
  ]}
>
  {/* ── Hero & Navigation ── */}
  <div slot="hero-search">
    <BlogHero
      heading="Browse by Tag"
      subheading={`${sortedTags.length} tags · ${allPosts.length} articles`}
      variant="card"
    >
      <BlogSearch
        posts={allPostsData}
        placeholder="Search articles by tag..."
        showFilters={false}
      />

      <div class="flex gap-3 justify-center flex-wrap mt-6">
        <a
          href="/blog"
          class="px-5 py-2.5 rounded-xl border border-border text-sm font-semibold hover:bg-muted transition-colors"
        >
          All Posts
        </a>
        <a
          href="/blog/categories"
          class="px-5 py-2.5 rounded-xl border border-border text-sm font-semibold hover:bg-muted transition-colors"
        >
          Browse by Category
        </a>
        <a
          href="/blog/tags"
          class="px-5 py-2.5 rounded-xl border-2 border-primary text-primary bg-primary/5 text-sm font-bold shadow-xs"
        >
          Browse by Tag
        </a>
      </div>
    </BlogHero>
  </div>

  {/* ── Tags Quick-Nav Array ── */}
  <section class="py-12 bg-muted/10 border-b border-border">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h2 class="text-xs font-black uppercase tracking-widest text-muted-foreground mb-6">
        Jump to a theme
      </h2>
      <div class="flex flex-wrap gap-2.5 justify-center">
        {sortedTags.map(tag => {
          const count = tagPostsMap.get(tag)!.length;
          return (
            <a
              href={`#tag-${tag}`}
              class={`px-3 py-1.5 rounded-full text-xs font-semibold border shadow-xs transition-all duration-200 hover:scale-105 active:scale-95 flex items-center gap-1.5 ${getTagColorClass(tag)}`}
            >
              #{tag}
              <span class="opacity-60 text-[10px] bg-black/5 dark:bg-white/10 px-1.5 py-0.5 rounded-full">
                {count}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ── Tag Lanes ── */}
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-16">
    {sortedTags.map(tag => {
      const posts = tagPostsMap.get(tag)!;
      return (
        <section id={`tag-${tag}`} class="scroll-mt-24 space-y-6">
          <div class="flex items-center gap-3 border-b border-border pb-3">
            <span class={`px-4 py-1.5 rounded-full text-sm font-semibold border ${getTagColorClass(tag)}`}>
              #{tag}
            </span>
            <span class="text-sm text-muted-foreground">
              {posts.length} {posts.length === 1 ? 'article' : 'articles'}
            </span>
          </div>

          <div class="flex flex-col gap-6">
            {posts.map(post => (
              <MinimalBlogCardLong
                variant="blog"
                size="long"
                title={post.data.title}
                description={post.data.description}
                image={post.data.image}
                imageAlt={post.data.title}
                tags={post.data.tags}
                category={post.data.categories?.[0]}
                categoryStyle={post.data.categories?.[0] ? getCategoryTheme(post.data.categories[0]).pillStyle : undefined}
                date={post.data.date}
                author={post.data.author || post.data.authors}
                href={`/blog/${post.id}`}
              />
            ))}
          </div>
        </section>
      );
    })}
  </div>

  {/* Suicide Line CTA──  */}
  <SuicideCta />

  {/* ── FAQ ── */}
  <section class="py-16 bg-muted/30">
    <FAQSection />
  </section>

  {/* ── Newsletter ── */}
  <Center axis="both" class="py-20">
    <NewsletterSection heading="Never miss an article" />
  </Center>

  {/* ── Contact ── */}
  <ContactSection />
</BlogIndexLayout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
