---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import { ThreeColumnGrid, BlogSearch } from '@/components/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import BlogHero from '@/components/layout/BlogHero.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  const categories = new Set<string>();
  posts.forEach(post => {
    post.data.categories?.forEach(category => categories.add(category));
  });

  return Array.from(categories).map(category => ({
    params: { category },
    props: {
      posts: posts.filter(post => post.data.categories?.includes(category)),
    },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;

const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);

const postsData = sortedPosts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body,
}));
---

<BlogIndexLayout
  title={`${category} - ${SITE_TITLE}`}
  description={`${SITE_DESCRIPTION} - Posts in ${category} category`}
  showProgress={true}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog' },
    { label: 'Categories', href: '/blog/categories' },
    { label: category, href: `/blog/category/${category}`, current: true },
  ]}
>
  <div slot="hero-search">
    <BlogHero
      heading={category}
      subheading={`${sortedPosts.length} ${sortedPosts.length === 1 ? 'post' : 'posts'} in this category`}
      variant="flush"
    >
      <div class="flex gap-3 justify-center flex-wrap">
        
          href="/blog"
          class="px-5 py-2 rounded-lg border border-border text-sm font-medium hover:bg-muted transition-colors"
        >
          ← All Posts
        </a>
        
          href="/blog/categories"
          class="px-5 py-2 rounded-lg border border-border text-sm font-medium hover:bg-muted transition-colors"
        >
          All Categories
        </a>
      </div>
    </BlogHero>
  </div>

  {postsData.length > 0 ? (
    <section class="space-y-6">
      <div class="max-w-2xl mx-auto">
        <BlogSearch
          posts={postsData}
          placeholder={`Search articles in ${category}...`}
          showFilters={false}
        />
      </div>
      <h2 class="text-2xl font-semibold text-[rgb(var(--purple))] text-center">
        {sortedPosts.length} {sortedPosts.length === 1 ? 'Article' : 'Articles'} Found
      </h2>
      <ThreeColumnGrid
        posts={postsData}
        cardVariant="default"
        showImage={true}
        showTags={true}
        showAuthor={true}
        showReadTime={true}
      />
    </section>
  ) : (
    <div class="text-center py-16 space-y-4">
      <h2 class="text-2xl font-semibold text-muted-foreground">
        No posts found in {category}
      </h2>
      <p class="text-muted-foreground">
        Check back later for new content in this category.
      </p>
      <a
        href="/blog/"
        class="inline-block px-6 py-3 bg-[rgb(var(--accent))] text-white rounded-lg font-medium hover:bg-[rgb(var(--accent-dark))] transition-colors"
      >
        Back to Blog
      </a>
    </div>
  )}
</BlogIndexLayout>