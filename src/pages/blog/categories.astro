---
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { getCollection } from 'astro:content';
import { getCategoryTheme } from '@/components/blog/shared/categoryColors';
import BlogSearch from '@/components/blog/Search/BlogSearch.astro';
import CategoryPostsSection from '@/components/blog/CategoryPosts/CategoryPostsSection.astro';
import Center from '@/components/layout/primitives/Center.astro';
import SuicideCta from '@/components/sections/SuicideCta.astro';
import BlogHero from '@/components/sections/blog/BlogHero.astro';
import ContactSection from '@/components/sections/contact/ContactSection.astro';
import FAQSection from '@/components/sections/faq/FAQSection.astro';
import NewsletterSection from '@/components/sections/newsletter/NewsletterSection.astro';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';

export const prerender = true;

// Fetch all posts, sorted newest-first
const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Derive unique categories + counts for the search bar
const categoryCounts = new Map<string, number>();
allPosts.forEach(post => {
  post.data.categories?.forEach(c => {
    categoryCounts.set(c, (categoryCounts.get(c) || 0) + 1);
  });
});
const categories = [...categoryCounts.keys()].sort((a, b) => {
  const countA = categoryCounts.get(a) || 0;
  const countB = categoryCounts.get(b) || 0;
  if (countB !== countA) {
    return countB - countA; // Descending by post count
  }
  return a.localeCompare(b); // Alphabetical fallback
});

// Shape posts for BlogSearch
const allPostsData = allPosts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body,
}));
---

<BlogIndexLayout
  title={`Browse Categories - ${SITE_TITLE}`}
  description={`Explore all article categories on ${SITE_TITLE}. ${SITE_DESCRIPTION}`}
  showProgress={false}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog' },
    { label: 'Categories', href: '/blog/categories', current: true },
  ]}
>
  {/* ── Hero ── */}
  <div slot="hero-search">
    <BlogHero
      heading="Browse by Category"
      subheading={`${categories.length} categories · ${allPosts.length} articles`}
      variant="card"
    >
    <BlogSearch
      posts={allPostsData}
      placeholder="Search all articles…"
      showFilters={true}
    />

      <div class="flex gap-3 justify-center flex-wrap mt-6">
        <a
          href="/blog"
          class="px-5 py-2.5 rounded-xl border border-border text-sm font-semibold hover:bg-muted transition-colors"
        >
          All Posts
        </a>
        <a
          href="/blog/categories"
          class="px-5 py-2.5 rounded-xl border-2 border-primary text-primary bg-primary/5 text-sm font-bold shadow-xs"
        >
          Browse by Category
        </a>
        <a
          href="/blog/tags"
          class="px-5 py-2.5 rounded-xl border border-border text-sm font-semibold hover:bg-muted transition-colors"
        >
          Browse by Tag
        </a>
      </div>
    </BlogHero>
  </div>

  {/* ── Category quick-nav pills ── */}
  <section class="py-10 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-6 text-center">
        Jump to a category
      </h2>
      <div class="flex flex-wrap gap-3 justify-center">
        {categories.map(cat => {
          const theme = getCategoryTheme(cat);
          return (
            <a
              href={`#cat-${cat.toLowerCase().replace(/\s+/g, '-')}`}
              class="px-5 py-2.5 rounded-xl text-sm font-semibold shadow-sm hover:scale-105 hover:shadow-md transition-all duration-200"
              style={theme.pillStyle}
            >
              {cat}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ── All-categories post grid ── */}
  <CategoryPostsSection posts={allPosts} />

  {/* Suicide Line CTA──  */}
  <SuicideCta />

  {/* ── FAQ ── */}
  <section class="py-16 bg-muted/30">
    <FAQSection />
  </section>

  {/* ── Newsletter ── */}
  <Center axis="both" class="py-20">
    <NewsletterSection heading="Never miss an article" />
  </Center>

  {/* ── Contact ── */}
  <ContactSection />
</BlogIndexLayout>
