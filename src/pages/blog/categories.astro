---
import { getCollection } from 'astro:content';
import BlogIndexLayout from '@/layouts/BlogIndexLayout.astro';
import { BlogSearch } from '@/components/blog';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import BlogHero from '@/components/layout/BlogHero.astro';
import CategoryPostsSection from '@/components/blog/CategoryPosts/CategoryPostsSection.astro';
import SuicideCta from '@/components/sections/SuicideCta.astro';
import FAQSection from '@/components/sections/faq-section/FAQSection.astro';
import NewsletterSection from '@/components/sections/misc-section/NewsletterSection.astro';
import { ContactSection } from '@/components/layout';
import Center from '@/components/layout/primitives/Center.astro';
import { getCategoryTheme } from '@/components/blog/shared/categoryColors';

export const prerender = true;

// Fetch all posts, sorted newest-first
const allPosts = (await getCollection('blog'))
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());

// Derive unique categories + counts for the search bar
const categorySet = new Set<string>();
allPosts.forEach(post => post.data.categories?.forEach(c => categorySet.add(c)));
const categories = [...categorySet].sort();

// Shape posts for BlogSearch
const allPostsData = allPosts.map(post => ({
  ...post.data,
  slug: post.id,
  content: post.body,
}));
---

<BlogIndexLayout
  title={`Browse Categories - ${SITE_TITLE}`}
  description={`Explore all article categories on ${SITE_TITLE}. ${SITE_DESCRIPTION}`}
  showProgress={false}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog' },
    { label: 'Categories', href: '/blog/categories', current: true },
  ]}
>
  {/* ── Hero ── */}
  <div slot="hero-search">
    <BlogHero
      heading="Browse by Category"
      subheading={`${categories.length} categories · ${allPosts.length} articles`}
      variant="card"
    >
    <BlogSearch
      posts={allPostsData}
      placeholder="Search all articles…"
      showFilters={true}
    />

    <div 
      class
      ="
        flex
        gap-3
        justify-center
        flex-wrap
        mt-4
      "
    >
      <a
        href="/blog"
        class
        ="
          px-5
          py-2
          rounded-lg
          border
          border-border
          text-sm
          font-medium
          hover:bg-muted
          transition-colors
        "
      >
        ← All Posts
      </a>
      <a
        href="/blog/tags"
        class
        ="
          px-5
          py-2
          rounded-lg
          border
          border-border
          text-sm
          font-medium
          hover:bg-muted
          transition-colors
        "
      >
        Browse by Tag
      </a>
    </div
    >
    </BlogHero>
  </div>

  {/* ── Category quick-nav pills ── */}
  <section class="py-10 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-muted-foreground mb-6 text-center">
        Jump to a category
      </h2>
      <div class="flex flex-wrap gap-3 justify-center">
        {categories.map(cat => {
          const theme = getCategoryTheme(cat);
          return (
            <a
              href={`#cat-${cat.toLowerCase().replace(/\s+/g, '-')}`}
              class="px-5 py-2.5 rounded-xl text-sm font-semibold shadow-sm hover:scale-105 hover:shadow-md transition-all duration-200"
              style={theme.pillStyle}
            >
              {cat}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ── All-categories post grid ── */}
  <CategoryPostsSection posts={allPosts} />

  {/* Suicice Line CTA──  */}
  <SuicideCta />

  {/* ── FAQ ── */}
  <section class="py-16 bg-muted/30">
    <FAQSection />
  </section>

  {/* ── Newsletter ── */}
  <Center axis="both" class="py-20">
    <NewsletterSection heading="Never miss an article" />
  </Center>

  {/* ── Contact ── */}
  <ContactSection />
</BlogIndexLayout>
