---
import Layout from '@/layouts/Site.astro';
import BlogSection from '@/components/sections/blog/BlogSection.astro';
import TestimonialsSection from '@/components/sections/testimonial/TestimonialsSection.astro';
import PricingSection from '@/components/sections/pricing/PricingSection.astro';
import NewsletterSection from '@/components/sections/newsletter/NewsletterSection.astro';
import FAQSection from '@/components/sections/faq/FAQSection.astro';
import ContactSection from '@/components/sections/contact/ContactSection.astro';
import FullCardCluster from '@/components/FullCardCluster.astro';
import HeroSection from '@/components/sections/hero/HeroSection.astro';
import FeaturesSection from '@/components/sections/feature/FeaturesSection.astro';
import Card from '@/components/Card.astro';
import Center from '@/components/layout/primitives/Center.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import { features as FeatureData, testimonials as TestimonialData, pricing as PricingData } from '@/data/consts';

const features = FeatureData;
const testimonials = TestimonialData;
const plans = PricingData;

export const prerender = false;

---
<Layout 
	title={SITE_TITLE} 
	description={SITE_DESCRIPTION}
>
	<HeroSection 
		h="The Life You Want to Live is Near"
		p="Small habits compound into lasting change. Track your progress, reflect in your journal, and find calm through meditation. Everything you need to care for yourself is here."
		imgSrc="https://res.cloudinary.com/dikyfam2c/image/upload/v1734536831/flower_gvof2g.webp"
		imgAlt="Hero image"
		width={2688}
		height={1920}
		slot="hero"
		style="background: linear-gradient(to bottom, var(--purple-5), var(--purple3)) no-repeat;"
	/>

	<hr style="box-shadow: 2em;"/>
	<FeaturesSection
		heading="Three ways to grow"
		subheading="Build better habits with our simple, powerful tools"
		features={features}
		variant="plea"
	/>
	<Center axis="both" class="h-[100vh]">
		<NewsletterSection heading="Never miss an update" class="h-em "/>
	</Center>
	<div>
		<FullCardCluster columns={3} schemeMode="alternate">
			<Card title="Something dark" tag="Essay" />
			<Card title="Something light" image="/hero.jpg" tag="Review" />
			<Card title="Another dark" href="/read/slug">
				A line or two of body copy dropped in via the default slot.
			</Card>
		</FullCardCluster>
	</div>

	<BlogSection />
	<TestimonialsSection
	  heading="Real stories"
	  subheading="People who have changed their lives with Mindful Habits Studio."
	  testimonials={testimonials}
	/>
	<FAQSection />
	<PricingSection
	  heading="Simple pricing"
	  subheading="Choose the plan that fits your journey"
	  plans={plans}
	/>
	<ContactSection />
	<div>
	<NewsletterSection heading="Stay in the loop" class="h-em "/>
	</div>

</Layout>
