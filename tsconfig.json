{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "uploads",
    ".netlify"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "!svg/*": [
        "./src/assets/svg/*"
      ],
      "!design/*": [
        "./src/styles/design/*"
      ],
      "@tiptap/core": [
        "node_modules/@tiptap/core/src/index"
      ],
      "@tiptap/extensions": [
        "node_modules/@tiptap/extensions/src/index"
      ],
      "@tiptap/extension-text-style": [
        "node_modules/@tiptap/extension-text-style/src/index"
      ]
    },
    "ignoreDeprecations": "5.0"
  }
}